"""Shared helpers for verself AXL tasks.

This file is the single triage point when upstream Aspect breaks the AXL DSL.
Anything that touches the Aspect-side API (spawning processes, reading env,
locating workspace files, calling ctx.bazel.*) belongs here, so the next
breaking rename is a one-file fix instead of a 12-file fix.

Conventions:
  - All subprocesses go through `checked_spawn(ctx, cmd, args, ...)`. That keeps
    a single hook for a future task-invocation telemetry table (see TODO inside
    `checked_spawn`).
  - Workspace paths use `ws_path(ctx, *parts)` so callers do not concatenate
    strings by hand. The repo root is `ctx.std.env.root_dir()`.
  - Tasks read authored source files in place. Derived artifacts must be Bazel
    outputs. Do not introduce intermediate staging or render cache directories.
  - Failures are loud: helpers fail fast with a useful stderr line and a
    non-zero exit code. They never silently coerce errors to no-ops.
"""

HOST_CONFIGURATION_DIR = "src/host"
DEFAULT_SITE = "prod"
GO_DIRS = [
    "src/services/analytics-service",
    "src/services/billing-service",
    "src/tools/actions",
    "src/tools/deployment",
    "src/tools/dev",
    "src/tools/operator",
    "src/verself-cli",
    "src/services/governance-service",
    "src/services/iam-service",
    "src/services/email-service",
    "src/services/notifications-service",
    "src/services/object-storage-service",
    "src/tools/observability/go",
    "src/tools/operator-runtime/go",
    "src/services/profile-service",
    "src/services/projects-service",
    "src/services/github-integration-service",
    "src/services/sandbox-rental-service",
    "src/services/secrets-service",
    "src/services/service-runtime/go",
    "src/services/source-code-hosting-service",
    "src/sdks/go/verself",
    "src/infrastructure-components/temporal-platform",
    "src/substrate/vm-orchestrator",
]

VERSELF_DEPLOY_TARGET = "//src/tools/deployment/cmd/verself-deploy:verself-deploy"
DEPLOY_CONTRACT_VALIDATE_TARGET = "//src/tools/deployment/cmd/deploy-contract-validate:deploy-contract-validate"
ASPECT_OPERATOR_TARGET = "//src/tools/operator/cmd/aspect-operator:aspect-operator"
ACTIONS_PUBLISHER_TARGET = "//src/tools/actions/cmd/actions-publisher:actions-publisher"
ANSIBLE_PLAYBOOK_TARGET = "//src/host:ansible_playbook_bin"
ANSIBLE_COLLECTIONS_ARCHIVE_TARGET = "//src/host:ansible_collections_archive"
DEFAULT_PROCESS_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
STRIPE_CLI_SHIM = ("stripe", "//src/tools/dev/binaries:stripe")

# Aspect-owned Vite+ toolchain, shared by the frontend build and controller
# checks. This bypasses any shell `vp` so Bazel/Aspect actions use the
# lockfile-pinned package under the Bazel-resolved host Node.
VITEPLUS_NODE_TARGET = "//src/viteplus-monorepo:vp_node"
VITEPLUS_WORKSPACE_INSTALL_TARGET = "//src/viteplus-monorepo:workspace_install"
VITEPLUS_VP_SCRIPT = "src/viteplus-monorepo/node_modules/vite-plus/bin/vp"
VITEPLUS_WORKSPACE = "src/viteplus-monorepo"

def ws_path(ctx, *parts):
    """Resolve a workspace-relative path to absolute under the repo root."""
    root = ctx.std.env.root_dir()
    out = root
    for p in parts:
        out = out + "/" + p
    return out

def site_inventory_source(site):
    """Repo-relative path to the per-site authored inventory file."""
    return HOST_CONFIGURATION_DIR + "/sites/" + site + "/inventory.ini"

def inventory_check(ctx, site = DEFAULT_SITE):
    """Fail loud when the per-site Ansible inventory is missing."""
    inv = ws_path(ctx, site_inventory_source(site))
    r = (ctx.std.process.command("test")
        .args(["-f", inv])
        .spawn().wait())
    if r.code != 0:
        ctx.std.io.stderr.write(
            "ERROR: " + site_inventory_source(site) + " not found. Bootstrap site inventory before running this task.\n",
        )
        return 1
    return 0

def _safe_artifact_name(raw):
    out = raw
    for old in ["/", "\\", ":", " ", "\t", "\n", "(", ")", "[", "]", "{", "}", "@", "+", "=", ",", ";", "'", "\""]:
        out = out.replace(old, "_")
    return out.strip("_")

def _timestamp_ns(ctx):
    r = (ctx.std.process.command("date")
        .args(["+%Y%m%dT%H%M%S%N"])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: date failed while preparing Bazel BEP output\n")
        if r.stderr != "":
            ctx.std.io.stderr.write(r.stderr)
        return ""
    return r.stdout.strip()

def _bazel_args_with_bep(ctx, args, label):
    """Attach a per-invocation JSON BEP file when explicitly requested."""
    bep_dir = _read_env_value(ctx, "VERSELF_ASPECT_BEP_DIR")
    if bep_dir == "":
        return args
    if len(args) == 0:
        return args
    if args[0] == "info":
        return args

    out_dir = bep_dir if bep_dir.startswith("/") else ws_path(ctx, bep_dir)
    r = (ctx.std.process.command("mkdir")
        .args(["-p", out_dir])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: cannot create VERSELF_ASPECT_BEP_DIR " + out_dir + "\n")
        if r.stderr != "":
            ctx.std.io.stderr.write(r.stderr)
        return None

    ts = _timestamp_ns(ctx)
    if ts == "":
        return None

    name = _safe_artifact_name(label if label != None else "bazelisk_" + "_".join(args))
    if name == "":
        name = "bazelisk"
    path = out_dir + "/" + ts + "__" + name + ".bep.json"
    ctx.std.io.stderr.write("BEP: " + path + "\n")
    return [args[0], "--build_event_json_file=" + path] + args[1:]

def checked_spawn(ctx, program, args, cwd = None, env = None, label = None):
    """Spawn a subprocess attached to the parent's stdio and return its exit code.

    Stdio is inherited so long-running interactive scripts (psql, pnpm dev,
    browser canaries) behave the same way they did under Make. The returned
    int matches the program's exit code; non-zero is the caller's signal to
    propagate.
    """

    # TODO(aspect-followups): emit a row to default.aspect_task_invocations on
    # exit so we can answer "how often is each task actually invoked" without
    # taking on the full OTel task-tracing surface.
    label_str = label if label != None else program
    spawn_args = args
    if program == "bazelisk":
        spawn_args = _bazel_args_with_bep(ctx, args, label_str)
        if spawn_args == None:
            return 1
    cmd = ctx.std.process.command(program).args(spawn_args)
    if cwd != None:
        cmd = cmd.current_dir(cwd)
    if env != None:
        for k, v in env.items():
            cmd = cmd.env(k, v)
    if ctx.std.io.stderr.is_tty:
        ctx.std.io.stderr.write("$ " + label_str + "\n")
    r = cmd.spawn().wait()
    return r.code

def bazel_run(ctx, target, args = None, cwd = None, env = None, label = None, bazel_args = None):
    """Run a Bazel executable target and pass argv after `--`."""
    target_args = list(args) if args != None else []
    run_args = ["run"] + (list(bazel_args) if bazel_args != None else []) + [target, "--"] + target_args
    return checked_spawn(
        ctx,
        "bazelisk",
        run_args,
        cwd = cwd if cwd != None else ws_path(ctx),
        env = env,
        label = label if label != None else "bazelisk run " + target,
    )

def _capture_stdout(ctx, program, args, cwd = None, env = None, label = None):
    label_str = label if label != None else program
    spawn_args = args
    if program == "bazelisk":
        spawn_args = _bazel_args_with_bep(ctx, args, label_str)
        if spawn_args == None:
            return None
    cmd = ctx.std.process.command(program).args(spawn_args)
    if cwd != None:
        cmd = cmd.current_dir(cwd)
    if env != None:
        for k, v in env.items():
            cmd = cmd.env(k, v)
    if ctx.std.io.stderr.is_tty:
        ctx.std.io.stderr.write("$ " + label_str + "\n")
    r = cmd.stdout("piped").stderr("piped").spawn().wait_with_output()
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: " + label_str + " failed\n")
        if r.stderr != "":
            ctx.std.io.stderr.write(r.stderr)
        return None
    return r.stdout.strip()

def _path_exists(ctx, path):
    r = (ctx.std.process.command("test")
        .args(["-e", path])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    return r.status.code == 0

def bazel_output_file(ctx, target):
    """Build a single-output Bazel target and return its execroot-absolute path."""
    rc = checked_spawn(
        ctx,
        "bazelisk",
        ["build", target],
        cwd = ws_path(ctx),
        label = "bazelisk build " + target,
    )
    if rc != 0:
        return ""
    raw_files = _capture_stdout(
        ctx,
        "bazelisk",
        ["cquery", "--output=files", target],
        cwd = ws_path(ctx),
        label = "bazelisk cquery --output=files " + target,
    )
    if raw_files == None:
        return ""
    files = []
    for line in raw_files.split("\n"):
        clean = line.strip()
        if clean != "":
            files.append(clean)
    if len(files) != 1:
        ctx.std.io.stderr.write("ERROR: expected one output for " + target + ", got " + str(len(files)) + "\n")
        return ""
    execroot = _capture_stdout(
        ctx,
        "bazelisk",
        ["info", "execution_root"],
        cwd = ws_path(ctx),
        label = "bazelisk info execution_root",
    )
    if execroot == None:
        return ""
    execroot_path = execroot + "/" + files[0]
    if not files[0].startswith("external/"):
        return execroot_path

    # External source targets are not kept materialized under execroot.
    output_base = _capture_stdout(
        ctx,
        "bazelisk",
        ["info", "output_base"],
        cwd = ws_path(ctx),
        label = "bazelisk info output_base",
    )
    if output_base == None:
        return ""
    output_base_path = output_base + "/" + files[0]
    if _path_exists(ctx, output_base_path):
        return output_base_path
    return execroot_path

def _absolute_or_workspace_path(ctx, path):
    if path.startswith("/"):
        return path
    return ws_path(ctx, path)

def install_bazel_tool_shims(ctx, shims, bin_dir):
    """Install repo-local symlinks for Bazel-resolved executable targets."""
    out_dir = _absolute_or_workspace_path(ctx, bin_dir)
    rc = checked_spawn(ctx, "mkdir", ["-p", out_dir], label = "mkdir -p " + out_dir)
    if rc != 0:
        return ""
    for name, target in shims:
        tool = bazel_output_file(ctx, target)
        if tool == "":
            return ""
        rc = checked_spawn(ctx, "ln", ["-sf", tool, out_dir + "/" + name], label = "ln -sf " + name)
        if rc != 0:
            return ""
    return out_dir

def viteplus_node(ctx, ensure_toolchain = True):
    """Build the Bazel-resolved host Node and materialize node_modules.

    Returns the execroot-absolute path to the pinned `node` binary, or "" on
    failure. Building `:workspace_install` runs the same frozen-lockfile
    `vp install` the frontend build does, so the source `node_modules` (and the
    `vite-plus` launcher under it) is the lockfile-pinned tree.
    """
    if ensure_toolchain:
        rc = checked_spawn(
            ctx,
            "bazelisk",
            ["build", VITEPLUS_NODE_TARGET, VITEPLUS_WORKSPACE_INSTALL_TARGET],
            cwd = ws_path(ctx),
            label = "bazelisk build Vite+ toolchain",
        )
        if rc != 0:
            return ""
    node = ws_path(ctx, "bazel-bin", "src/viteplus-monorepo", "node")
    if not _path_exists(ctx, node):
        ctx.std.io.stderr.write("ERROR: expected Bazel-built Node at " + node + "\n")
        return ""
    return node

def viteplus_vp(ctx, args, env = None, label = None, ensure_toolchain = True):
    """Run the lockfile-pinned Vite+ under the vendored Node, in src/viteplus-monorepo.

    The single entry point for `vp` from the controller. `args` is the `vp`
    argv (e.g. ["fmt", ".", "--write"]). Returns the process exit code.
    """
    node = viteplus_node(ctx, ensure_toolchain = ensure_toolchain)
    if node == "":
        return 1
    node_dir = ws_path(ctx, "bazel-bin", "src/viteplus-monorepo")
    vp = ws_path(ctx, VITEPLUS_VP_SCRIPT)
    arglist = list(args)
    vp_env = {}
    if env != None:
        for k, v in env.items():
            vp_env[k] = v

    # Vite+ package-manager shims re-exec `node` through PATH.
    vp_env["PATH"] = node_dir + ":" + DEFAULT_PROCESS_PATH
    return checked_spawn(
        ctx,
        node,
        [vp] + arglist,
        cwd = ws_path(ctx, VITEPLUS_WORKSPACE),
        env = vp_env,
        label = label if label != None else "vp " + " ".join(arglist),
    )

def path_env_with_bazel_tool_shims(ctx, shims, bin_dir = ".verself/tools/aspect/bin", extra_env = None):
    env = {}
    if extra_env != None:
        for k, v in extra_env.items():
            env[k] = v
    if len(shims) > 0:
        tool_dir = install_bazel_tool_shims(ctx, shims, bin_dir)
        if tool_dir == "":
            return None
        env["PATH"] = tool_dir + ":" + DEFAULT_PROCESS_PATH
        for name, _target in shims:
            if name == "ansible-playbook":
                env["VERSELF_ANSIBLE_PLAYBOOK_BIN"] = tool_dir + "/ansible-playbook"
            if name == "tofu":
                env["TOFU_BIN"] = tool_dir + "/tofu"
    return env

def _read_env_value(ctx, name):
    value = (ctx.std.process.command("printenv")
        .args([name])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if value.status.code != 0:
        return ""
    return value.stdout.strip()

def _host_stripe_config_file(ctx):
    xdg = _read_env_value(ctx, "XDG_CONFIG_HOME")
    if xdg != "":
        candidate = xdg + "/stripe/config.toml"
    else:
        home = _read_env_value(ctx, "HOME")
        if home == "":
            return ""
        candidate = home + "/.config/stripe/config.toml"
    exists = (ctx.std.process.command("test")
        .args(["-f", candidate])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if exists.status.code != 0:
        return ""
    return candidate

def stripe_cli_plugin_context(ctx, plugin_set, bin_dir = ".verself/tools/stripe/bin", state_dir = ".verself/tools/stripe"):
    """Prepare a repo-local Stripe CLI plugin environment.

    `plugin_set` contains manifest, config, and plugins fields. The returned
    dict contains env and args_prefix fields for invoking the Bazel-resolved
    `stripe` binary.
    """
    plugins = plugin_set["plugins"]
    shims = [STRIPE_CLI_SHIM]
    for plugin in plugins:
        shims.append((plugin["binary"], plugin["target"]))

    tool_dir = install_bazel_tool_shims(ctx, shims, bin_dir)
    if tool_dir == "":
        return None

    plugin_root = ws_path(ctx, state_dir, "plugins")
    xdg_config_home = ws_path(ctx, state_dir, "xdg-config")
    stripe_config_dir = xdg_config_home + "/stripe"
    if checked_spawn(ctx, "mkdir", ["-p", plugin_root, stripe_config_dir], label = "mkdir -p Stripe plugin state") != 0:
        return None

    local_config = stripe_config_dir + "/config.toml"
    local_manifest = stripe_config_dir + "/plugins.toml"
    for target_file in [local_config, local_manifest]:
        symlink = (ctx.std.process.command("test")
            .args(["-L", target_file])
            .stdout("piped").stderr("piped")
            .spawn().wait_with_output())
        if symlink.status.code == 0:
            ctx.std.io.stderr.write("ERROR: refusing to write Stripe plugin state through symlink: " + target_file + "\n")
            return None
    if checked_spawn(ctx, "cp", [ws_path(ctx, plugin_set["config"]), local_config], label = "cp Stripe plugin config") != 0:
        return None
    if checked_spawn(ctx, "chmod", ["0600", local_config], label = "chmod Stripe plugin config") != 0:
        return None
    if checked_spawn(ctx, "cp", [ws_path(ctx, plugin_set["manifest"]), local_manifest], label = "cp Stripe plugin manifest") != 0:
        return None

    for plugin in plugins:
        plugin_dir = plugin_root + "/" + plugin["shortname"] + "/" + plugin["version"]
        if checked_spawn(ctx, "mkdir", ["-p", plugin_dir], label = "mkdir -p Stripe plugin " + plugin["shortname"]) != 0:
            return None
        if checked_spawn(ctx, "ln", ["-sf", tool_dir + "/" + plugin["binary"], plugin_dir + "/" + plugin["binary"]], label = "ln -sf Stripe plugin " + plugin["shortname"]) != 0:
            return None

    env = {
        "PATH": tool_dir + ":" + DEFAULT_PROCESS_PATH,
        "STRIPE_PLUGINS_PATH": plugin_root,
        "XDG_CONFIG_HOME": xdg_config_home,
    }
    args_prefix = []
    host_config = _host_stripe_config_file(ctx)
    if host_config != "":
        args_prefix = ["--config", host_config]
    return {
        "env": env,
        "args_prefix": args_prefix,
    }

def ansible_collections_path(ctx):
    archive = bazel_output_file(ctx, ANSIBLE_COLLECTIONS_ARCHIVE_TARGET)
    if archive == "":
        return ""
    hash_line = _capture_stdout(ctx, "sha256sum", [archive], label = "sha256sum ansible_collections.tar")
    if hash_line == None:
        return ""
    archive_hash = hash_line.split(" ")[0]
    out_dir = ws_path(ctx, ".verself", "tools", "host", "ansible-collections", archive_hash)
    r = (ctx.std.process.command("test")
        .args(["-d", out_dir + "/ansible_collections"])
        .spawn().wait())
    if r.code == 0:
        return out_dir
    rc = checked_spawn(ctx, "mkdir", ["-p", out_dir], label = "mkdir -p " + out_dir)
    if rc != 0:
        return ""
    rc = checked_spawn(ctx, "tar", ["-xf", archive, "-C", out_dir], label = "tar -xf ansible_collections.tar")
    if rc != 0:
        return ""
    return out_dir

def host_ansible_playbook(ctx):
    return bazel_output_file(ctx, ANSIBLE_PLAYBOOK_TARGET)

def host_ansible_env(ctx, tool_shims = None, include_collections = True, extra_env = None):
    shims = tool_shims if tool_shims != None else []
    env = path_env_with_bazel_tool_shims(ctx, shims, extra_env = extra_env)
    if env == None:
        return None
    # Explicit task envs must carry ssh-agent auth through to OpenSSH.
    ssh_auth_sock = _read_env_value(ctx, "SSH_AUTH_SOCK")
    if ssh_auth_sock != "":
        env["SSH_AUTH_SOCK"] = ssh_auth_sock
    if include_collections:
        collections = ansible_collections_path(ctx)
        if collections == "":
            return None
        env["ANSIBLE_COLLECTIONS_PATH"] = collections
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return env

def require_arg(ctx, name, value):
    """Reject empty required string args with the same message shape Make used."""
    if not value or value == "":
        ctx.std.io.stderr.write("ERROR: --" + name + " is required\n")
        return False
    return True

def require_one_of(ctx, names, values):
    """At least one of the named args must be non-empty."""
    for v in values:
        if v and v != "":
            return True
    ctx.std.io.stderr.write("ERROR: one of " + ", ".join(["--" + n for n in names]) + " is required\n")
    return False

def git_head(ctx):
    """Return the 40-char SHA at HEAD, or empty string on failure."""
    r = (ctx.std.process.command("git")
        .args(["rev-parse", "HEAD"])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        return ""
    return r.stdout.strip()

def git_dirty(ctx):
    """Return True when the workspace has uncommitted tracked or untracked changes."""
    r = (ctx.std.process.command("git")
        .args(["status", "--porcelain"])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        return True
    return r.stdout.strip() != ""

def resolve_sha(ctx, raw):
    """Resolve a short SHA, full SHA, or symbolic ref (e.g. prod-tip) to a
    40-char hex SHA. Empty input resolves to HEAD.
    """
    target = raw if raw and raw != "" else "HEAD"
    r = (ctx.std.process.command("git")
        .args(["rev-parse", "--verify", target + "^{commit}"])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: cannot resolve git ref " + target + "\n")
        return ""
    return r.stdout.strip()

_BAZEL_FILE_BASENAMES = ["BUILD", "BUILD.bazel", "WORKSPACE", "WORKSPACE.bazel", "MODULE.bazel"]

def bazel_tracked_files(ctx):
    """Return the list of git-tracked Bazel/Starlark source files (BUILD, MODULE.bazel, *.bzl).

    Buildifier-style tools want exactly the authored Bazel surface; this excludes
    generated trees (bazel-out, node_modules) by inheriting `git ls-files` semantics.
    Returns None on git failure so callers can short-circuit.
    """
    r = (ctx.std.process.command("git")
        .args(["ls-files", "-z"])
        .current_dir(ws_path(ctx))
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: git ls-files failed\n")
        return None
    deleted = git_deleted_files(ctx)
    if deleted == None:
        return None
    files = []
    for path in r.stdout.split("\x00"):
        if path == "":
            continue
        if path in deleted:
            continue
        basename = path.rsplit("/", 1)[-1]
        if basename in _BAZEL_FILE_BASENAMES or basename.endswith(".bzl"):
            files.append(path)
    return files

def git_deleted_files(ctx, pathspec = None):
    """Return a dict-like set of deleted tracked files."""
    args = ["ls-files", "-z", "--deleted"]
    if pathspec != None:
        args.append(pathspec)
    r = (ctx.std.process.command("git")
        .args(args)
        .current_dir(ws_path(ctx))
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: git ls-files --deleted failed\n")
        return None
    deleted = {}
    for path in r.stdout.split("\x00"):
        if path != "":
            deleted[path] = True
    return deleted

def java_tracked_files(ctx):
    """Return authored Java files under repo-owned Java source roots."""
    r = (ctx.std.process.command("git")
        .args(["ls-files", "-z", "--cached", "--others", "--exclude-standard", "src/smithy/**/*.java"])
        .current_dir(ws_path(ctx))
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: git ls-files for Java sources failed\n")
        return None
    deleted = git_deleted_files(ctx, "src/smithy/**/*.java")
    if deleted == None:
        return None
    files = []
    for path in r.stdout.split("\x00"):
        if path != "" and not path in deleted:
            files.append(ws_path(ctx, path))
    return files

def tool_version(ctx, program, *args):
    """Run `<program> <args...>` and return the first stdout line, or None."""
    r = (ctx.std.process.command(program)
        .args(list(args))
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        return None
    out = r.stdout.strip()
    if "\n" in out:
        out = out.split("\n")[0]
    return out
