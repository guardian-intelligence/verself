"""aspect check --kind=frontend|go-test|go-vet|go-lint|java|contracts|conversions|ansible|topology|buildifier|all

Cross-cutting verification gates used during PR review. `--kind=all` runs in
fast-failure order: buildifier → frontend → topology → java → contracts → ansible → conversions → vet → lint → test.
"""

load(".aspect/lib/helpers.axl", "GO_DIRS", "HOST_CONFIGURATION_DIR", "bazel_tracked_files", "checked_spawn", "java_tracked_files", "ws_path")

def _go_each(ctx, args, label_prefix):
    for d in GO_DIRS:
        rc = checked_spawn(
            ctx,
            "go",
            args,
            cwd = ws_path(ctx, d),
            label = label_prefix + " (" + d + ")",
        )
        if rc != 0:
            return rc
    return 0

def _go_test(ctx):
    return _go_each(ctx, ["test", "-race", "./..."], "go test -race")

def _go_vet(ctx):
    return _go_each(ctx, ["vet", "./..."], "go vet")

def _go_lint(ctx):
    for d in GO_DIRS:
        rc = checked_spawn(
            ctx,
            "golangci-lint",
            ["run", "./..."],
            cwd = ws_path(ctx, d),
            label = "golangci-lint (" + d + ")",
        )
        if rc != 0:
            return rc
    return 0

def _conversions(ctx):
    for d in GO_DIRS:
        rc = checked_spawn(
            ctx,
            "gosec",
            ["-quiet", "-include=G115", "./..."],
            cwd = ws_path(ctx, d),
            label = "gosec G115 (" + d + ")",
        )
        if rc != 0:
            return rc
    return 0

def _ansible_lint(ctx):
    return checked_spawn(
        ctx,
        "uvx",
        [
            "--from",
            "ansible-lint==26.4.0",
            "--with",
            "ansible-core==2.20.3",
            "ansible-lint",
            "playbooks",
            "roles",
        ],
        cwd = ws_path(ctx, HOST_CONFIGURATION_DIR, "ansible"),
        label = "ansible-lint",
    )

def _buildifier(ctx):
    files = bazel_tracked_files(ctx)
    if files == None:
        return 1
    return checked_spawn(
        ctx,
        "buildifier",
        ["-mode=check", "-lint=warn"] + files,
        cwd = ws_path(ctx),
        label = "buildifier -mode=check -lint=warn",
    )

def _frontend(ctx):
    return checked_spawn(
        ctx,
        "bazelisk",
        [
            "build",
            "//src/websites:workspace_check",
        ],
        cwd = ws_path(ctx),
        label = "bazelisk build frontend Vite+ check",
    )

def _java(ctx):
    files = java_tracked_files(ctx)
    if files == None:
        return 1
    if len(files) > 0:
        rc = checked_spawn(
            ctx,
            "bazelisk",
            ["run", "--java_runtime_version=remotejdk_25", "//src/smithy/tools:google_java_format", "--", "--dry-run", "--set-exit-if-changed"] + files,
            cwd = ws_path(ctx),
            label = "google-java-format --dry-run",
        )
        if rc != 0:
            return rc
    return checked_spawn(
        ctx,
        "bazelisk",
        [
            "build",
            "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
            "//src/smithy/models/verself:smithy_validate",
            "//src/smithy/models/verself:iam_public_ir",
        ],
        cwd = ws_path(ctx),
        label = "bazelisk build Smithy Java lane",
    )

def _contracts(ctx):
    rc = checked_spawn(
        ctx,
        "bazelisk",
        [
            "build",
            "//src/smithy/models/verself:iam_public_ir",
            "//src/smithy/models/verself:iam_audit_catalog",
            "//src/smithy/models/verself:iam_observability_catalog",
            "//src/smithy/models/verself:iam_proto_projection",
            "//src/sdks/go/verself/internal/generated/iam:iam",
            "//src/websites/packages/sdk:iam_transport_generated_sources",
            "//src/websites/apps/verself-web:node_app_nomad_artifact",
        ],
        cwd = ws_path(ctx),
        label = "bazelisk build IAM contract vertical",
    )
    if rc != 0:
        return rc
    return checked_spawn(
        ctx,
        "bazelisk",
        [
            "test",
            "//src/sdks/go/verself:verself_test",
        ],
        cwd = ws_path(ctx),
        label = "bazelisk test SDK facade",
    )

def _legacy_topology_api(ctx):
    return checked_spawn(
        ctx,
        "bash",
        [
            "-lc",
            "if rg -n 'topology_(endpoints|routes|clusters|wireguard|artifacts)\\b' src .aspect AGENTS.md; then echo 'ERROR: legacy deployment topology variables remain' >&2; exit 1; fi",
        ],
        cwd = ws_path(ctx),
        label = "legacy deployment topology variable check",
    )

_CHECKERS = {
    "go-test": _go_test,
    "go-vet": _go_vet,
    "go-lint": _go_lint,
    "java": _java,
    "contracts": _contracts,
    "conversions": _conversions,
    "ansible": _ansible_lint,
    "topology": _legacy_topology_api,
    "buildifier": _buildifier,
    "frontend": _frontend,
}

# Ordered for the --kind=all path so a fast failure surfaces early.
_ALL_ORDER = ["buildifier", "frontend", "topology", "java", "contracts", "ansible", "conversions", "go-vet", "go-lint", "go-test"]

def _impl(ctx):
    kind = ctx.args.kind
    if kind == "all":
        for k in _ALL_ORDER:
            rc = _CHECKERS[k](ctx)
            if rc != 0:
                return rc
        return 0
    if kind not in _CHECKERS:
        ctx.std.io.stderr.write("ERROR: unknown --kind=" + kind + "\n")
        return 1
    return _CHECKERS[kind](ctx)

check = task(
    implementation = _impl,
    name = "check",
    summary = "Run a verification gate (--kind=frontend|go-test|go-vet|go-lint|java|contracts|conversions|ansible|topology|buildifier|all).",
    args = {
        "kind": args.string(
            default = "all",
            description = "Which check to run.",
        ),
    },
)
