"""aspect check — run repo verification through Bazel's test graph.

The task names the whole repo and lets Bazel decide which test actions are stale.
Language-specific lint, validation, and generated-output checks are modeled as
Bazel test targets so warm CI runners reuse the local action/test cache.
"""

load(".aspect/lib/helpers.axl", "bazel_tracked_files", "checked_spawn", "ws_path")

def _bazel(ctx, args, label):
    return checked_spawn(
        ctx,
        "bazelisk",
        args,
        cwd = ws_path(ctx),
        label = label,
    )

def _buildifier(ctx):
    files = bazel_tracked_files(ctx)
    if files == None:
        return 1
    return checked_spawn(
        ctx,
        "buildifier",
        ["-mode=check", "-lint=warn"] + files,
        cwd = ws_path(ctx),
        label = "buildifier -mode=check -lint=warn",
    )

def _bzlmod(ctx):
    return _bazel(ctx, ["mod", "tidy", "--lockfile_mode=error"], "bazelisk mod tidy --lockfile_mode=error")

def _bazel_test(ctx):
    return _bazel(
        ctx,
        [
            "test",
            "--config=ci",
            "//...",
        ],
        "bazelisk test --config=ci //...",
    )

def _impl(ctx):
    for step in [_buildifier, _bzlmod, _bazel_test]:
        rc = step(ctx)
        if rc != 0:
            return rc
    return 0

check = task(
    implementation = _impl,
    name = "check",
    summary = "Run Buildifier/Bzlmod preflights, then `bazelisk test --config=ci //...`.",
)
