"""aspect integrations cloudflare-dns|stripe-projects - external integration state."""

load(
    ".aspect/lib/helpers.axl",
    "DEFAULT_SITE",
    "HOST_CONFIGURATION_DIR",
    "bazel_run",
    "checked_spawn",
    "stripe_cli_plugin_context",
    "ws_path",
)

_CLOUDFLARE_DNS_TARGET = "//src/integrations/cloudflare/dns-reconciler/cmd/reconcile-cloudflare-dns:reconcile-cloudflare-dns"
_CLOUDFLARE_R2_CONTROL_PLANE_TARGET = "//src/integrations/cloudflare/r2-control-plane/cmd/cloudflare-r2-control-plane:cloudflare-r2-control-plane"
_STRIPE_CLI_VERSION = "1.42.1"
_STRIPE_PROJECTS_PLUGIN_VERSION = "0.16.0"
_STRIPE_PROJECTS_PLUGIN = {
    "config": "src/tools/dev/binaries/stripe-projects-config.toml",
    "manifest": "src/tools/dev/binaries/stripe-projects-plugin.toml",
    "plugins": [
        {
            "shortname": "projects",
            "version": _STRIPE_PROJECTS_PLUGIN_VERSION,
            "binary": "stripe-cli-projects",
            "target": "//src/tools/dev/binaries:stripe-cli-projects",
        },
    ],
}

def _cloudflare_dns_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    secret_vars_file = ctx.args.secret_vars_file
    token_file = ctx.args.cloudflare_token_file
    args_list = [
        "--site=" + site,
        "--ansible-dir=" + ws_path(ctx, HOST_CONFIGURATION_DIR, "ansible"),
    ]
    if secret_vars_file == "" and token_file == "" and site != "prod":
        secret_vars_file = ".verself/site-bootstrap/" + site + "/ansible-secrets.json"
    if secret_vars_file != "":
        args_list.append("--vars-file=" + (secret_vars_file if secret_vars_file.startswith("/") else ws_path(ctx, secret_vars_file)))
    elif token_file != "":
        args_list.append("--cloudflare-token-file=" + (token_file if token_file.startswith("/") else ws_path(ctx, token_file)))
    elif site == "prod":
        args_list.append("--secrets=" + ws_path(ctx, HOST_CONFIGURATION_DIR, "sites/" + site + "/secrets/host.sops.yml"))
    else:
        ctx.std.io.stderr.write("ERROR: non-prod Cloudflare DNS requires --secret-vars-file or --cloudflare-token-file.\n")
        return 1
    if ctx.args.dry_run:
        args_list.append("--dry-run")
    return bazel_run(
        ctx,
        _CLOUDFLARE_DNS_TARGET,
        args_list,
        bazel_args = ["--noshow_progress", "--ui_event_filters=-info"],
        label = "reconcile-cloudflare-dns --site " + site,
    )

cloudflare_dns = task(
    implementation = _cloudflare_dns_impl,
    name = "cloudflare-dns",
    group = ["integrations"],
    summary = "Reconcile Cloudflare DNS records from site integration inputs.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "dry_run": args.boolean(default = False, description = "Print the DNS diff without applying it."),
        "secret_vars_file": args.string(default = "", description = "Generated Ansible vars file containing cloudflare_api_token."),
        "cloudflare_token_file": args.string(default = "", description = "File containing only cloudflare_api_token."),
    },
)

def _cloudflare_r2_control_plane_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    args_list = [
        "--site=" + site,
        "--repo-root=" + ws_path(ctx),
        "--action=" + ctx.args.action,
        "--credential-source=" + ctx.args.credential_source,
    ]
    if ctx.args.account_id != "":
        args_list.append("--account-id=" + ctx.args.account_id)
    if ctx.args.bucket != "":
        args_list.append("--bucket=" + ctx.args.bucket)
    if ctx.args.credentials_file != "":
        args_list.append("--credentials-file=" + (ctx.args.credentials_file if ctx.args.credentials_file.startswith("/") else ws_path(ctx, ctx.args.credentials_file)))
    if ctx.args.openbao_addr != "":
        args_list.append("--openbao-addr=" + ctx.args.openbao_addr)
    if ctx.args.openbao_path != "":
        args_list.append("--openbao-path=" + ctx.args.openbao_path)
    if ctx.args.openbao_ca_cert != "":
        args_list.append("--openbao-ca-cert=" + (ctx.args.openbao_ca_cert if ctx.args.openbao_ca_cert.startswith("/") else ws_path(ctx, ctx.args.openbao_ca_cert)))
    if ctx.args.openbao_token_file != "":
        args_list.append("--openbao-token-file=" + (ctx.args.openbao_token_file if ctx.args.openbao_token_file.startswith("/") else ws_path(ctx, ctx.args.openbao_token_file)))
    if ctx.args.getter_vars_file != "":
        args_list.append("--getter-vars-file=" + (ctx.args.getter_vars_file if ctx.args.getter_vars_file.startswith("/") else ws_path(ctx, ctx.args.getter_vars_file)))
    if ctx.args.seed_bundle_file != "":
        args_list.append("--seed-bundle-file=" + (ctx.args.seed_bundle_file if ctx.args.seed_bundle_file.startswith("/") else ws_path(ctx, ctx.args.seed_bundle_file)))
    if ctx.args.listen != "":
        args_list.append("--listen=" + ctx.args.listen)
    if ctx.args.auth_token_file != "":
        args_list.append("--auth-token-file=" + (ctx.args.auth_token_file if ctx.args.auth_token_file.startswith("/") else ws_path(ctx, ctx.args.auth_token_file)))
    if ctx.args.test_prefix != "":
        args_list.append("--test-prefix=" + ctx.args.test_prefix)
    args_list.append("--verify-temp-credentials=" + ("true" if ctx.args.verify_temp_credentials else "false"))
    return bazel_run(
        ctx,
        _CLOUDFLARE_R2_CONTROL_PLANE_TARGET,
        args_list,
        bazel_args = ["--noshow_progress", "--ui_event_filters=-info"],
        label = "cloudflare-r2-control-plane --site " + site,
    )

cloudflare_r2_control_plane = task(
    implementation = _cloudflare_r2_control_plane_impl,
    name = "cloudflare-r2-control-plane",
    group = ["integrations"],
    summary = "Ensure and live-verify Cloudflare R2 deployment artifact state.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "action": args.string(default = "verify", description = "Action: serve, verify, ensure-bucket, ensure-getter, rotate-getter, or rotate-object-storage-provider."),
        "account_id": args.string(default = "", description = "Cloudflare account ID. Defaults to site.json."),
        "bucket": args.string(default = "", description = "R2 bucket. Defaults to site.json."),
        "credential_source": args.string(default = "auto", description = "Credential source: auto, env, env-file, or openbao."),
        "credentials_file": args.string(default = "", description = "Environment file containing parent R2 credentials."),
        "openbao_addr": args.string(default = "", description = "Controller OpenBao address. Defaults to BAO_ADDR or VAULT_ADDR."),
        "openbao_path": args.string(default = "kv-controller/data/integrations/cloudflare/r2-admin", description = "Controller OpenBao KV path for parent R2 credentials."),
        "openbao_ca_cert": args.string(default = "", description = "Controller OpenBao CA certificate file. Defaults to BAO_CACERT or VAULT_CACERT."),
        "openbao_token_file": args.string(default = "", description = "File containing the OpenBao token."),
        "getter_vars_file": args.string(default = "", description = "JSON vars file to receive durable Nomad artifact getter credentials."),
        "seed_bundle_file": args.string(default = "", description = "Seed bundle file to receive generated provider values."),
        "listen": args.string(default = "127.0.0.1:18732", description = "HTTP listen address for action=serve."),
        "auth_token_file": args.string(default = "", description = "Optional bearer token file for action=serve."),
        "test_prefix": args.string(default = "control-plane-verification/", description = "R2 prefix used for live verification objects."),
        "verify_temp_credentials": args.boolean(default = True, description = "Mint scoped temporary credentials and verify with them."),
    },
)

def _stripe_projects_site_dir(ctx, site):
    return ws_path(ctx, "src/integrations/stripe-projects/sites/" + site)

def _stripe_projects_preflight(ctx, stripe_ctx):
    help_cmd = ctx.std.process.command("stripe").args(stripe_ctx["args_prefix"] + ["projects", "--help"])
    for k, v in stripe_ctx["env"].items():
        help_cmd = help_cmd.env(k, v)
    help = (help_cmd
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    output = help.stdout + help.stderr
    if help.status.code != 0 or "status" not in output or "env" not in output:
        ctx.std.io.stderr.write(
            "ERROR: Bazel-resolved Stripe Projects tooling is not runnable. Expected stripe v" +
            _STRIPE_CLI_VERSION +
            " with projects plugin v" +
            _STRIPE_PROJECTS_PLUGIN_VERSION +
            ".\n",
        )
        return 1
    return 0

def _stripe_projects_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    action = ctx.args.action
    if action == "":
        ctx.std.io.stderr.write("ERROR: --action is required.\n")
        return 1
    stripe_ctx = stripe_cli_plugin_context(ctx, _STRIPE_PROJECTS_PLUGIN)
    if stripe_ctx == None:
        return 1
    if _stripe_projects_preflight(ctx, stripe_ctx) != 0:
        return 1
    site_dir = _stripe_projects_site_dir(ctx, site)
    if checked_spawn(ctx, "mkdir", ["-p", site_dir], label = "mkdir -p " + site_dir) != 0:
        return 1

    project_name = ctx.args.project_name
    if project_name == "":
        project_name = "verself-" + site

    stripe_args = stripe_ctx["args_prefix"] + ["projects"]
    label = "stripe projects " + action + " --site " + site
    if action == "init":
        if not ctx.args.confirm:
            ctx.std.io.stderr.write("ERROR: pass --confirm to initialize Stripe Projects state for " + site + ".\n")
            return 1
        stripe_args = stripe_args + ["init", project_name]
    elif action == "status":
        stripe_args = stripe_args + ["status", "--json", "--no-interactive"]
    elif action == "env":
        stripe_args = stripe_args + ["env", "--json", "--no-interactive"]
    elif action == "env-pull":
        if not ctx.args.confirm:
            ctx.std.io.stderr.write("ERROR: pass --confirm because env-pull writes .env and .projects/vault under " + site_dir + ".\n")
            return 1
        stripe_args = stripe_args + ["env", "--pull", "--json", "--no-interactive"]
    elif action == "catalog":
        stripe_args = stripe_args + ["catalog", "--json", "--no-interactive"]
    elif action == "search":
        if ctx.args.query == "":
            ctx.std.io.stderr.write("ERROR: --query is required for --action=search.\n")
            return 1
        stripe_args = stripe_args + ["search", ctx.args.query, "--json", "--no-interactive"]
    else:
        ctx.std.io.stderr.write("ERROR: unsupported Stripe Projects action " + action + ". Use init, status, env, env-pull, catalog, or search.\n")
        return 1

    return checked_spawn(
        ctx,
        "stripe",
        stripe_args,
        cwd = site_dir,
        env = stripe_ctx["env"],
        label = label,
    )

stripe_projects = task(
    implementation = _stripe_projects_impl,
    name = "stripe-projects",
    group = ["integrations"],
    summary = "Run Stripe Projects for a site-scoped provider project.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "action": args.string(default = "status", description = "Stripe Projects action: init, status, env, env-pull, catalog, or search."),
        "query": args.string(default = "", description = "Search query for --action=search."),
        "project_name": args.string(default = "", description = "Stripe Projects name for --action=init. Defaults to verself-<site>."),
        "confirm": args.boolean(default = False, description = "Required for actions that initialize state or write credentials."),
    },
)
