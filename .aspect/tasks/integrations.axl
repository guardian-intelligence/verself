"""aspect integrations cloudflare-control-plane|stripe-projects - external integration state."""

load(
    ".aspect/lib/helpers.axl",
    "DEFAULT_SITE",
    "bazel_run",
    "checked_spawn",
    "stripe_cli_plugin_context",
    "ws_path",
)

_CLOUDFLARE_CONTROL_PLANE_TARGET = "//src/integrations/cloudflare/control-plane/cmd/cloudflare-control-plane:cloudflare-control-plane"
_STRIPE_CLI_VERSION = "1.42.1"
_STRIPE_PROJECTS_PLUGIN_VERSION = "0.16.0"
_STRIPE_PROJECTS_PLUGIN = {
    "config": "src/tools/dev/binaries/stripe-projects-config.toml",
    "manifest": "src/tools/dev/binaries/stripe-projects-plugin.toml",
    "plugins": [
        {
            "shortname": "projects",
            "version": _STRIPE_PROJECTS_PLUGIN_VERSION,
            "binary": "stripe-cli-projects",
            "target": "//src/tools/dev/binaries:stripe-cli-projects",
        },
    ],
}

def _cloudflare_control_plane_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    args_list = [
        "--site=" + site,
        "--repo-root=" + ws_path(ctx),
        "--action=" + ctx.args.action,
    ]
    if ctx.args.account_id != "":
        args_list.append("--account-id=" + ctx.args.account_id)
    if ctx.args.bucket != "":
        args_list.append("--bucket=" + ctx.args.bucket)
    if ctx.args.account_admin_a_openbao_path != "":
        args_list.append("--account-admin-a-openbao-path=" + ctx.args.account_admin_a_openbao_path)
    if ctx.args.account_admin_b_openbao_path != "":
        args_list.append("--account-admin-b-openbao-path=" + ctx.args.account_admin_b_openbao_path)
    if ctx.args.openbao_addr != "":
        args_list.append("--openbao-addr=" + ctx.args.openbao_addr)
    if ctx.args.openbao_path != "":
        args_list.append("--openbao-path=" + ctx.args.openbao_path)
    if ctx.args.openbao_ca_cert != "":
        args_list.append("--openbao-ca-cert=" + (ctx.args.openbao_ca_cert if ctx.args.openbao_ca_cert.startswith("/") else ws_path(ctx, ctx.args.openbao_ca_cert)))
    if ctx.args.openbao_token_file != "":
        args_list.append("--openbao-token-file=" + (ctx.args.openbao_token_file if ctx.args.openbao_token_file.startswith("/") else ws_path(ctx, ctx.args.openbao_token_file)))
    if ctx.args.runtime_openbao_addr != "":
        args_list.append("--runtime-openbao-addr=" + ctx.args.runtime_openbao_addr)
    if ctx.args.runtime_openbao_ca_cert != "":
        args_list.append("--runtime-openbao-ca-cert=" + (ctx.args.runtime_openbao_ca_cert if ctx.args.runtime_openbao_ca_cert.startswith("/") else ws_path(ctx, ctx.args.runtime_openbao_ca_cert)))
    if ctx.args.runtime_openbao_token_file != "":
        args_list.append("--runtime-openbao-token-file=" + (ctx.args.runtime_openbao_token_file if ctx.args.runtime_openbao_token_file.startswith("/") else ws_path(ctx, ctx.args.runtime_openbao_token_file)))
    if ctx.args.dns_inventory != "":
        args_list.append("--dns-inventory=" + (ctx.args.dns_inventory if ctx.args.dns_inventory.startswith("/") else ws_path(ctx, ctx.args.dns_inventory)))
    if ctx.args.dns_concurrency != 0:
        args_list.append("--dns-concurrency=" + str(ctx.args.dns_concurrency))
    if ctx.args.dry_run:
        args_list.append("--dry-run")
    if ctx.args.provider != "":
        args_list.append("--provider=" + ctx.args.provider)
    if ctx.args.cloudflare_api_token_file != "":
        args_list.append("--cloudflare-api-token-file=" + (ctx.args.cloudflare_api_token_file if ctx.args.cloudflare_api_token_file.startswith("/") else ws_path(ctx, ctx.args.cloudflare_api_token_file)))
    if ctx.args.certificate_output_dir != "":
        args_list.append("--certificate-output-dir=" + (ctx.args.certificate_output_dir if ctx.args.certificate_output_dir.startswith("/") else ws_path(ctx, ctx.args.certificate_output_dir)))
    if ctx.args.tls_product_domain != "":
        args_list.append("--tls-product-domain=" + ctx.args.tls_product_domain)
    if ctx.args.tls_company_domain != "":
        args_list.append("--tls-company-domain=" + ctx.args.tls_company_domain)
    if ctx.args.tls_product_zone != "":
        args_list.append("--tls-product-zone=" + ctx.args.tls_product_zone)
    if ctx.args.tls_company_zone != "":
        args_list.append("--tls-company-zone=" + ctx.args.tls_company_zone)
    if ctx.args.acme_directory_url != "":
        args_list.append("--acme-directory-url=" + ctx.args.acme_directory_url)
    if ctx.args.acme_contact_email != "":
        args_list.append("--acme-contact-email=" + ctx.args.acme_contact_email)
    if ctx.args.acme_dns_propagation_wait != "":
        args_list.append("--acme-dns-propagation-wait=" + ctx.args.acme_dns_propagation_wait)
    if ctx.args.certificate_renew_before != "":
        args_list.append("--certificate-renew-before=" + ctx.args.certificate_renew_before)
    if ctx.args.test_prefix != "":
        args_list.append("--test-prefix=" + ctx.args.test_prefix)
    if ctx.args.inventory_prefix != "":
        args_list.append("--inventory-prefix=" + ctx.args.inventory_prefix)
    if ctx.args.inventory_depth != 0:
        args_list.append("--inventory-depth=" + str(ctx.args.inventory_depth))
    if ctx.args.child_token_ttl != "":
        args_list.append("--child-token-ttl=" + ctx.args.child_token_ttl)
    if ctx.args.account_admin_ttl != "":
        args_list.append("--account-admin-ttl=" + ctx.args.account_admin_ttl)
    if ctx.args.timeout != "":
        args_list.append("--timeout=" + ctx.args.timeout)
    args_list.append("--verify-temp-credentials=" + ("true" if ctx.args.verify_temp_credentials else "false"))
    return bazel_run(
        ctx,
        _CLOUDFLARE_CONTROL_PLANE_TARGET,
        args_list,
        bazel_args = ["--noshow_progress", "--ui_event_filters=-info"],
        label = "cloudflare-control-plane --site " + site,
    )

cloudflare_control_plane = task(
    implementation = _cloudflare_control_plane_impl,
    name = "cloudflare-control-plane",
    group = ["integrations"],
    summary = "Manage Cloudflare DNS/R2 resources and public-edge certificate issuance.",
    args = {
        "site": args.string(default = "prod", description = "Target deployment site for DNS records, R2 prefixes, and scoped R2 credentials. Cloudflare authority is global and prod-owned."),
        "action": args.string(default = "verify-admin-pair", description = "Action: verify-admin-pair, rotate-admin-pair, verify-dns-authority, reconcile-dns, issue-site-certificates, provision-site, inventory, verify, ensure-bucket, ensure-publisher, rotate-publisher, ensure-recovery, rotate-recovery, or rotate-object-storage-provider."),
        "account_id": args.string(default = "", description = "Cloudflare account ID. Defaults to site.json."),
        "bucket": args.string(default = "", description = "R2 bucket. Defaults to src/integrations/cloudflare/account.json."),
        "account_admin_a_openbao_path": args.string(default = "kv-controller/data/integrations/cloudflare/account-admin/a", description = "Prod controller OpenBao KV path for global Cloudflare account-admin slot A."),
        "account_admin_b_openbao_path": args.string(default = "kv-controller/data/integrations/cloudflare/account-admin/b", description = "Prod controller OpenBao KV path for global Cloudflare account-admin slot B."),
        "openbao_addr": args.string(default = "", description = "Controller OpenBao address."),
        "openbao_path": args.string(default = "kv-controller/data/integrations/cloudflare/r2/capabilities/deployment-publisher", description = "Controller OpenBao KV path for R2 credentials."),
        "openbao_ca_cert": args.string(default = "", description = "Controller OpenBao CA certificate file. Defaults to BAO_CACERT or VAULT_CACERT."),
        "openbao_token_file": args.string(default = "", description = "File containing the OpenBao token."),
        "runtime_openbao_addr": args.string(default = "", description = "Runtime OpenBao address for service-required secret projection. Defaults to openbao_addr."),
        "runtime_openbao_ca_cert": args.string(default = "", description = "Runtime OpenBao CA certificate file. Defaults to openbao_ca_cert, BAO_CACERT, or VAULT_CACERT."),
        "runtime_openbao_token_file": args.string(default = "", description = "Runtime OpenBao token file. Defaults to openbao_token_file."),
        "dns_inventory": args.string(default = "", description = "Site inventory used for DNS target IP fallback. Defaults to src/sites/<site>/inventory.ini."),
        "dns_concurrency": args.int(default = 8, description = "Maximum parallel Cloudflare DNS write requests for reconcile-dns."),
        "dry_run": args.boolean(default = False, description = "Report the DNS diff without applying writes for reconcile-dns."),
        "provider": args.string(default = "", description = "Provider for direct certificate issuance. Supported value: cloudflare."),
        "cloudflare_api_token_file": args.string(default = "", description = "File containing the Cloudflare API token for issue-site-certificates."),
        "certificate_output_dir": args.string(default = "", description = "Directory to receive HAProxy public certificate PEM files."),
        "tls_product_domain": args.string(default = "", description = "Product domain for public TLS issuance."),
        "tls_company_domain": args.string(default = "", description = "Company domain for public TLS issuance."),
        "tls_product_zone": args.string(default = "", description = "Cloudflare DNS zone for the product domain."),
        "tls_company_zone": args.string(default = "", description = "Cloudflare DNS zone for the company domain."),
        "acme_directory_url": args.string(default = "", description = "ACME directory URL for public certificate issuance."),
        "acme_contact_email": args.string(default = "", description = "ACME account contact email for issue-site-certificates."),
        "acme_dns_propagation_wait": args.string(default = "", description = "Maximum wait for ACME DNS-01 TXT propagation."),
        "certificate_renew_before": args.string(default = "", description = "Renew certificates expiring before this duration."),
        "test_prefix": args.string(default = "control-plane-verification/", description = "R2 prefix used for live verification objects."),
        "inventory_prefix": args.string(default = "", description = "R2 object prefix for --action=inventory."),
        "inventory_depth": args.int(default = 2, description = "Prefix depth for --action=inventory summaries."),
        "child_token_ttl": args.string(default = "168h", description = "TTL for generated Cloudflare child API tokens."),
        "account_admin_ttl": args.string(default = "168h", description = "TTL for account-admin token expiration updates during rotation."),
        "timeout": args.string(default = "", description = "Total timeout for Cloudflare R2 control-plane calls."),
        "verify_temp_credentials": args.boolean(default = True, description = "Mint scoped temporary credentials and verify with them."),
    },
)

def _stripe_projects_site_dir(ctx, site):
    return ws_path(ctx, "src/integrations/stripe-projects/sites/" + site)

def _stripe_projects_preflight(ctx, stripe_ctx):
    help_cmd = ctx.std.process.command("stripe").args(stripe_ctx["args_prefix"] + ["projects", "--help"])
    for k, v in stripe_ctx["env"].items():
        help_cmd = help_cmd.env(k, v)
    help = (help_cmd
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    output = help.stdout + help.stderr
    if help.status.code != 0 or "status" not in output or "env" not in output:
        ctx.std.io.stderr.write(
            "ERROR: Bazel-resolved Stripe Projects tooling is not runnable. Expected stripe v" +
            _STRIPE_CLI_VERSION +
            " with projects plugin v" +
            _STRIPE_PROJECTS_PLUGIN_VERSION +
            ".\n",
        )
        return 1
    return 0

def _stripe_projects_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    action = ctx.args.action
    if action == "":
        ctx.std.io.stderr.write("ERROR: --action is required.\n")
        return 1
    stripe_ctx = stripe_cli_plugin_context(ctx, _STRIPE_PROJECTS_PLUGIN)
    if stripe_ctx == None:
        return 1
    if _stripe_projects_preflight(ctx, stripe_ctx) != 0:
        return 1
    site_dir = _stripe_projects_site_dir(ctx, site)
    if checked_spawn(ctx, "mkdir", ["-p", site_dir], label = "mkdir -p " + site_dir) != 0:
        return 1

    project_name = ctx.args.project_name
    if project_name == "":
        project_name = "verself-" + site

    stripe_args = stripe_ctx["args_prefix"] + ["projects"]
    label = "stripe projects " + action + " --site " + site
    if action == "init":
        if not ctx.args.confirm:
            ctx.std.io.stderr.write("ERROR: pass --confirm to initialize Stripe Projects state for " + site + ".\n")
            return 1
        stripe_args = stripe_args + ["init", project_name]
    elif action == "status":
        stripe_args = stripe_args + ["status", "--json", "--no-interactive"]
    elif action == "env":
        stripe_args = stripe_args + ["env", "--json", "--no-interactive"]
    elif action == "env-pull":
        if not ctx.args.confirm:
            ctx.std.io.stderr.write("ERROR: pass --confirm because env-pull writes .env and .projects/vault under " + site_dir + ".\n")
            return 1
        stripe_args = stripe_args + ["env", "--pull", "--json", "--no-interactive"]
    elif action == "catalog":
        stripe_args = stripe_args + ["catalog", "--json", "--no-interactive"]
    elif action == "search":
        if ctx.args.query == "":
            ctx.std.io.stderr.write("ERROR: --query is required for --action=search.\n")
            return 1
        stripe_args = stripe_args + ["search", ctx.args.query, "--json", "--no-interactive"]
    else:
        ctx.std.io.stderr.write("ERROR: unsupported Stripe Projects action " + action + ". Use init, status, env, env-pull, catalog, or search.\n")
        return 1

    return checked_spawn(
        ctx,
        "stripe",
        stripe_args,
        cwd = site_dir,
        env = stripe_ctx["env"],
        label = label,
    )

stripe_projects = task(
    implementation = _stripe_projects_impl,
    name = "stripe-projects",
    group = ["integrations"],
    summary = "Run Stripe Projects for a site-scoped provider project.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "action": args.string(default = "status", description = "Stripe Projects action: init, status, env, env-pull, catalog, or search."),
        "query": args.string(default = "", description = "Search query for --action=search."),
        "project_name": args.string(default = "", description = "Stripe Projects name for --action=init. Defaults to verself-<site>."),
        "confirm": args.boolean(default = False, description = "Required for actions that initialize state or write credentials."),
    },
)
