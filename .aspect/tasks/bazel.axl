"""aspect bazel gazelle|bzlmod|update — Bazel-graph orchestration shortcuts.

These are the durable AXL wrappers around the Bazel-graph workflows that an
operator runs by hand often enough to want shape and help text. Everything
else (one-off `bazel build|test|query` against ad-hoc target patterns) is
`guardian run bazel -- ...` and intentionally out of scope.
"""

load(".aspect/lib/helpers.axl", "bazel_command")

def _gazelle_impl(ctx):
    return bazel_command(
        ctx,
        [
            "run",
            "//:gazelle",
            "--",
            "update",
            "-go_naming_convention=import",
            "-go_naming_convention_external=import",
        ],
        label = "guardian run bazel -- run //:gazelle -- update",
    )

def _bzlmod_impl(ctx):
    return bazel_command(
        ctx,
        ["mod", "tidy", "--lockfile_mode=update"],
        label = "guardian run bazel -- mod tidy",
    )

def _update_impl(ctx):
    rc = _gazelle_impl(ctx)
    if rc != 0:
        return rc
    return _bzlmod_impl(ctx)

gazelle = task(
    implementation = _gazelle_impl,
    name = "gazelle",
    group = ["bazel"],
    summary = "Regenerate Bazel Go BUILD files via gazelle update.",
)

bzlmod = task(
    implementation = _bzlmod_impl,
    name = "bzlmod",
    group = ["bazel"],
    summary = "Update Bzlmod repository wiring (`guardian run bazel -- mod tidy --lockfile_mode=update`).",
)

update = task(
    implementation = _update_impl,
    name = "update",
    group = ["bazel"],
    summary = "Run `aspect bazel gazelle` then `aspect bazel bzlmod`.",
)
