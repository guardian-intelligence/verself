"""aspect site inventory-write|root-handoff|converge-host|bootstrap-deploy."""

load(
    ".aspect/lib/helpers.axl",
    "DEFAULT_SITE",
    "HOST_CONFIGURATION_DIR",
    "bazel_output_file",
    "bazel_run",
    "checked_spawn",
    "host_ansible_env",
    "host_ansible_playbook",
    "inventory_check",
    "require_arg",
    "resolve_sha",
    "ws_path",
)

_SITE_BOOTSTRAP_TARGET = "//src/tools/deployment/cmd/site-bootstrap:site-bootstrap"
_HOST_TOOLS_TARGET = "//src/host:host_tools_artifact"
_SPIRE_IDENTITY_REGISTRY_TARGET = "//src/host:spire_identity_registry"

def _abs(ctx, path):
    if path == "":
        return ""
    if path.startswith("/"):
        return path
    return ws_path(ctx, path)

def _default_inventory(site):
    return HOST_CONFIGURATION_DIR + "/sites/" + site + "/inventory.ini"

def _require_existing_file(ctx, name, path):
    resolved = _abs(ctx, path)
    exists = (ctx.std.process.command("test")
        .args(["-f", resolved])
        .spawn().wait())
    if exists.code != 0:
        ctx.std.io.stderr.write("ERROR: --" + name + " file not found: " + path + "\n")
        return False
    return True

def _inventory_write_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    out = ctx.args.out or _default_inventory(site)
    args_list = [
        "inventory-write",
        "--site=" + site,
        "--host=" + ctx.args.host,
        "--out=" + _abs(ctx, out),
    ]
    if ctx.args.host_alias != "":
        args_list.append("--host-alias=" + ctx.args.host_alias)
    if ctx.args.user != "":
        args_list.append("--user=" + ctx.args.user)
    if ctx.args.force:
        args_list.append("--force")
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        label = "site-bootstrap inventory-write --site " + site,
    )

inventory_write = task(
    implementation = _inventory_write_impl,
    name = "inventory-write",
    group = ["site"],
    summary = "Write site inventory for a provisioned host.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "host": args.string(default = "", description = "Host IP address or DNS name."),
        "host_alias": args.string(default = "", description = "Inventory host alias."),
        "user": args.string(default = "ubuntu", description = "Ansible SSH user."),
        "out": args.string(default = "", description = "Inventory output path."),
        "force": args.boolean(default = False, description = "Overwrite existing inventory."),
    },
)

def _root_handoff_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    inventory = ctx.args.inventory or _default_inventory(site)
    root_password_file = ctx.args.root_password_file
    if root_password_file != "":
        root_password_file = _abs(ctx, root_password_file)
    args_list = [
        "root-handoff",
        "--site=" + site,
        "--host=" + ctx.args.host,
        "--root-password-file=" + root_password_file,
        "--inventory=" + _abs(ctx, inventory),
    ]
    if ctx.args.port != 0:
        args_list.append("--port=" + str(ctx.args.port))
    if ctx.args.public_key_file != "":
        args_list.append("--public-key-file=" + _abs(ctx, ctx.args.public_key_file))
    if ctx.args.private_key_file != "":
        args_list.append("--private-key-file=" + _abs(ctx, ctx.args.private_key_file))
    if ctx.args.user != "":
        args_list.append("--user=" + ctx.args.user)
    if ctx.args.host_alias != "":
        args_list.append("--host-alias=" + ctx.args.host_alias)
    if ctx.args.host_key_sha256 != "":
        args_list.append("--host-key-sha256=" + ctx.args.host_key_sha256)
    if ctx.args.trust_first_use:
        args_list.append("--trust-first-use")
    if ctx.args.force_inventory:
        args_list.append("--force-inventory")
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        label = "site-bootstrap root-handoff --site " + site,
    )

root_handoff = task(
    implementation = _root_handoff_impl,
    name = "root-handoff",
    group = ["site"],
    summary = "Replace fresh-host root password access with operator SSH key access.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "host": args.string(default = "", description = "Fresh host IP address or DNS name."),
        "port": args.int(default = 22, description = "SSH port."),
        "root_password_file": args.string(default = "", description = "File containing the fresh host root password."),
        "public_key_file": args.string(default = "", description = "Operator SSH public key."),
        "private_key_file": args.string(default = "", description = "Operator SSH private key."),
        "user": args.string(default = "ubuntu", description = "Bootstrap SSH user."),
        "host_alias": args.string(default = "", description = "Inventory host alias."),
        "inventory": args.string(default = "", description = "Inventory output path."),
        "host_key_sha256": args.string(default = "", description = "Expected SSH host key SHA256 fingerprint."),
        "trust_first_use": args.boolean(default = False, description = "Allow first connection without an expected host key fingerprint."),
        "force_inventory": args.boolean(default = False, description = "Overwrite existing inventory."),
    },
)

def _converge_host_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    site_root_key = ctx.args.openbao_site_root_key_file
    if not require_arg(ctx, "openbao-site-root-key-file", site_root_key):
        return 1
    if not _require_existing_file(ctx, "openbao-site-root-key-file", site_root_key):
        return 1
    if inventory_check(ctx, site = site) != 0:
        return 1
    ansible_playbook = host_ansible_playbook(ctx)
    if ansible_playbook == "":
        return 1
    env = host_ansible_env(ctx)
    if env == None:
        return 1
    ansible_dir = ws_path(ctx, HOST_CONFIGURATION_DIR, "ansible")
    host_tools = bazel_output_file(ctx, _HOST_TOOLS_TARGET)
    if host_tools == "":
        return 1
    spire_registry = bazel_output_file(ctx, _SPIRE_IDENTITY_REGISTRY_TARGET)
    if spire_registry == "":
        return 1
    playbook_args = [
        "-i",
        ws_path(ctx, _default_inventory(site)),
        "playbooks/site.yml",
        "--skip-tags",
        "edge,haproxy",
        "-e",
        "verself_site=" + site,
        "-e",
        "verself_host_tools_artifact=" + host_tools,
        "-e",
        "spire_registrations_file=" + spire_registry,
        "-e",
        "verself_openbao_site_root_key_file=" + _abs(ctx, site_root_key),
    ]
    return checked_spawn(
        ctx,
        ansible_playbook,
        playbook_args,
        cwd = ansible_dir,
        env = env,
        label = "ansible-playbook site.yml --site " + site,
    )

converge_host = task(
    implementation = _converge_host_impl,
    name = "converge-host",
    group = ["site"],
    summary = "Converge the minimum host foundation and Nomad substrate for a site.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "openbao_site_root_key_file": args.string(default = "", description = "Operator-held site root key file for OpenBao bootstrap."),
    },
)

def _bootstrap_deploy_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    sha = resolve_sha(ctx, ctx.args.sha or "")
    if sha == "":
        return 1
    if inventory_check(ctx, site = site) != 0:
        return 1
    args_list = [
        "bootstrap-deploy",
        "--site=" + site,
        "--sha=" + sha,
        "--repo-root=" + ws_path(ctx),
        "--inventory=" + ws_path(ctx, _default_inventory(site)),
        "--ssh-transport=" + ctx.args.ssh_transport,
    ]
    if ctx.args.timeout != "":
        args_list.append("--timeout=" + ctx.args.timeout)
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        cwd = ws_path(ctx),
        label = "site-bootstrap bootstrap-deploy --site " + site,
    )

bootstrap_deploy = task(
    implementation = _bootstrap_deploy_impl,
    name = "bootstrap-deploy",
    group = ["site"],
    summary = "First deploy for a bootstrapped host before deployment-service is reachable.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "sha": args.string(default = "", description = "Git SHA or ref to deploy. Defaults to HEAD."),
        "ssh_transport": args.string(default = "recovery", description = "SSH transport for the bootstrap Nomad tunnel: recovery or inventory."),
        "timeout": args.string(default = "15m", description = "Bootstrap deploy timeout as a Go duration."),
    },
)
