"""aspect site seed-template|materialize-seed|validate-seed|inventory-write|root-handoff|converge-host."""

load(
    ".aspect/lib/helpers.axl",
    "DEFAULT_SITE",
    "HOST_CONFIGURATION_DIR",
    "bazel_output_file",
    "bazel_run",
    "checked_spawn",
    "host_ansible_env",
    "host_ansible_playbook",
    "inventory_check",
    "resolve_sha",
    "ws_path",
)

_SITE_BOOTSTRAP_TARGET = "//src/tools/deployment/cmd/site-bootstrap:site-bootstrap"
_CLOUDFLARE_R2_CONTROL_PLANE_TARGET = "//src/integrations/cloudflare/r2-control-plane/cmd/cloudflare-r2-control-plane:cloudflare-r2-control-plane"
_HAPROXY_HOST_INSTALL_TARGET = "//src/infrastructure-components/haproxy:host_install_artifact"
_HOST_TOOLS_TARGET = "//src/host:host_tools_artifact"
_SPIRE_IDENTITY_REGISTRY_TARGET = "//src/host:spire_identity_registry"

def _abs(ctx, path):
    if path == "":
        return ""
    if path.startswith("/"):
        return path
    return ws_path(ctx, path)

def _default_seed(site):
    return ".verself/site-bootstrap/" + site + "/seed.yml"

def _default_vars(site):
    return ".verself/site-bootstrap/" + site + "/ansible-secrets.json"

def _default_runtime_seed(site):
    return ".verself/site-bootstrap/" + site + "/openbao-runtime-seed.json"

def _default_site_root_key(site):
    return ".verself/site-bootstrap/" + site + "/site-root.key"

def _default_r2_publisher_credentials(site):
    return ".verself/site-bootstrap/" + site + "/r2-publisher.env"

def _default_evidence(site):
    return ".verself/site-bootstrap/" + site + "/seed-fingerprints.json"

def _default_inventory(site):
    return HOST_CONFIGURATION_DIR + "/sites/" + site + "/inventory.ini"

def _seed_template_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    out = ctx.args.out or _default_seed(site)
    args_list = ["seed-template", "--site=" + site, "--out=" + _abs(ctx, out), "--repo-root=" + ws_path(ctx)]
    if ctx.args.force:
        args_list.append("--force")
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        label = "site-bootstrap seed-template --site " + site,
    )

seed_template = task(
    implementation = _seed_template_impl,
    name = "seed-template",
    group = ["site"],
    summary = "Create a local ignored seed-bundle template for a site.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "out": args.string(default = "", description = "Output seed template path."),
        "force": args.boolean(default = False, description = "Overwrite an existing template."),
    },
)

def _validate_seed_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    seed = ctx.args.seed_bundle or _default_seed(site)
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        # Keep seed validation tied to owner-local deploy declarations.
        # The Bazel runfiles cwd is not the repo root.
        ["seed-validate", "--site=" + site, "--seed-bundle=" + _abs(ctx, seed), "--repo-root=" + ws_path(ctx)],
        label = "site-bootstrap seed-validate --site " + site,
    )

validate_seed = task(
    implementation = _validate_seed_impl,
    name = "validate-seed",
    group = ["site"],
    summary = "Validate a local site seed bundle without materializing generated secrets.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "seed_bundle": args.string(default = "", description = "Seed bundle path. Defaults to .verself/site-bootstrap/<site>/seed.yml."),
    },
)

def _materialize_seed_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    seed = ctx.args.seed_bundle or _default_seed(site)
    vars_file = ctx.args.out_vars or _default_vars(site)
    runtime_seed = ctx.args.out_openbao_runtime_seed or _default_runtime_seed(site)
    evidence = ctx.args.out_evidence or _default_evidence(site)
    args_list = [
        "seed-materialize",
        "--site=" + site,
        "--seed-bundle=" + _abs(ctx, seed),
        "--out-vars=" + _abs(ctx, vars_file),
        "--out-openbao-runtime-seed=" + _abs(ctx, runtime_seed),
        "--out-evidence=" + _abs(ctx, evidence),
        "--repo-root=" + ws_path(ctx),
    ]
    if ctx.args.force:
        args_list.append("--force")
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        label = "site-bootstrap seed-materialize --site " + site,
    )

materialize_seed = task(
    implementation = _materialize_seed_impl,
    name = "materialize-seed",
    group = ["site"],
    summary = "Materialize generated site secrets and fingerprint evidence outside git.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "seed_bundle": args.string(default = "", description = "Seed bundle path. Defaults to .verself/site-bootstrap/<site>/seed.yml."),
        "out_vars": args.string(default = "", description = "Generated Ansible vars path."),
        "out_openbao_runtime_seed": args.string(default = "", description = "Filtered OpenBao runtime seed path."),
        "out_evidence": args.string(default = "", description = "Generated fingerprint evidence path."),
        "force": args.boolean(default = False, description = "Overwrite existing generated outputs."),
    },
)

def _inventory_write_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    out = ctx.args.out or _default_inventory(site)
    args_list = [
        "inventory-write",
        "--site=" + site,
        "--host=" + ctx.args.host,
        "--out=" + _abs(ctx, out),
    ]
    if ctx.args.host_alias != "":
        args_list.append("--host-alias=" + ctx.args.host_alias)
    if ctx.args.user != "":
        args_list.append("--user=" + ctx.args.user)
    if ctx.args.force:
        args_list.append("--force")
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        label = "site-bootstrap inventory-write --site " + site,
    )

inventory_write = task(
    implementation = _inventory_write_impl,
    name = "inventory-write",
    group = ["site"],
    summary = "Write site inventory for a provisioned host.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "host": args.string(default = "", description = "Host IP address or DNS name."),
        "host_alias": args.string(default = "", description = "Inventory host alias."),
        "user": args.string(default = "ubuntu", description = "Ansible SSH user."),
        "out": args.string(default = "", description = "Inventory output path."),
        "force": args.boolean(default = False, description = "Overwrite existing inventory."),
    },
)

def _root_handoff_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    inventory = ctx.args.inventory or _default_inventory(site)
    root_password_file = ctx.args.root_password_file
    if root_password_file != "":
        root_password_file = _abs(ctx, root_password_file)
    args_list = [
        "root-handoff",
        "--site=" + site,
        "--host=" + ctx.args.host,
        "--root-password-file=" + root_password_file,
        "--inventory=" + _abs(ctx, inventory),
    ]
    if ctx.args.port != 0:
        args_list.append("--port=" + str(ctx.args.port))
    if ctx.args.public_key_file != "":
        args_list.append("--public-key-file=" + _abs(ctx, ctx.args.public_key_file))
    if ctx.args.private_key_file != "":
        args_list.append("--private-key-file=" + _abs(ctx, ctx.args.private_key_file))
    if ctx.args.user != "":
        args_list.append("--user=" + ctx.args.user)
    if ctx.args.host_alias != "":
        args_list.append("--host-alias=" + ctx.args.host_alias)
    if ctx.args.host_key_sha256 != "":
        args_list.append("--host-key-sha256=" + ctx.args.host_key_sha256)
    if ctx.args.trust_first_use:
        args_list.append("--trust-first-use")
    if ctx.args.force_inventory:
        args_list.append("--force-inventory")
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        label = "site-bootstrap root-handoff --site " + site,
    )

root_handoff = task(
    implementation = _root_handoff_impl,
    name = "root-handoff",
    group = ["site"],
    summary = "Replace fresh-host root password access with operator SSH key access.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "host": args.string(default = "", description = "Fresh host IP address or DNS name."),
        "port": args.int(default = 22, description = "SSH port."),
        "root_password_file": args.string(default = "", description = "File containing the fresh host root password."),
        "public_key_file": args.string(default = "", description = "Operator SSH public key."),
        "private_key_file": args.string(default = "", description = "Operator SSH private key."),
        "user": args.string(default = "ubuntu", description = "Bootstrap SSH user."),
        "host_alias": args.string(default = "", description = "Inventory host alias."),
        "inventory": args.string(default = "", description = "Inventory output path."),
        "host_key_sha256": args.string(default = "", description = "Expected SSH host key SHA256 fingerprint."),
        "trust_first_use": args.boolean(default = False, description = "Allow first connection without an expected host key fingerprint."),
        "force_inventory": args.boolean(default = False, description = "Overwrite existing inventory."),
    },
)

def _converge_host_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    secret_vars = ctx.args.secret_vars_file
    use_secret_vars = secret_vars != ""
    if secret_vars == "" and site != "prod":
        secret_vars = _default_vars(site)
        use_secret_vars = True
    runtime_seed = ctx.args.openbao_runtime_seed_file
    use_runtime_seed = runtime_seed != ""
    if runtime_seed == "" and use_secret_vars:
        runtime_seed = _default_runtime_seed(site)
        use_runtime_seed = True
    site_root_key = ctx.args.openbao_site_root_key_file or _default_site_root_key(site)
    if inventory_check(ctx, site = site) != 0:
        return 1
    exists = (ctx.std.process.command("test")
        .args(["-f", _abs(ctx, site_root_key)])
        .spawn().wait())
    if exists.code != 0:
        ctx.std.io.stderr.write("ERROR: " + site_root_key + " not found. Create the site root key before host convergence.\n")
        return 1
    if use_secret_vars:
        exists = (ctx.std.process.command("test")
            .args(["-f", _abs(ctx, secret_vars)])
            .spawn().wait())
        if exists.code != 0:
            ctx.std.io.stderr.write("ERROR: " + secret_vars + " not found. Run aspect site materialize-seed --site=" + site + " first.\n")
            return 1
    if use_runtime_seed:
        exists = (ctx.std.process.command("test")
            .args(["-f", _abs(ctx, runtime_seed)])
            .spawn().wait())
        if exists.code != 0:
            ctx.std.io.stderr.write("ERROR: " + runtime_seed + " not found. Run aspect site materialize-seed --site=" + site + " first.\n")
            return 1
    ansible_playbook = host_ansible_playbook(ctx)
    if ansible_playbook == "":
        return 1
    env = host_ansible_env(ctx)
    if env == None:
        return 1
    ansible_dir = ws_path(ctx, HOST_CONFIGURATION_DIR, "ansible")
    host_tools = bazel_output_file(ctx, _HOST_TOOLS_TARGET)
    if host_tools == "":
        return 1
    haproxy_host_install = bazel_output_file(ctx, _HAPROXY_HOST_INSTALL_TARGET)
    if haproxy_host_install == "":
        return 1
    spire_registry = bazel_output_file(ctx, _SPIRE_IDENTITY_REGISTRY_TARGET)
    if spire_registry == "":
        return 1
    playbook_args = [
        "-i",
        ws_path(ctx, _default_inventory(site)),
        "playbooks/site.yml",
        "-e",
        "verself_site=" + site,
        "-e",
        "verself_host_tools_artifact=" + host_tools,
        "-e",
        "haproxy_host_install_artifact=" + haproxy_host_install,
        "-e",
        "spire_registrations_file=" + spire_registry,
        "-e",
        "verself_openbao_site_root_key_file=" + _abs(ctx, site_root_key),
    ]
    if use_secret_vars:
        playbook_args.extend([
            "-e",
            "verself_site_secret_vars_file=" + _abs(ctx, secret_vars),
        ])
    if use_runtime_seed:
        playbook_args.extend([
            "-e",
            "verself_openbao_runtime_seed_file=" + _abs(ctx, runtime_seed),
        ])
    return checked_spawn(
        ctx,
        ansible_playbook,
        playbook_args,
        cwd = ansible_dir,
        env = env,
        label = "ansible-playbook site.yml --site " + site,
    )

converge_host = task(
    implementation = _converge_host_impl,
    name = "converge-host",
    group = ["site"],
    summary = "Converge the minimum host foundation and Nomad substrate for a site.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "secret_vars_file": args.string(default = "", description = "Generated Ansible vars file."),
        "openbao_runtime_seed_file": args.string(default = "", description = "Filtered OpenBao runtime seed file."),
        "openbao_site_root_key_file": args.string(default = "", description = "Site root key file. Defaults to .verself/site-bootstrap/<site>/site-root.key."),
    },
)

def _bootstrap_deploy_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    sha = resolve_sha(ctx, ctx.args.sha or "")
    if sha == "":
        return 1
    secret_vars = ctx.args.secret_vars_file or _default_vars(site)
    runtime_seed = ctx.args.openbao_runtime_seed_file or _default_runtime_seed(site)
    for path in [secret_vars, runtime_seed]:
        exists = (ctx.std.process.command("test")
            .args(["-f", _abs(ctx, path)])
            .spawn().wait())
        if exists.code != 0:
            ctx.std.io.stderr.write("ERROR: " + path + " not found. Run aspect site materialize-seed --site=" + site + " first.\n")
            return 1
    if inventory_check(ctx, site = site) != 0:
        return 1
    r2_control_plane = bazel_output_file(ctx, _CLOUDFLARE_R2_CONTROL_PLANE_TARGET)
    if r2_control_plane == "":
        return 1
    args_list = [
        "bootstrap-deploy",
        "--site=" + site,
        "--sha=" + sha,
        "--repo-root=" + ws_path(ctx),
        "--inventory=" + ws_path(ctx, _default_inventory(site)),
        "--secret-vars-file=" + _abs(ctx, secret_vars),
        "--openbao-runtime-seed-file=" + _abs(ctx, runtime_seed),
        "--ssh-transport=" + ctx.args.ssh_transport,
        "--r2-control-plane-binary=" + r2_control_plane,
        "--r2-credential-source=" + ctx.args.r2_credential_source,
    ]
    r2_credentials_file = ctx.args.r2_credentials_file or _default_r2_publisher_credentials(site)
    args_list.append("--r2-credentials-file=" + _abs(ctx, r2_credentials_file))
    if ctx.args.timeout != "":
        args_list.append("--timeout=" + ctx.args.timeout)
    return bazel_run(
        ctx,
        _SITE_BOOTSTRAP_TARGET,
        args_list,
        cwd = ws_path(ctx),
        label = "site-bootstrap bootstrap-deploy --site " + site,
    )

bootstrap_deploy = task(
    implementation = _bootstrap_deploy_impl,
    name = "bootstrap-deploy",
    group = ["site"],
    summary = "Quarantined first deploy for a bootstrapped host before deployment-service is reachable.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "sha": args.string(default = "", description = "Git SHA or ref to deploy. Defaults to HEAD."),
        "secret_vars_file": args.string(default = "", description = "Generated Ansible vars file. Defaults to .verself/site-bootstrap/<site>/ansible-secrets.json."),
        "openbao_runtime_seed_file": args.string(default = "", description = "Filtered OpenBao runtime seed file. Defaults to .verself/site-bootstrap/<site>/openbao-runtime-seed.json."),
        "ssh_transport": args.string(default = "recovery", description = "SSH transport for the bootstrap Nomad tunnel: recovery or inventory."),
        "r2_credential_source": args.string(default = "env-file", description = "R2 credential source for bootstrap publishing: env, env-file, or auto."),
        "r2_credentials_file": args.string(default = "", description = "Scoped R2 publisher env file. Defaults to .verself/site-bootstrap/<site>/r2-publisher.env."),
        "timeout": args.string(default = "15m", description = "Bootstrap deploy timeout as a Go duration."),
    },
)
