"""aspect dev <action> — controller development helpers."""

load(
    ".aspect/lib/helpers.axl",
    "SOPS_SHIM",
    "bazel_output_file",
    "bazel_run",
    "checked_spawn",
    "install_bazel_tool_shims",
    "ws_path",
)

DEV_CONVENIENCE_SHIMS = [
    ("age", "//src/tools/dev/binaries:age"),
    ("age-keygen", "//src/tools/dev/binaries:age-keygen"),
    ("buildifier", "//src/tools/dev/binaries:buildifier"),
    ("gofumpt", "//src/tools/dev/binaries:gofumpt"),
    SOPS_SHIM,
    ("uv", "//src/tools/dev/binaries:uv"),
    ("uvx", "//src/tools/dev/binaries:uvx"),
]

def _install_impl(ctx):
    if ctx.args.install_shims or ctx.args.print_path:
        bin_dir = install_bazel_tool_shims(ctx, DEV_CONVENIENCE_SHIMS, ctx.args.bin_dir)
        if bin_dir == "":
            return 1
        if ctx.args.print_path:
            ctx.std.io.stdout.write(bin_dir + "\n")
    return 0

def _sops_init_impl(ctx):
    age_keygen = bazel_output_file(ctx, "//src/tools/dev/binaries:age-keygen")
    if age_keygen == "":
        return 1
    sops = bazel_output_file(ctx, "//src/tools/dev/binaries:sops")
    if sops == "":
        return 1
    return bazel_run(
        ctx,
        "//src/tools/dev/cmd/sops-init:sops-init",
        [
            "--repo-root",
            ws_path(ctx),
            "--site",
            "prod",
            "--age-keygen-bin",
            age_keygen,
            "--sops-bin",
            sops,
        ],
        cwd = ws_path(ctx),
        label = "sops-init",
    )

def _hooks_install_impl(ctx):
    existing_hooks_path = (ctx.std.process.command("git")
        .args(["config", "--get-all", "core.hooksPath"])
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if existing_hooks_path.status.code == 0 and existing_hooks_path.stdout.strip() != "":
        rc = checked_spawn(ctx, "git", ["config", "--unset-all", "core.hooksPath"], label = "git config --unset-all core.hooksPath")
        if rc != 0:
            return rc
    return bazel_run(
        ctx,
        "//src/tools/dev/binaries:uv",
        ["tool", "run", "--from", "pre-commit==4.5.1", "pre-commit", "install"],
        cwd = ws_path(ctx),
        label = "uv tool run pre-commit install",
    )

install = task(
    implementation = _install_impl,
    name = "install",
    group = ["dev"],
    summary = "Install controller OS prerequisites and optional repo-local tool shims.",
    args = {
        "install_shims": args.boolean(default = False, description = "Install repo-local shims for common developer tools."),
        "print_path": args.boolean(default = False, description = "Print the shim directory that should lead PATH for local development."),
        "bin_dir": args.string(default = ".verself/tools/dev/bin", description = "Directory for --install-shims output."),
    },
)

sops_init = task(
    implementation = _sops_init_impl,
    name = "sops-init",
    group = ["dev"],
    summary = "Bootstrap SOPS + Age encryption.",
)

hooks_install = task(
    implementation = _hooks_install_impl,
    name = "hooks-install",
    group = ["dev"],
    summary = "Install repo git hooks via pre-commit.",
)
