"""aspect tidy — mutate authored sources into the repo's canonical shape.

This is the one-stop local hygiene command. It runs ecosystem-native formatters
and metadata tidiers in a fixed order, then regenerates Bazel metadata.
"""

load(".aspect/lib/helpers.axl", "GO_DIRS", "bazel_tracked_files", "checked_spawn", "java_tracked_files", "ws_path")

def _viteplus(ctx):
    return checked_spawn(
        ctx,
        "vp",
        ["check", "--fix"],
        cwd = ws_path(ctx, "src/websites"),
        label = "vp check --fix",
    )

def _go(ctx):
    for d in GO_DIRS:
        rc = checked_spawn(
            ctx,
            "gofumpt",
            ["-w", "."],
            cwd = ws_path(ctx, d),
            label = "gofumpt -w (" + d + ")",
        )
        if rc != 0:
            return rc
        rc = checked_spawn(
            ctx,
            "go",
            ["mod", "tidy"],
            cwd = ws_path(ctx, d),
            label = "go mod tidy (" + d + ")",
        )
        if rc != 0:
            return rc
    return 0

def _java(ctx):
    files = java_tracked_files(ctx)
    if files == None:
        return 1
    if len(files) == 0:
        return 0
    return checked_spawn(
        ctx,
        "bazelisk",
        ["run", "--java_runtime_version=remotejdk_25", "//src/smithy/tools:google_java_format", "--", "--replace"] + files,
        cwd = ws_path(ctx),
        label = "google-java-format --replace",
    )

def _buildifier(ctx):
    files = bazel_tracked_files(ctx)
    if files == None:
        return 1
    return checked_spawn(
        ctx,
        "buildifier",
        ["-mode=fix", "-lint=fix"] + files,
        cwd = ws_path(ctx),
        label = "buildifier -mode=fix -lint=fix",
    )

def _gazelle(ctx):
    return checked_spawn(
        ctx,
        "bazelisk",
        [
            "run",
            "//:gazelle",
            "--",
            "update",
            "-go_naming_convention=import_alias",
            "-go_naming_convention_external=import_alias",
        ],
        cwd = ws_path(ctx),
        label = "bazelisk run //:gazelle -- update",
    )

def _bzlmod(ctx):
    return checked_spawn(
        ctx,
        "bazelisk",
        ["mod", "tidy", "--lockfile_mode=update"],
        cwd = ws_path(ctx),
        label = "bazelisk mod tidy",
    )

def _impl(ctx):
    # gazelle runs after buildifier so newly emitted BUILD files inherit
    # the canonical format on the same pass.
    for step in [_viteplus, _go, _java, _buildifier, _gazelle, _bzlmod]:
        rc = step(ctx)
        if rc != 0:
            return rc
    return 0

tidy = task(
    implementation = _impl,
    name = "tidy",
    summary = "Run repo-wide source formatting and metadata tidying.",
)
