"""aspect tidy — format authored sources into the repo's canonical shape.

This is the one-stop local formatting command. It runs ecosystem-native
formatters in a fixed order, then fails if tracked sources still differ from
the index. Bazel metadata updates live under `aspect bazel *`; semantic
verification gates live under `aspect check`.
"""

load(".aspect/lib/helpers.axl", "GO_DIRS", "bazel_tracked_files", "checked_spawn", "java_tracked_files", "ws_path")

def _viteplus(ctx):
    return checked_spawn(
        ctx,
        "vp",
        ["fmt", ".", "--write"],
        cwd = ws_path(ctx, "src/websites"),
        label = "vp fmt . --write",
    )

def _go(ctx):
    for d in GO_DIRS:
        rc = checked_spawn(
            ctx,
            "gofumpt",
            ["-w", "."],
            cwd = ws_path(ctx, d),
            label = "gofumpt -w (" + d + ")",
        )
        if rc != 0:
            return rc
    return 0

def _java(ctx):
    files = java_tracked_files(ctx)
    if files == None:
        return 1
    if len(files) == 0:
        return 0
    return checked_spawn(
        ctx,
        "bazelisk",
        ["run", "--java_runtime_version=remotejdk_25", "//src/smithy/tools:google_java_format", "--", "--replace"] + files,
        cwd = ws_path(ctx),
        label = "google-java-format --replace",
    )

def _buildifier(ctx):
    files = bazel_tracked_files(ctx)
    if files == None:
        return 1
    return checked_spawn(
        ctx,
        "buildifier",
        ["-mode=fix"] + files,
        cwd = ws_path(ctx),
        label = "buildifier -mode=fix",
    )

def _tracked_diff(ctx):
    rc = checked_spawn(
        ctx,
        "git",
        ["diff", "--exit-code"],
        cwd = ws_path(ctx),
        label = "git diff --exit-code",
    )
    if rc != 0:
        ctx.std.io.stderr.write("ERROR: aspect tidy left tracked source changes; review and stage the diff, then rerun.\n")
    return rc

def _impl(ctx):
    for step in [_viteplus, _go, _java, _buildifier, _tracked_diff]:
        rc = step(ctx)
        if rc != 0:
            return rc
    return 0

tidy = task(
    implementation = _impl,
    name = "tidy",
    summary = "Run repo-wide source formatters, then assert a clean tracked diff.",
)
