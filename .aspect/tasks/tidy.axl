"""aspect tidy — format authored sources into the repo's canonical shape.

This is the one-stop local formatting command. It runs ecosystem-native
formatters in a fixed order, then reports when tracked sources differ from the
index. Bazel metadata updates live under `aspect bazel *`; semantic
verification gates live under `aspect check`.
"""

load(".aspect/lib/helpers.axl", "GO_DIRS", "VITEPLUS_NODE_TARGET", "VITEPLUS_WORKSPACE_INSTALL_TARGET", "bazel_command", "bazel_tracked_files", "checked_spawn", "java_tracked_files", "viteplus_vp", "ws_path")

GOFUMPT_TARGET = "//src/tools/dev/binaries:gofumpt"
GOOGLE_JAVA_FORMAT_TARGET = "//src/smithy/tools:google_java_format"
BUILDIFIER_TARGET = "//src/tools/dev/binaries:buildifier"

def _tool_path(ctx, *parts):
    return ws_path(ctx, "bazel-bin", *parts)

def _build_toolchain(ctx):
    return bazel_command(
        ctx,
        [
            "build",
            VITEPLUS_NODE_TARGET,
            VITEPLUS_WORKSPACE_INSTALL_TARGET,
            GOFUMPT_TARGET,
            GOOGLE_JAVA_FORMAT_TARGET,
            BUILDIFIER_TARGET,
        ],
        cwd = ws_path(ctx),
        label = "guardian run bazel -- build tidy toolchain",
    )

def _viteplus(ctx):
    return viteplus_vp(ctx, ["fmt", ".", "--write"], ensure_toolchain = False)

def _go(ctx):
    dirs = []
    for d in GO_DIRS:
        dirs.append(ws_path(ctx, d))
    return checked_spawn(
        ctx,
        _tool_path(ctx, "src/tools/dev/binaries/gofumpt"),
        ["-w"] + dirs,
        label = "gofumpt -w",
    )

def _java(ctx):
    files = java_tracked_files(ctx)
    if files == None:
        return 1
    if len(files) == 0:
        return 0
    return checked_spawn(
        ctx,
        _tool_path(ctx, "src/smithy/tools/google_java_format"),
        ["--replace"] + files,
        cwd = ws_path(ctx),
        label = "google-java-format --replace",
    )

def _buildifier(ctx):
    files = bazel_tracked_files(ctx)
    if files == None:
        return 1
    abs_files = []
    for f in files:
        abs_files.append(ws_path(ctx, f))
    return checked_spawn(
        ctx,
        _tool_path(ctx, "src/tools/dev/binaries/buildifier"),
        ["-mode=fix"] + abs_files,
        label = "buildifier -mode=fix",
    )

def _git_capture(ctx, args, label):
    r = (ctx.std.process.command("git")
        .args(args)
        .current_dir(ws_path(ctx))
        .stdout("piped").stderr("piped")
        .spawn().wait_with_output())
    if r.status.code != 0:
        ctx.std.io.stderr.write("ERROR: " + label + " failed\n")
        if r.stderr != "":
            ctx.std.io.stderr.write(r.stderr)
        return None
    return r.stdout.strip()

def _has_tracked_diff(ctx):
    r = (ctx.std.process.command("git")
        .args(["diff", "--quiet", "--exit-code"])
        .current_dir(ws_path(ctx))
        .stderr("piped")
        .spawn().wait_with_output())
    if r.status.code == 0:
        return False
    if r.status.code == 1:
        return True
    ctx.std.io.stderr.write("ERROR: git diff --quiet --exit-code failed\n")
    if r.stderr != "":
        ctx.std.io.stderr.write(r.stderr)
    return None

def _tracked_diff_report(ctx):
    changed = _has_tracked_diff(ctx)
    if changed == None:
        return 1
    if not changed:
        return 0

    shortstat = _git_capture(ctx, ["diff", "--shortstat"], "git diff --shortstat")
    numstat = _git_capture(ctx, ["diff", "--numstat"], "git diff --numstat")
    status = _git_capture(ctx, ["status", "--short"], "git status --short")
    if shortstat == None or numstat == None or status == None:
        return 1

    ctx.std.io.stdout.write("\nINFO: aspect tidy completed with tracked source changes present.\n")
    if shortstat != "":
        ctx.std.io.stdout.write(shortstat + "\n")
    if numstat != "":
        ctx.std.io.stdout.write("\nAdded\tDeleted\tPath\n" + numstat + "\n")
    if status != "":
        ctx.std.io.stdout.write("\nGit status:\n" + status + "\n")
    ctx.std.io.stdout.write("\nReview the diff before committing.\n")
    return 0

def _impl(ctx):
    for step in [_build_toolchain, _viteplus, _go, _java, _buildifier, _tracked_diff_report]:
        rc = step(ctx)
        if rc != 0:
            return rc
    return 0

tidy = task(
    implementation = _impl,
    name = "tidy",
    summary = "Run repo-wide source formatters, then report tracked diff stats.",
)
