"""aspect release — release publication checks and helpers."""

load(".aspect/lib/helpers.axl", "ASPECT_OPERATOR_TARGET", "bazel_output_file", "bazel_run", "ws_path")

MKSK_RELEASE_TARGET = "//src/make-skill/release:mksk-release"
MKSK_RELEASE_TOOLS_TARGET = "//src/make-skill/release:release_tools_artifact"

def _workspace_or_absolute(ctx, path):
    if path.startswith("/"):
        return path
    return ws_path(ctx, path)

def _npm_probe_impl(ctx):
    cli_args = [
        "release",
        "npm-probe",
        "--package-json",
        _workspace_or_absolute(ctx, ctx.args.package_json),
        "--registry",
        ctx.args.registry,
        "--github-repository",
        ctx.args.github_repository,
        "--format",
        ctx.args.format,
    ]
    if ctx.args.require_publishable:
        cli_args.append("--require-publishable")
    return bazel_run(ctx, ASPECT_OPERATOR_TARGET, cli_args, label = "aspect-operator release npm-probe")

def _mksk_impl(ctx):
    tools_tar = bazel_output_file(ctx, MKSK_RELEASE_TOOLS_TARGET)
    if tools_tar == "":
        return 1
    cli_args = [
        "build",
        "--repo-root",
        ws_path(ctx),
        "--tools-tar",
        tools_tar,
        "--out-dir",
        _workspace_or_absolute(ctx, ctx.args.out_dir),
        "--source-ref",
        ctx.args.source_ref,
        "--channel",
        ctx.args.channel,
        "--version",
        ctx.args.version,
        "--builder-id",
        ctx.args.builder_id,
        "--platform",
        ctx.args.platform,
        "--flavor",
        ctx.args.flavor,
    ]
    if ctx.args.allow_dirty:
        cli_args.append("--allow-dirty")
    return bazel_run(ctx, MKSK_RELEASE_TARGET, cli_args, label = "mksk-release build")

npm_probe = task(
    implementation = _npm_probe_impl,
    name = "npm-probe",
    group = ["release"],
    summary = "Probe npm registry state for the TypeScript SDK release boundary.",
    args = {
        "package_json": args.string(default = "src/viteplus-monorepo/packages/sdk/package.json", description = "Package manifest to inspect."),
        "registry": args.string(default = "https://registry.npmjs.org", description = "npm registry base URL."),
        "github_repository": args.string(default = "guardian-intelligence/verself-sh", description = "GitHub owner/repo expected by npm trusted publishing."),
        "format": args.string(default = "table", description = "Output format: table | json | csv | tsv."),
        "require_publishable": args.boolean(default = False, description = "Fail when local manifest fields block publishing."),
    },
)

mksk = task(
    implementation = _mksk_impl,
    name = "mksk",
    group = ["release"],
    summary = "Build a package-owned make-skill release bundle.",
    args = {
        "channel": args.string(default = "", description = "Release channel: nightly, rc, or stable."),
        "version": args.string(default = "", description = "Release version. Required for build bundles."),
        "source_ref": args.string(default = "HEAD", description = "Git ref recorded as the source revision."),
        "out_dir": args.string(default = "artifacts/releases", description = "Directory for inspectable release outputs."),
        "builder_id": args.string(default = "spiffe://prod.verself.sh/svc/release-builder", description = "SLSA builder id recorded in local provenance."),
        "platform": args.string(default = "linux/amd64", description = "Release platform recorded in provenance."),
        "flavor": args.string(default = "default", description = "Opaque release flavor recorded in provenance."),
        "allow_dirty": args.boolean(default = False, description = "Allow building from a dirty local workspace for inspection."),
    },
)
