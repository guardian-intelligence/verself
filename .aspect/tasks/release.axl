"""aspect release — release publication checks and helpers."""

load(".aspect/lib/helpers.axl", "ASPECT_OPERATOR_TARGET", "bazel_output_file", "bazel_run", "ws_path")

MKSK_RELEASE_TARGET = "//src/make-skill/release:mksk-release"
MKSK_RELEASE_TOOLS_TARGET = "//src/make-skill/release:release_tools_artifact"

def _workspace_or_absolute(ctx, path):
    if path.startswith("/"):
        return path
    return ws_path(ctx, path)

def _npm_probe_impl(ctx):
    cli_args = [
        "release",
        "npm-probe",
        "--package-json",
        _workspace_or_absolute(ctx, ctx.args.package_json),
        "--registry",
        ctx.args.registry,
        "--github-repository",
        ctx.args.github_repository,
        "--format",
        ctx.args.format,
    ]
    if ctx.args.require_publishable:
        cli_args.append("--require-publishable")
    return bazel_run(ctx, ASPECT_OPERATOR_TARGET, cli_args, label = "aspect-operator release npm-probe")

def _mksk_impl(ctx):
    tools_tar = bazel_output_file(ctx, MKSK_RELEASE_TOOLS_TARGET)
    if tools_tar == "":
        return 1
    subcommand = "publish" if ctx.args.publish else "build"
    cli_args = [
        subcommand,
        "--repo-root",
        ws_path(ctx),
        "--tools-tar",
        tools_tar,
        "--out-dir",
        _workspace_or_absolute(ctx, ctx.args.out_dir),
        "--source-ref",
        ctx.args.source_ref,
        "--builder-id",
        ctx.args.builder_id,
        "--platform",
        ctx.args.platform,
        "--flavor",
        ctx.args.flavor,
    ]
    if ctx.args.nightly:
        cli_args.append("--nightly")
    if ctx.args.rc:
        cli_args.append("--rc")
    if ctx.args.stable:
        cli_args.append("--stable")
    if ctx.args.channel != "":
        cli_args.extend(["--channel", ctx.args.channel])
    if ctx.args.version != "":
        cli_args.extend(["--version", ctx.args.version])
    if ctx.args.source_commit != "":
        cli_args.extend(["--source-commit", ctx.args.source_commit])
    if ctx.args.from_rc != "":
        cli_args.extend(["--from-rc", ctx.args.from_rc])
    if ctx.args.allow_dirty:
        cli_args.append("--allow-dirty")
    if ctx.args.publish:
        cli_args.extend([
            "--registry",
            ctx.args.registry,
            "--public-registry",
            ctx.args.public_registry,
            "--repository",
            ctx.args.repository,
            "--registry-username",
            ctx.args.registry_username,
            "--registry-password-file",
            ctx.args.registry_password_file,
            "--signing",
            ctx.args.signing,
        ])
        if ctx.args.openbao_addr != "":
            cli_args.extend(["--openbao-addr", ctx.args.openbao_addr])
        if ctx.args.openbao_token_file != "":
            cli_args.extend(["--openbao-token-file", ctx.args.openbao_token_file])
        if ctx.args.openbao_transit_mount != "":
            cli_args.extend(["--openbao-transit-mount", ctx.args.openbao_transit_mount])
        if ctx.args.openbao_key != "":
            cli_args.extend(["--openbao-key", ctx.args.openbao_key])
        if ctx.args.openbao_namespace != "":
            cli_args.extend(["--openbao-namespace", ctx.args.openbao_namespace])
        if ctx.args.distribution_challenge != "":
            cli_args.extend(["--distribution-challenge", ctx.args.distribution_challenge])
        if ctx.args.tpm_release_public_name != "":
            cli_args.extend(["--tpm-release-public-name", ctx.args.tpm_release_public_name])
        if ctx.args.tpm_release_public_blob_digest != "":
            cli_args.extend(["--tpm-release-public-blob-digest", ctx.args.tpm_release_public_blob_digest])
    return bazel_run(ctx, MKSK_RELEASE_TARGET, cli_args, label = "mksk-release " + subcommand)

npm_probe = task(
    implementation = _npm_probe_impl,
    name = "npm-probe",
    group = ["release"],
    summary = "Probe npm registry state for the TypeScript SDK release boundary.",
    args = {
        "package_json": args.string(default = "src/viteplus-monorepo/packages/sdk/package.json", description = "Package manifest to inspect."),
        "registry": args.string(default = "https://registry.npmjs.org", description = "npm registry base URL."),
        "github_repository": args.string(default = "guardian-intelligence/verself-sh", description = "GitHub owner/repo expected by npm trusted publishing."),
        "format": args.string(default = "table", description = "Output format: table | json | csv | tsv."),
        "require_publishable": args.boolean(default = False, description = "Fail when local manifest fields block publishing."),
    },
)

mksk = task(
    implementation = _mksk_impl,
    name = "mksk",
    group = ["release"],
    summary = "Build a package-owned make-skill release bundle.",
    args = {
        "nightly": args.boolean(default = False, description = "Derive the next nightly version from source_ref."),
        "rc": args.boolean(default = False, description = "Derive the next RC version from source_ref."),
        "stable": args.boolean(default = False, description = "Derive a stable version from source_ref or from_rc."),
        "publish": args.boolean(default = False, description = "Run the publish subcommand instead of the local build subcommand."),
        "channel": args.string(default = "", description = "Exact release channel: nightly, rc, or stable."),
        "version": args.string(default = "", description = "Exact release version."),
        "source_ref": args.string(default = "HEAD", description = "Git ref recorded as the source revision."),
        "source_commit": args.string(default = "", description = "Resolved source commit for exact release subjects."),
        "from_rc": args.string(default = "", description = "RC tag to rebuild as a stable release, e.g. mksk-v0.2.0-rc.2."),
        "out_dir": args.string(default = "artifacts/releases", description = "Directory for inspectable release outputs."),
        "builder_id": args.string(default = "spiffe://prod.verself.sh/svc/release-builder", description = "SLSA builder id recorded in local provenance."),
        "platform": args.string(default = "linux/amd64", description = "Release platform recorded in provenance."),
        "flavor": args.string(default = "default", description = "Opaque release flavor recorded in provenance."),
        "allow_dirty": args.boolean(default = False, description = "Allow building from a dirty local workspace for inspection."),
        "registry": args.string(default = "http://127.0.0.1:5080", description = "Origin OCI registry used by --publish."),
        "public_registry": args.string(default = "https://oci.verself.sh", description = "Public OCI registry URL reported by --publish."),
        "repository": args.string(default = "verself/mksk", description = "OCI repository used by --publish."),
        "registry_username": args.string(default = "artifact-publisher", description = "OCI registry publisher user used by --publish."),
        "registry_password_file": args.string(default = "/etc/zot/publisher-password", description = "OCI registry publisher password file used by --publish."),
        "signing": args.string(default = "disabled", description = "Signing mode used by --publish: disabled | openbao-transit."),
        "openbao_addr": args.string(default = "", description = "OpenBao base URL used by --signing=openbao-transit."),
        "openbao_token_file": args.string(default = "", description = "OpenBao token file used by --signing=openbao-transit."),
        "openbao_transit_mount": args.string(default = "transit", description = "OpenBao Transit mount used by --signing=openbao-transit."),
        "openbao_key": args.string(default = "", description = "OpenBao Transit key used by --signing=openbao-transit."),
        "openbao_namespace": args.string(default = "", description = "OpenBao namespace header used by --signing=openbao-transit."),
        "distribution_challenge": args.string(default = "", description = "One-use distribution-service challenge bound into the release input digest."),
        "tpm_release_public_name": args.string(default = "", description = "TPM Name for the ephemeral release signing key."),
        "tpm_release_public_blob_digest": args.string(default = "", description = "sha256 digest of the TPM release public blob."),
    },
)
