"""aspect release — release publication checks and helpers."""

load(".aspect/lib/helpers.axl", "ASPECT_OPERATOR_TARGET", "bazel_output_file", "bazel_run", "resolve_sha", "ws_path")

DISTRIBUTION_RELEASE_TARGET = "//src/services/distribution-service/cmd/distribution-release:distribution-release"
DISTRIBUTION_RELEASE_TOOLS_TARGET = "//src/services/distribution-service:release_tools_artifact"

def _workspace_or_absolute(ctx, path):
    if path.startswith("/"):
        return path
    return ws_path(ctx, path)

def _npm_probe_impl(ctx):
    cli_args = [
        "release",
        "npm-probe",
        "--package-json",
        _workspace_or_absolute(ctx, ctx.args.package_json),
        "--registry",
        ctx.args.registry,
        "--github-repository",
        ctx.args.github_repository,
        "--format",
        ctx.args.format,
    ]
    if ctx.args.require_publishable:
        cli_args.append("--require-publishable")
    return bazel_run(ctx, ASPECT_OPERATOR_TARGET, cli_args, label = "aspect-operator release npm-probe")

def _mksk_impl(ctx):
    if not ctx.args.version_pr and not ctx.args.local:
        source_commit = resolve_sha(ctx, ctx.args.source_ref)
        if source_commit == "":
            return 1
        cli_args = [
            "release",
            "mksk",
            "--site",
            ctx.args.site,
            "--repo-root",
            ws_path(ctx),
            "--channel",
            ctx.args.channel,
            "--source-ref",
            ctx.args.source_ref,
            "--source-commit",
            source_commit,
        ]
        if ctx.args.version != "":
            cli_args.extend(["--version", ctx.args.version])
        return bazel_run(ctx, ASPECT_OPERATOR_TARGET, cli_args, label = "aspect-operator release mksk")

    tools_tar = bazel_output_file(ctx, DISTRIBUTION_RELEASE_TOOLS_TARGET)
    if tools_tar == "":
        return 1
    cli_args = [
        "mksk",
        "--repo-root",
        ws_path(ctx),
        "--tools-tar",
        tools_tar,
        "--out-dir",
        _workspace_or_absolute(ctx, ctx.args.out_dir),
        "--source-ref",
        ctx.args.source_ref,
        "--builder-id",
        ctx.args.builder_id,
        "--platform",
        ctx.args.platform,
    ]
    if ctx.args.version_pr:
        cli_args.append("--version-pr")
    if ctx.args.channel != "":
        cli_args.extend(["--channel", ctx.args.channel])
    if ctx.args.version != "":
        cli_args.extend(["--version", ctx.args.version])
    return bazel_run(ctx, DISTRIBUTION_RELEASE_TARGET, cli_args, label = "distribution-release mksk")

npm_probe = task(
    implementation = _npm_probe_impl,
    name = "npm-probe",
    group = ["release"],
    summary = "Probe npm registry state for the TypeScript SDK release boundary.",
    args = {
        "package_json": args.string(default = "src/viteplus-monorepo/packages/sdk/package.json", description = "Package manifest to inspect."),
        "registry": args.string(default = "https://registry.npmjs.org", description = "npm registry base URL."),
        "github_repository": args.string(default = "guardian-intelligence/verself-sh", description = "GitHub owner/repo expected by npm trusted publishing."),
        "format": args.string(default = "table", description = "Output format: table | json | csv | tsv."),
        "require_publishable": args.boolean(default = False, description = "Fail when local manifest fields block publishing."),
    },
)

mksk = task(
    implementation = _mksk_impl,
    name = "mksk",
    group = ["release"],
    summary = "Dispatch or locally inspect a make-skill release.",
    args = {
        "version_pr": args.boolean(default = False, description = "Generate an inspectable release-plz version PR patch."),
        "local": args.boolean(default = False, description = "Build locally and emit inspection artifacts under --out-dir instead of dispatching production release workflow."),
        "channel": args.string(default = "", description = "Release channel: nightly, rc, or stable."),
        "version": args.string(default = "", description = "Explicit version. Required for rc/stable; optional for nightly."),
        "source_ref": args.string(default = "HEAD", description = "Git ref recorded as the source revision."),
        "site": args.string(default = "prod", description = "Deployment site for production release dispatch."),
        "out_dir": args.string(default = "artifacts/releases", description = "Directory for inspectable release outputs."),
        "builder_id": args.string(default = "spiffe://prod.verself.sh/svc/distribution-service", description = "SLSA builder id recorded in local provenance."),
        "platform": args.string(default = "linux/amd64", description = "Release platform recorded in provenance."),
    },
)
