"""aspect vp — the controller entry point for Vite+.

This bypasses any shell `vp` and runs the lockfile-pinned
`node_modules/vite-plus` under the Bazel-resolved host Node, against the
`src/websites` source tree. It is the exact toolchain the Bazel frontend build
uses for controller-side checks. For local app development, cd into the app
package and run `vp dev`.

Pass the `vp` argv after `--`:

    aspect vp -- fmt . --write
    aspect vp -- check .
    aspect vp -- install --frozen-lockfile
"""

load(".aspect/lib/helpers.axl", "viteplus_vp")

def _vp_impl(ctx):
    # `minimum = 1` on the positional guarantees a non-empty argv.
    return viteplus_vp(ctx, list(ctx.args.argv))

vp = task(
    implementation = _vp_impl,
    name = "vp",
    summary = "Run the lockfile-pinned Vite+ toolchain: aspect vp -- <vp args>.",
    args = {
        "argv": args.positional(
            minimum = 1,
            maximum = 256,
            description = "Vite+ argv, passed verbatim (e.g. `-- check .`).",
        ),
    },
)
