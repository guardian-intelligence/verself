"""aspect host edit-secrets | firewall | operator-access-handoff

Bootstrap convergence and Nomad deployments do not own the operator-access
handoff. Pomerium is a manual host action because a bad change can move SSH
listeners and lock operators out.
"""

load(
    ".aspect/lib/helpers.axl",
    "DEFAULT_SITE",
    "HOST_CONFIGURATION_DIR",
    "SOPS_SHIM",
    "bazel_run",
    "checked_spawn",
    "host_ansible_env",
    "host_ansible_playbook",
    "inventory_check",
    "ws_path",
)

def _edit_secrets_impl(ctx):
    return bazel_run(
        ctx,
        "//src/tools/dev/binaries:sops",
        [ws_path(ctx, HOST_CONFIGURATION_DIR, "sites/prod/secrets/host.sops.yml")],
        label = "sops edit host secrets",
    )

edit_secrets = task(
    implementation = _edit_secrets_impl,
    name = "edit-secrets",
    group = ["host"],
    summary = "Open encrypted host configuration secrets in $EDITOR via sops.",
)

def _host_playbook(ctx, site, playbook, extra_vars = None):
    rc = inventory_check(ctx, site)
    if rc != 0:
        return rc
    ansible_playbook = host_ansible_playbook(ctx)
    if ansible_playbook == "":
        return 1
    env = host_ansible_env(ctx, tool_shims = [SOPS_SHIM])
    if env == None:
        return 1
    ansible_dir = ws_path(ctx, HOST_CONFIGURATION_DIR, "ansible")
    playbook_args = [
        "-i",
        ws_path(ctx, HOST_CONFIGURATION_DIR, "sites/" + site + "/inventory.ini"),
        "playbooks/" + playbook,
        "-e",
        "verself_site=" + site,
    ]
    if extra_vars != None:
        for key, value in extra_vars.items():
            playbook_args.extend(["-e", key + "=" + value])
    return checked_spawn(
        ctx,
        ansible_playbook,
        playbook_args,
        cwd = ansible_dir,
        env = env,
        label = "ansible-playbook " + playbook + " --site " + site,
    )

def _firewall_impl(ctx):
    site = ctx.args.site or DEFAULT_SITE
    rc = checked_spawn(
        ctx,
        "bazelisk",
        ["build", "//src/host:nftables_sources"],
        cwd = ws_path(ctx),
        label = "bazelisk build //src/host:nftables_sources",
    )
    if rc != 0:
        return rc
    return _host_playbook(
        ctx,
        site,
        "nftables.yml",
        extra_vars = {
            "component_substrate_registry_file": ws_path(ctx, "bazel-bin/src/host/component_substrate_registry.component_substrate_registry.json"),
            "verself_repo_root": ws_path(ctx),
        },
    )

firewall = task(
    implementation = _firewall_impl,
    name = "firewall",
    group = ["host"],
    summary = "Converge host and owner-local nftables rulesets.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
    },
)

def _operator_access_handoff_impl(ctx):
    if not ctx.args.confirm:
        ctx.std.io.stderr.write("ERROR: pass --confirm to run the Pomerium operator-access handoff\n")
        return 1
    site = ctx.args.site or "prod"
    ansible_playbook = host_ansible_playbook(ctx)
    if ansible_playbook == "":
        return 1
    env = host_ansible_env(ctx, tool_shims = [SOPS_SHIM])
    if env == None:
        return 1
    ansible_dir = ws_path(ctx, HOST_CONFIGURATION_DIR, "ansible")
    return checked_spawn(
        ctx,
        ansible_playbook,
        [
            "-i",
            ws_path(ctx, HOST_CONFIGURATION_DIR, "sites/" + site + "/inventory.ini"),
            "playbooks/operator-access-handoff.yml",
            "-e",
            "verself_site=" + site,
        ],
        cwd = ansible_dir,
        env = env,
        label = "ansible-playbook operator-access-handoff --site " + site,
    )

operator_access_handoff = task(
    implementation = _operator_access_handoff_impl,
    name = "operator-access-handoff",
    group = ["host"],
    summary = "Manually hand public SSH :22 to Pomerium and keep direct recovery on :2222.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "confirm": args.boolean(default = False, description = "Required confirmation for SSH listener handoff."),
    },
)
