"""aspect deploy [--site=prod] [--sha=<rev>]

The single deploy verb. Resolves --sha (falling back to a temporary
worktree when non-HEAD) and shells out to `verself-deploy run`.
Environment seeding is an explicit operator task, not part of deploy.
The binary owns identity derivation, Bazel nomad_component discovery,
artifact publication, and affected Nomad fan-out
inside one process sharing one SSH session and one SSH-forwarded OTLP channel
to the bare-metal otelcol.

Correlation: verself_deploy.* span families in default.otel_traces join on
ResourceAttributes['verself.deploy_run_key']. ClickHouse persistence is an
observability concern, not a deploy-runner correctness dependency.
"""

load(
    ".aspect/lib/helpers.axl",
    "build_verself_deploy",
    "checked_spawn",
    "git_dirty",
    "git_head",
    "resolve_sha",
    "site_inventory_source",
    "ws_path",
)

def _deploy_one(ctx, site, sha):
    deploy_args = [
        "run",
        "--site=" + site,
        "--sha=" + sha,
        "--repo-root=" + ws_path(ctx),
    ]
    bin = build_verself_deploy(ctx)
    if bin == "":
        return 1
    deploy_rc = checked_spawn(
        ctx,
        bin,
        deploy_args,
        cwd = ws_path(ctx),
        label = "verself-deploy run --site=" + site,
    )
    if deploy_rc != 0:
        return deploy_rc
    return 0

def _make_tree_removable(ctx, path):
    r = (ctx.std.process.command("test")
        .args(["-e", path])
        .spawn().wait())
    if r.code != 0:
        return
    _ = checked_spawn(ctx, "find", [path, "-type", "d", "-exec", "chmod", "u+w", "{}", "+"], label = "make " + path + " directories removable")
    _ = checked_spawn(ctx, "find", [path, "-type", "f", "-exec", "chmod", "u+w", "{}", "+"], label = "make " + path + " files removable")

def _remove_worktree(ctx, wt):
    # Bazel/frontend generators can leave read-only files that block worktree removal.
    _make_tree_removable(ctx, wt)
    return checked_spawn(ctx, "git", ["worktree", "remove", "--force", wt], label = "git worktree remove " + wt)

def _deploy_in_worktree(ctx, site, sha):
    """Add a temporary worktree at <sha>, exec `aspect deploy` from inside,
    and clean up. Inside the worktree HEAD == sha, so the inner invocation
    falls through to the in-tree path with no further branching."""
    wt = "/tmp/verself-deploy-" + sha[:12]
    _make_tree_removable(ctx, wt)
    _ = checked_spawn(ctx, "rm", ["-rf", wt], label = "clean " + wt)
    rc = checked_spawn(
        ctx,
        "git",
        ["worktree", "add", "--detach", wt, sha],
        label = "git worktree add " + wt,
    )
    if rc != 0:
        return rc
    inv_rel = site_inventory_source(site)
    inv_abs = ws_path(ctx, inv_rel)
    rc = checked_spawn(ctx, "test", ["-f", inv_abs], label = "test -f " + inv_rel)
    if rc != 0:
        ctx.std.io.stderr.write("ERROR: " + inv_rel + " not found. Run: aspect provision apply\n")
        _ = _remove_worktree(ctx, wt)
        return 1
    rc = checked_spawn(ctx, "mkdir", ["-p", wt + "/src/host/sites/" + site], label = "mkdir worktree inventory dir")
    if rc != 0:
        _ = _remove_worktree(ctx, wt)
        return rc
    rc = checked_spawn(ctx, "cp", [inv_abs, wt + "/" + inv_rel], label = "copy " + inv_rel + " into deploy worktree")
    if rc != 0:
        _ = _remove_worktree(ctx, wt)
        return rc
    target = "//src/tools/deployment/cmd/verself-deploy:verself-deploy"
    rc = checked_spawn(
        ctx,
        "bazelisk",
        ["build", target],
        cwd = wt,
        label = "bazelisk build " + target + " (worktree " + sha[:12] + ")",
    )
    if rc != 0:
        _ = _remove_worktree(ctx, wt)
        return rc
    bin = wt + "/bazel-bin/src/tools/deployment/cmd/verself-deploy/verself-deploy_/verself-deploy"
    deploy_args = [
        "run",
        "--site=" + site,
        "--sha=" + sha,
        "--repo-root=" + wt,
    ]
    deploy_rc = checked_spawn(
        ctx,
        bin,
        deploy_args,
        cwd = wt,
        label = "verself-deploy run --site=" + site + " (worktree " + sha[:12] + ")",
    )
    _ = _remove_worktree(ctx, wt)
    return deploy_rc

def _deploy_impl(ctx):
    site = ctx.args.site or "prod"
    sha = resolve_sha(ctx, ctx.args.sha or "")
    if sha == "":
        return 1
    head = git_head(ctx)
    if sha != head or git_dirty(ctx):
        return _deploy_in_worktree(ctx, site, sha)
    return _deploy_one(ctx, site, sha)

deploy = task(
    implementation = _deploy_impl,
    name = "deploy",
    summary = "Run verself-deploy end-to-end from authored inputs.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "sha": args.string(default = "", description = "Git SHA or symbolic ref to deploy (e.g. HEAD~1, prod-tip). Defaults to HEAD."),
    },
)
