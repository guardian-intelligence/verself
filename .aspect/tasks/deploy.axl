"""aspect deploy [--site=prod] [--sha=<rev>|--deployment-id=<id>]

Thin deployment-service client. Resolves --sha, verifies the workspace when
deploying HEAD, submits deployment requests, and fetches deployment state from
the selected site.
"""

load(
    ".aspect/lib/helpers.axl",
    "VERSELF_DEPLOY_TARGET",
    "bazel_run",
    "checked_spawn",
    "git_dirty",
    "git_head",
    "resolve_sha",
    "ws_path",
)

def _deploy_one(ctx, site, sha):
    deploy_args = [
        "run",
        "--site=" + site,
        "--sha=" + sha,
        "--repo-root=" + ws_path(ctx),
    ]
    deploy_rc = bazel_run(
        ctx,
        VERSELF_DEPLOY_TARGET,
        deploy_args,
        cwd = ws_path(ctx),
        label = "verself-deploy run --site=" + site,
    )
    if deploy_rc != 0:
        return deploy_rc
    return 0

def _deploy_status(ctx, site, deployment_id):
    deploy_args = [
        "status",
        "--site=" + site,
        "--deployment-id=" + deployment_id,
        "--repo-root=" + ws_path(ctx),
    ]
    if ctx.args.events:
        deploy_args.append("--events")
    return bazel_run(
        ctx,
        VERSELF_DEPLOY_TARGET,
        deploy_args,
        cwd = ws_path(ctx),
        label = "verself-deploy status --site=" + site,
    )

def _deploy_check(ctx, site):
    deploy_args = [
        "check",
        "--site=" + site,
        "--repo-root=" + ws_path(ctx),
    ]
    return bazel_run(
        ctx,
        VERSELF_DEPLOY_TARGET,
        deploy_args,
        cwd = ws_path(ctx),
        label = "verself-deploy check --site=" + site,
    )

def _deploy_impl(ctx):
    site = ctx.args.site or "prod"
    deployment_id = ctx.args.deployment_id
    if ctx.args.check:
        if deployment_id != "" or ctx.args.sha != "" or ctx.args.events:
            ctx.std.io.stderr.write("ERROR: --check cannot be combined with --deployment-id, --sha, or --events.\n")
            return 1
        return _deploy_check(ctx, site)
    if deployment_id != "":
        if ctx.args.sha != "":
            ctx.std.io.stderr.write("ERROR: --deployment-id and --sha are mutually exclusive.\n")
            return 1
        return _deploy_status(ctx, site, deployment_id)
    if ctx.args.events:
        ctx.std.io.stderr.write("ERROR: --events requires --deployment-id.\n")
        return 1
    sha = resolve_sha(ctx, ctx.args.sha or "")
    if sha == "":
        return 1
    head = git_head(ctx)
    if sha == head and git_dirty(ctx):
        ctx.std.io.stderr.write(
            "ERROR: workspace has uncommitted changes; aspect deploy deploys committed Git SHAs only.\n" +
            "Commit the changes, clean the worktree, or pass --sha=<committed-ref> for a different clean revision.\n",
        )
        checked_spawn(ctx, "git", ["status", "--short"], label = "git status --short")
        return 1
    return _deploy_one(ctx, site, sha)

deploy = task(
    implementation = _deploy_impl,
    name = "deploy",
    summary = "Submit a deployment request or fetch deployment state from the site deployment-service.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "sha": args.string(default = "", description = "Git SHA or symbolic ref to deploy (e.g. HEAD~1, prod-tip). Defaults to HEAD."),
        "deployment_id": args.string(default = "", description = "Fetch deployment state instead of submitting a new deployment."),
        "events": args.boolean(default = False, description = "Include the deployment event ledger when --deployment-id is set."),
        "check": args.boolean(default = False, description = "Run the read-only deployment-service S0-S7 readiness check without submitting a deployment."),
    },
)
