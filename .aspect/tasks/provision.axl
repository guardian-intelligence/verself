"""aspect provision apply|destroy — bare-metal lifecycle via OpenTofu."""

load(
    ".aspect/lib/helpers.axl",
    "DEFAULT_SITE",
    "PROVISION_DIR",
    "SOPS_SHIM",
    "checked_spawn",
    "host_ansible_env",
    "host_ansible_playbook",
    "install_bazel_tool_shims",
    "ws_path",
)

def _ansible_local(ctx, playbook, site, *extra_args):
    ansible_playbook = host_ansible_playbook(ctx)
    if ansible_playbook == "":
        return 1
    tool_dir = install_bazel_tool_shims(
        ctx,
        [
            SOPS_SHIM,
            ("tofu", "//src/tools/dev/binaries:tofu"),
        ],
        ".verself/tools/provision/bin",
    )
    if tool_dir == "":
        return 1
    env = host_ansible_env(
        ctx,
        tool_shims = [],
        extra_env = {
            "SOPS_BIN": tool_dir + "/sops",
            "TOFU_BIN": tool_dir + "/tofu",
            "VERSELF_SITE": site,
        },
    )
    if env == None:
        return 1
    args_list = [playbook] + list(extra_args)
    return checked_spawn(
        ctx,
        ansible_playbook,
        args_list,
        cwd = ws_path(ctx, PROVISION_DIR, "ansible"),
        env = env,
        label = "ansible-playbook " + " ".join(args_list),
    )

def _apply_impl(ctx):
    return _ansible_local(ctx, "playbooks/provision.yml", ctx.args.site or DEFAULT_SITE)

def _destroy_impl(ctx):
    if not ctx.args.confirm:
        ctx.std.io.stderr.write("ERROR: --confirm is required to destroy provisioned infrastructure\n")
        return 1
    site = ctx.args.site or DEFAULT_SITE
    return _ansible_local(ctx, "playbooks/deprovision.yml", site, "-e", "verself_site=" + site)

apply = task(
    implementation = _apply_impl,
    name = "apply",
    group = ["provision"],
    summary = "Provision bare metal through OpenTofu and write host inventory.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
    },
)

destroy = task(
    implementation = _destroy_impl,
    name = "destroy",
    group = ["provision"],
    summary = "Destroy OpenTofu-managed bare metal and remove host inventory.",
    args = {
        "site": args.string(default = "prod", description = "Deployment site."),
        "confirm": args.boolean(default = False, description = "Required gate; pass --confirm to proceed."),
    },
)
