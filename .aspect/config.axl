"""Verself Aspect CLI workspace config.

`def config(ctx)` is the single registration point Aspect calls when it loads
the workspace. Every task lives under `.aspect/tasks/` (subdirectories are NOT
auto-discovered) and is registered explicitly here. Helpers live under
`.aspect/lib/` and are imported via `load(".aspect/lib/<file>", ...)`.

This file is the source of truth for the durable command surface. The retired
surface (smoke aliases, persona/mail-recipient shortcuts, Bazel-build aliases)
is enforced by absence: do not reintroduce shortcut tasks for things
`aspect <group> <action> --flag=value` already covers.
"""

load(
    ".aspect/tasks/actions.axl",
    actions_publish = "publish",
)
load(
    ".aspect/tasks/bazel.axl",
    bazel_bzlmod = "bzlmod",
    bazel_gazelle = "gazelle",
    bazel_update = "update",
)
load(
    ".aspect/tasks/billing.axl",
    billing_clock = "clock",
    billing_documents = "documents",
    billing_events = "events",
    billing_finalizations = "finalizations",
    billing_seed = "seed",
    billing_state = "state",
)
load(
    ".aspect/tasks/canary.axl",
    canary_service_discovery = "service_discovery",
)
load(".aspect/tasks/check.axl", "check")
load(
    ".aspect/tasks/db.axl",
    db_ch_query = "ch_query",
    db_ch_schemas = "ch_schemas",
    db_pg_list = "pg_list",
    db_pg_query = "pg_query",
    db_pg_shell = "pg_shell",
    db_tb_lookup_account = "tb_lookup_account",
    db_tb_query_accounts = "tb_query_accounts",
    db_tb_shell = "tb_shell",
)
load(".aspect/tasks/deploy.axl", "deploy")
load(".aspect/tasks/detect_intrusions.axl", "detect_intrusions")
load(
    ".aspect/tasks/dev.axl",
    dev_hooks_install = "hooks_install",
    dev_install = "install",
)
load(
    ".aspect/tasks/host_configuration.axl",
    host_configuration_operator_access_handoff = "operator_access_handoff",
)
load(
    ".aspect/tasks/integrations.axl",
    integrations_cloudflare_control_plane = "cloudflare_control_plane",
    integrations_stripe_projects = "stripe_projects",
)
load(
    ".aspect/tasks/mail.axl",
    mail_addresses = "addresses",
    mail_send = "send",
    mail_test_accounts_delete = "test_accounts_delete",
    mail_test_accounts_ensure = "test_accounts_ensure",
    mail_test_accounts_list = "test_accounts_list",
)
load(".aspect/tasks/observe.axl", "observe")
load(
    ".aspect/tasks/operator.axl",
    operator_device = "device",
    operator_promote_org = "promote_org",
)
load(
    ".aspect/tasks/persona.axl",
    persona_assume = "assume",
    persona_user_state = "user_state",
)
load(
    ".aspect/tasks/release.axl",
    release_mksk = "mksk",
    release_npm_probe = "npm_probe",
)
load(
    ".aspect/tasks/site.axl",
    bootstrap_deploy = "bootstrap_deploy",
    site_converge_host = "converge_host",
    site_inventory_write = "inventory_write",
    site_root_handoff = "root_handoff",
)
load(".aspect/tasks/tidy.axl", "tidy")
load(".aspect/tasks/vp.axl", "vp")

def config(ctx):
    # Top-level tasks.
    ctx.tasks.add(deploy)
    ctx.tasks.add(bootstrap_deploy)
    ctx.tasks.add(observe)
    ctx.tasks.add(check)
    ctx.tasks.add(tidy)
    ctx.tasks.add(vp)

    # aspect actions ...
    ctx.tasks.add(actions_publish)

    # aspect bazel ...
    ctx.tasks.add(bazel_bzlmod)
    ctx.tasks.add(bazel_gazelle)
    ctx.tasks.add(bazel_update)

    # aspect release ...
    ctx.tasks.add(release_mksk)
    ctx.tasks.add(release_npm_probe)

    # aspect host ...
    ctx.tasks.add(host_configuration_operator_access_handoff)

    # aspect site ...
    ctx.tasks.add(site_inventory_write)
    ctx.tasks.add(site_root_handoff)
    ctx.tasks.add(site_converge_host)

    # aspect integrations ...
    ctx.tasks.add(integrations_cloudflare_control_plane)
    ctx.tasks.add(integrations_stripe_projects)

    # aspect db pg|ch|tb ...
    ctx.tasks.add(db_pg_list)
    ctx.tasks.add(db_pg_shell)
    ctx.tasks.add(db_pg_query)
    ctx.tasks.add(db_ch_query)
    ctx.tasks.add(db_ch_schemas)
    ctx.tasks.add(db_tb_shell)
    ctx.tasks.add(db_tb_query_accounts)
    ctx.tasks.add(db_tb_lookup_account)

    # aspect dev ...
    ctx.tasks.add(dev_install)
    ctx.tasks.add(dev_hooks_install)

    # aspect persona ...
    ctx.tasks.add(persona_assume)
    ctx.tasks.add(persona_user_state)

    # aspect billing ...
    ctx.tasks.add(billing_seed)
    ctx.tasks.add(billing_clock)
    ctx.tasks.add(billing_state)
    ctx.tasks.add(billing_documents)
    ctx.tasks.add(billing_finalizations)
    ctx.tasks.add(billing_events)

    # aspect operator ...
    ctx.tasks.add(operator_device)
    ctx.tasks.add(operator_promote_org)

    # aspect detect-intrusions
    ctx.tasks.add(detect_intrusions)

    # aspect mail ...
    ctx.tasks.add(mail_addresses)
    ctx.tasks.add(mail_send)
    ctx.tasks.add(mail_test_accounts_ensure)
    ctx.tasks.add(mail_test_accounts_list)
    ctx.tasks.add(mail_test_accounts_delete)

    # aspect canary ...
    ctx.tasks.add(canary_service_discovery)
