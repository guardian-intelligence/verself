{
  "artifact_delivery": {
    "kind": "cloudflare_r2_s3",
    "bucket": "nomad-artifacts-dev",
    "key_prefix": "sha256",
    "cloudflare_account_id_env": "VERSELF_CLOUDFLARE_ACCOUNT_ID",
    "getter_options": {
      "region": "auto"
    },
    "getter_credentials": {
      "source": "host_environment",
      "environment_file": "/etc/nomad/nomad-artifacts.env",
      "access_key_id_env": "AWS_ACCESS_KEY_ID",
      "secret_access_key_env": "AWS_SECRET_ACCESS_KEY"
    },
    "publisher_credentials": {
      "source": "controller_environment",
      "access_key_id_env": "VERSELF_NOMAD_ARTIFACTS_R2_ACCESS_KEY_ID",
      "secret_access_key_env": "VERSELF_NOMAD_ARTIFACTS_R2_SECRET_ACCESS_KEY"
    },
    "checksum_algorithm": "sha256",
    "public": false
  },
  "nomad_addr": "http://127.0.0.1:4646"
}
