package(default_visibility = ["//visibility:public"])

exports_files(["host_tools.MODULE.bazel"])

genrule(
    name = "bazelisk_bin",
    srcs = ["@host_tool_bazelisk//file"],
    outs = ["bazelisk"],
    cmd = "install -m 0755 $(location @host_tool_bazelisk//file) $@",
)

genrule(
    name = "nomad_bin",
    srcs = ["@host_tool_nomad//file"],
    outs = ["nomad"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
unzip -q "$(location @host_tool_nomad//file)" -d "$$tmp"
install -m 0755 "$$tmp/nomad" "$@"
""",
)

genrule(
    name = "spire_server_bin",
    srcs = ["@host_tool_spire//file"],
    outs = ["spire-server"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
tar -xzf "$(location @host_tool_spire//file)" -C "$$tmp" --strip-components=1
install -m 0755 "$$tmp/bin/spire-server" "$@"
""",
)

genrule(
    name = "spire_agent_bin",
    srcs = ["@host_tool_spire//file"],
    outs = ["spire-agent"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
tar -xzf "$(location @host_tool_spire//file)" -C "$$tmp" --strip-components=1
install -m 0755 "$$tmp/bin/spire-agent" "$@"
""",
)

pkg_tar(
