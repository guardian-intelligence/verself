{
  "version": "1.0",
  "sources": [
    "common.smithy",
    "iam.smithy"
  ],
  "projections": {
    "source": {},
    "iam-public": {
      "plugins": {
        "verself-ir": {
          "service": "verself.iam.v1#Iam",
          "package": "verself",
          "visibility": "public",
          "filename": "ir/verself/iam-public.json"
        }
      }
    },
    "iam-internal": {
      "plugins": {
        "verself-ir": {
          "service": "verself.iam.v1#IamInternal",
          "package": "verself",
          "visibility": "internal",
          "filename": "ir/verself/iam-internal.json"
        }
      }
    }
  }
}
