load("//src/smithy/build:smithy.bzl", "smithy_build", "smithy_validate")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "smithy_sources",
    srcs = glob(["*.smithy"]),
)

filegroup(
    name = "smithy_config",
    srcs = ["smithy-build.json"],
)

filegroup(
    name = "docs",
    srcs = ["README.md"],
)

smithy_validate(
    name = "smithy_validate",
    srcs = [":smithy_sources"],
    out = "smithy.validate.ok",
    config = ":smithy_config",
    plugins = [
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
        "//src/smithy/validators:verself_smithy_validators",
    ],
)

smithy_build(
    name = "smithy_build",
    srcs = [":smithy_sources"],
    out = "smithy-build.tar",
    config = ":smithy_config",
    plugins = [
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
        "//src/smithy/validators:verself_smithy_validators",
    ],
)

genrule(
    name = "iam_public_ir",
    srcs = [":smithy_build"],
    outs = ["iam-public.ir.json"],
    cmd = """
set -euo pipefail
tar -xOf "$(location :smithy_build)" ./iam-public/verself-ir/ir/verself/iam-public.json > "$@"
""",
)

genrule(
    name = "iam_audit_catalog",
    srcs = [":iam_public_ir"],
    outs = ["iam-audit.catalog.json"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode catalog-json \
  -catalog audit \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go"],
)

genrule(
    name = "iam_observability_catalog",
    srcs = [":iam_public_ir"],
    outs = ["iam-observability.catalog.json"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode catalog-json \
  -catalog observability \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go"],
)

genrule(
    name = "iam_conformance_fixtures",
    srcs = [":iam_public_ir"],
    outs = ["iam-conformance.fixtures.json"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode conformance-json \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go"],
)

genrule(
    name = "iam_proto_projection",
    srcs = [":iam_public_ir"],
    outs = ["iam.proto"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode proto \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go"],
)
