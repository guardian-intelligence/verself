load("//src/smithy/build:ir_go.bzl", "ir_catalog_json", "ir_proto_projection", "smithy_projection_file")
load("//src/smithy/build:smithy.bzl", "smithy_build", "smithy_validate")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "smithy_sources",
    srcs = glob(["*.smithy"]),
)

filegroup(
    name = "smithy_config",
    srcs = ["smithy-build.json"],
)

filegroup(
    name = "docs",
    srcs = ["README.md"],
)

smithy_validate(
    name = "smithy_validate",
    srcs = [":smithy_sources"],
    out = "smithy.validate",
    config = ":smithy_config",
    plugins = [
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
    ],
)

smithy_build(
    name = "smithy_build",
    srcs = [":smithy_sources"],
    out = "smithy-build",
    config = ":smithy_config",
    plugins = [
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
    ],
)

smithy_projection_file(
    name = "iam_public_ir",
    out = "iam-public.ir.json",
    build = ":smithy_build",
    path = "iam-public/verself-ir/ir/verself/iam-public.json",
)

smithy_projection_file(
    name = "iam_internal_ir",
    out = "iam-internal.ir.json",
    build = ":smithy_build",
    path = "iam-internal/verself-ir/ir/verself/iam-internal.json",
)

ir_catalog_json(
    name = "iam_audit_catalog",
    out = "iam-audit.catalog.json",
    catalog = "audit",
    ir = ":iam_public_ir",
)

ir_catalog_json(
    name = "iam_observability_catalog",
    out = "iam-observability.catalog.json",
    catalog = "observability",
    ir = ":iam_public_ir",
)

ir_proto_projection(
    name = "iam_proto_projection",
    out = "iam.proto",
    ir = ":iam_public_ir",
)
