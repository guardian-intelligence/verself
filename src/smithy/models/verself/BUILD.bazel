load("//src/smithy/build:ir_go.bzl", "ir_catalog_json", "ir_proto_projection", "smithy_projection_file")
load("//src/smithy/build:smithy.bzl", "smithy_build", "smithy_validate")
load("//src/tools/build:check_tests.bzl", "stamp_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "smithy_sources",
    srcs = glob(["*.smithy"]),
)

filegroup(
    name = "smithy_config",
    srcs = ["smithy-build.json"],
)

smithy_validate(
    name = "smithy_validate",
    srcs = [":smithy_sources"],
    out = "smithy.validate",
    config = ":smithy_config",
    plugins = [
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
    ],
)

stamp_test(
    name = "smithy_validate_test",
    tags = [
        "repo_check",
        "smithy_validate",
    ],
    target = ":smithy_validate",
)

smithy_build(
    name = "smithy_build",
    srcs = [":smithy_sources"],
    out = "smithy-build",
    config = ":smithy_config",
    plugins = [
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
    ],
)

smithy_projection_file(
    name = "analytics_public_ir",
    out = "analytics-public.ir.json",
    build = ":smithy_build",
    path = "analytics-public/verself-ir/ir/verself/analytics-public.json",
)

