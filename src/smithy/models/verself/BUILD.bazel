package(default_visibility = ["//visibility:public"])

filegroup(
    name = "smithy_sources",
    srcs = glob(["*.smithy"]),
)

filegroup(
    name = "smithy_config",
    srcs = ["smithy-build.json"],
)

filegroup(
    name = "docs",
    srcs = ["README.md"],
)

genrule(
    name = "smithy_validate",
    srcs = [
        ":smithy_config",
        ":smithy_sources",
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
        "//src/smithy/validators:verself_smithy_validators",
        "@dev_tool_smithy_cli//file",
    ],
    outs = ["smithy.validate.ok"],
    cmd = """
set -euo pipefail
	root="$$PWD"
	tmp="$$(mktemp -d)"
	trap 'rm -rf "$$tmp"' EXIT
	unzip -q "$$root/$(location @dev_tool_smithy_cli//file:file)" -d "$$tmp"
	smithy_cp="$$tmp/smithy-cli-linux-x86_64/lib/*:$$root/$(location //src/smithy/validators:verself_smithy_validators):$$root/$(location //src/smithy/plugins/ir:verself_smithy_ir_plugin)"
	"$$tmp/smithy-cli-linux-x86_64/bin/java" -XX:-UsePerfData -cp "$$smithy_cp" software.amazon.smithy.cli.SmithyCli validate --no-color --severity NOTE --config "$(location :smithy_config)" --output "$$tmp/build"
	touch "$@"
	""",
)

genrule(
    name = "smithy_build",
    srcs = [
        ":smithy_config",
        ":smithy_sources",
        "//src/smithy/plugins/ir:verself_smithy_ir_plugin",
        "//src/smithy/validators:verself_smithy_validators",
        "@dev_tool_smithy_cli//file",
    ],
    outs = ["smithy-build.tar"],
    cmd = """
set -euo pipefail
	root="$$PWD"
	tmp="$$(mktemp -d)"
	trap 'rm -rf "$$tmp"' EXIT
	unzip -q "$$root/$(location @dev_tool_smithy_cli//file:file)" -d "$$tmp"
	smithy_cp="$$tmp/smithy-cli-linux-x86_64/lib/*:$$root/$(location //src/smithy/validators:verself_smithy_validators):$$root/$(location //src/smithy/plugins/ir:verself_smithy_ir_plugin)"
	"$$tmp/smithy-cli-linux-x86_64/bin/java" -XX:-UsePerfData -cp "$$smithy_cp" software.amazon.smithy.cli.SmithyCli build --no-color --severity NOTE --config "$(location :smithy_config)" --output "$$tmp/build"
	tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 2000-01-01' -cf "$@" -C "$$tmp/build" .
	""",
)

genrule(
    name = "iam_public_ir",
    srcs = [":smithy_build"],
    outs = ["iam-public.ir.json"],
    cmd = """
set -euo pipefail
tar -xOf "$(location :smithy_build)" ./iam-public/verself-ir/ir/verself/iam-public.json > "$@"
""",
)

genrule(
    name = "iam_audit_catalog",
    srcs = [":iam_public_ir"],
    outs = ["iam-audit.catalog.json"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode catalog-json \
  -catalog audit \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go:ir-go"],
)

genrule(
    name = "iam_observability_catalog",
    srcs = [":iam_public_ir"],
    outs = ["iam-observability.catalog.json"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode catalog-json \
  -catalog observability \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go:ir-go"],
)

genrule(
    name = "iam_conformance_fixtures",
    srcs = [":iam_public_ir"],
    outs = ["iam-conformance.fixtures.json"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode conformance-json \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go:ir-go"],
)

genrule(
    name = "iam_proto_projection",
    srcs = [":iam_public_ir"],
    outs = ["iam.proto"],
    cmd = """
set -euo pipefail
$(location //src/smithy/cmd/ir-go:ir-go) \
  -ir "$(location :iam_public_ir)" \
  -mode proto \
  -out "$@"
""",
    tools = ["//src/smithy/cmd/ir-go:ir-go"],
)
