#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path
from urllib.parse import urlparse

REGISTRY_HOST = "npm.verself.sh"


def xdg_path(env_name: str, fallback: Path, suffix: str) -> Path:
    base = os.environ.get(env_name, "").strip()
    if base:
        return Path(base) / "verself" / suffix
    return fallback / "verself" / suffix


def read_owner_token_file(path: str) -> str:
    return Path(path).read_text(encoding="utf-8").strip()


def active_profile_token() -> str:
    home = Path.home()
    config_path = xdg_path("XDG_CONFIG_HOME", home / ".config", "config.json")
    data_root = xdg_path("XDG_DATA_HOME", home / ".local" / "share", "")
    state_root = xdg_path("XDG_STATE_HOME", home / ".local" / "state", "")

    if not config_path.exists():
        return ""
    config = json.loads(config_path.read_text(encoding="utf-8"))
    profile_name = str(config.get("active_profile", "")).strip()
    if not profile_name:
        return ""

    profile_path = data_root / "profiles" / f"{profile_name}.json"
    profile = json.loads(profile_path.read_text(encoding="utf-8"))
    token_ref = str(profile.get("token_ref", "")).strip()
    prefix = "verself-cred://"
    if not token_ref.startswith(prefix):
        raise ValueError(f"credential ref invalid: {token_ref}")
    credential_id = token_ref[len(prefix) :]
    if not credential_id or "/" in credential_id or "\\" in credential_id:
        raise ValueError(f"credential ref invalid: {token_ref}")

    credential = (state_root / "credentials" / f"{credential_id}.secret").read_text(encoding="utf-8").strip()
    try:
        parsed = json.loads(credential)
    except json.JSONDecodeError:
        return credential
    return str(parsed.get("access_token", "")).strip()


def resolve_token() -> str:
    token = os.environ.get("VERSELF_NPM_REGISTRY_TOKEN", "").strip()
    if token:
        return token

    token_file = os.environ.get("VERSELF_TOKEN_FILE", "").strip()
    if token_file:
        return read_owner_token_file(token_file)

    token = os.environ.get("VERSELF_TOKEN", "").strip()
    if token:
        return token

    return active_profile_token()


def token_or_error() -> str:
    try:
        return resolve_token()
    except Exception as err:
        raise RuntimeError(f"npm registry credential lookup failed: {err}") from err


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "print-token":
        uri = sys.argv[2] if len(sys.argv) >= 3 else f"https://{REGISTRY_HOST}/"
        if urlparse(uri).hostname != REGISTRY_HOST:
            print(f"unsupported registry host: {uri}", file=sys.stderr)
            return 1
        try:
            token = token_or_error()
        except RuntimeError as err:
            print(err, file=sys.stderr)
            return 1
        if not token:
            print(
                "run `verself auth login` or set VERSELF_NPM_REGISTRY_TOKEN for authenticated npm.verself.sh access",
                file=sys.stderr,
            )
            return 1
        print(token)
        return 0

    if len(sys.argv) < 2 or sys.argv[1] != "get":
        print("expected credential-helper command: get", file=sys.stderr)
        return 1

    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError as err:
        print(f"invalid credential-helper request: {err}", file=sys.stderr)
        return 1

    uri = request.get("uri", "")
    if urlparse(uri).hostname != REGISTRY_HOST:
        json.dump({"headers": {}}, sys.stdout)
        return 0

    try:
        token = token_or_error()
    except RuntimeError as err:
        print(err, file=sys.stderr)
        return 1
    if not token:
        print(
            "run `verself auth login` or set VERSELF_NPM_REGISTRY_TOKEN for authenticated npm.verself.sh access",
            file=sys.stderr,
        )
        return 1

    json.dump({"headers": {"Authorization": [f"Bearer {token}"]}}, sys.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
