load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//src/tools/deployment/nomad:artifact.bzl", "nomad_binary_artifact")

go_library(
    name = "substrate-control-plane-apply_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/deployment-tools/cmd/substrate-control-plane-apply",
    visibility = ["//visibility:private"],
    deps = ["//src/services/deployment-service/controlplane"],
)

go_binary(
    name = "substrate-control-plane-apply",
    embed = [":substrate-control-plane-apply_lib"],
    visibility = ["//visibility:public"],
)

nomad_binary_artifact(
    name = "substrate-control-plane-apply_nomad_artifact",
    binary = ":substrate-control-plane-apply",
    output = "substrate-control-plane-apply",
)
