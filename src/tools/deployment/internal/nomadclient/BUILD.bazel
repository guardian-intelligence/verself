load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nomadclient",
    srcs = [
        "capacity.go",
        "client.go",
        "failure.go",
        "monitor.go",
        "rehearse.go",
        "safeconv.go",
        "spec.go",
    ],
    importpath = "github.com/verself/deployment-tools/internal/nomadclient",
    visibility = ["//src/tools/deployment:__subpackages__"],
    deps = [
        "@com_github_hashicorp_nomad_api//:api",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "nomadclient_test",
    srcs = [
        "capacity_test.go",
        "monitor_test.go",
    ],
    embed = [":nomadclient"],
    deps = ["@com_github_hashicorp_nomad_api//:api"],
)
