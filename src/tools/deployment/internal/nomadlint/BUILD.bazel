load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nomadlint",
    srcs = ["lint.go"],
    importpath = "github.com/verself/deployment-tools/internal/nomadlint",
    visibility = ["//src/tools/deployment:__subpackages__"],
    deps = ["@com_github_hashicorp_nomad_api//:api"],
)

go_test(
    name = "nomadlint_test",
    srcs = ["lint_test.go"],
    embed = [":nomadlint"],
    deps = ["@com_github_hashicorp_nomad_api//:api"],
)
