load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sitebootstrap",
    srcs = [
        "bootstrap_deploy.go",
        "deploy_declarations.go",
        "descriptors.go",
        "handoff.go",
        "inventory.go",
        "openbao_reconcile.go",
        "postgres_reconcile.go",
    ],
    importpath = "github.com/verself/deployment-tools/internal/sitebootstrap",
    visibility = ["//src/tools/deployment:__subpackages__"],
    deps = [
        "//src/services/deployment-service/deploycontract",
        "//src/services/deployment-service/deployengine",
        "@com_github_hashicorp_nomad_api//:api",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@org_golang_x_crypto//ssh",
    ],
)

go_test(
    name = "sitebootstrap_test",
    srcs = ["sitebootstrap_test.go"],
    embed = [":sitebootstrap"],
    deps = ["//src/services/deployment-service/deployengine"],
)
