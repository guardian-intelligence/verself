load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sitebootstrap",
    srcs = [
        "bootstrap_deploy.go",
        "handoff.go",
        "inventory.go",
    ],
    importpath = "github.com/verself/deployment-tools/internal/sitebootstrap",
    visibility = ["//src/tools/deployment:__subpackages__"],
    deps = [
        "//src/services/deployment-service/deployengine",
        "//src/tools/operator-runtime/go/runtime",
        "@org_golang_x_crypto//ssh",
    ],
)

go_test(
    name = "sitebootstrap_test",
    srcs = ["sitebootstrap_test.go"],
    embed = [":sitebootstrap"],
    deps = ["//src/services/deployment-service/deployengine"],
)
