package(default_visibility = ["//visibility:public"])

exports_files([
    "dev_tools.MODULE.bazel",
    "stripe-projects-config.toml",
    "stripe-projects-plugin.toml",
])

genrule(
    name = "buildifier_bin",
    srcs = ["@dev_tool_buildifier//file"],
    outs = ["buildifier"],
    cmd = "install -m 0755 $(location @dev_tool_buildifier//file) $@",
)

genrule(
    name = "gofumpt_bin",
    srcs = ["@cc_mvdan_gofumpt//:gofumpt"],
    outs = ["gofumpt"],
    cmd = "install -m 0755 $(location @cc_mvdan_gofumpt//:gofumpt) $@",
)

# Go ships its standard library and runtime tree alongside the binary; the
# `go` command derives GOROOT as the parent of bin/. The catalog convention
# <name>/bin/<exe> places the binary at go/bin/go, so GOROOT resolves to the
# tool root's go/ subdir — we must carry the whole dist, not just the binary.
# The upstream tarball is already rooted at go/, so this just recompresses it
# as a plain tar for pkg_tar `deps` composition into the tool root.
genrule(
    name = "go_root_tar",
    srcs = ["@dev_tool_go//file"],
    outs = ["go-root.tar"],
    cmd = "gzip -dc $(location @dev_tool_go//file) > $@",
)

genrule(
    name = "jq_bin",
    srcs = ["@dev_tool_jq//file"],
    outs = ["jq"],
    cmd = "install -m 0755 $(location @dev_tool_jq//file) $@",
)

genrule(
    name = "cdxgen_bin",
    srcs = ["@dev_tool_cdxgen//file"],
    outs = ["cdxgen"],
    cmd = "install -m 0755 $(location @dev_tool_cdxgen//file) $@",
)

genrule(
    name = "syft_bin",
    srcs = ["@dev_tool_syft//file"],
    outs = ["syft"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
tar -xzf "$(location @dev_tool_syft//file)" -C "$$tmp"
install -m 0755 "$$tmp/syft" "$@"
""",
)

alias(
    name = "ruby",
    actual = "@dev_tool_ruby//:ruby",
)

genrule(
    name = "tofu_bin",
    srcs = ["@dev_tool_tofu//file"],
    outs = ["tofu"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
unzip -q "$(location @dev_tool_tofu//file)" -d "$$tmp"
install -m 0755 "$$tmp/tofu" "$@"
""",
)

genrule(
    name = "stripe_cli_bin",
    srcs = ["@dev_tool_stripe_cli//file"],
    outs = ["stripe"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
tar -xzf "$(location @dev_tool_stripe_cli//file)" -C "$$tmp"
install -m 0755 "$$tmp/stripe" "$@"
""",
)

genrule(
    name = "stripe_projects_plugin_bin",
    srcs = ["@dev_tool_stripe_projects_plugin//file"],
    outs = ["stripe-cli-projects"],
    cmd = "install -m 0755 $(location @dev_tool_stripe_projects_plugin//file) $@",
)

genrule(
    name = "uv_tools",
    srcs = ["@dev_tool_uv//file"],
    outs = [
        "uv",
        "uvx",
    ],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
tar -xzf "$(location @dev_tool_uv//file)" -C "$$tmp" --strip-components=1
install -m 0755 "$$tmp/uv" "$(location uv)"
install -m 0755 "$$tmp/uvx" "$(location uvx)"
""",
)
