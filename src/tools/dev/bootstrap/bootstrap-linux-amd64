#!/usr/bin/env bash
# Install the bootstrap_pivot dev tools that have to land before any other
# delivery channel can run. Developer, agent, and CI environments install the
# same Bazel and Aspect CLI pivot. Everything else, including the Vite+
# toolchain (`aspect vp`), is Bazel-resolved.
#
# These constants are hand-mirrored because this script bootstraps Bazel before
# Guardian or Bazel-owned repository rules can run.
set -euo pipefail

bazel_version="9.1.0"
bazel_sha256="a667454f3f4f8878df8199136b82c199f6ada8477b337fae3b1ef854f01e4e2f"
bazel_url="https://releases.bazel.build/${bazel_version}/release/bazel-${bazel_version}-linux-x86_64"

aspect_version="2026.17.17"
aspect_sha256="db45968e114c22af0e0d3dddadfb7091c81983f66499eed9d01d782bb09483d0"
aspect_url="https://github.com/aspect-build/aspect-cli/releases/download/v${aspect_version}/aspect-cli-x86_64-unknown-linux-musl"

install_dir="${BOOTSTRAP_INSTALL_DIR:-${HOME}/.cache/verself/bootstrap-bin}"
last_installed_path=""

if [[ "$#" -gt 0 ]]; then
  case "$1" in
  -h | --help)
    echo "usage: $0" >&2
    echo "set BOOTSTRAP_INSTALL_DIR to opt into a different install directory" >&2
    exit 0
    ;;
  *)
    echo "usage: $0" >&2
    exit 1
    ;;
  esac
fi

if [[ "$(uname -s)" != "Linux" || "$(uname -m)" != "x86_64" ]]; then
  echo "unsupported bootstrap platform: $(uname -s) $(uname -m)" >&2
  echo "src/tools/dev/bootstrap/bootstrap-linux-amd64 pins the Linux x86_64 bootstrap_pivot artifacts." >&2
  exit 1
fi

hash_file() {
  local path="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "${path}" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "${path}" | awk '{print $1}'
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "${path}" <<'PY'
import hashlib
import pathlib
import sys

print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())
PY
  else
    echo "missing sha256sum, shasum, or python3 for checksum verification" >&2
    exit 1
  fi
}

download() {
  local url="$1"
  local output="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${url}" -o "${output}"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "${output}" "${url}"
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "${url}" "${output}" <<'PY'
import sys
import urllib.request

urllib.request.urlretrieve(sys.argv[1], sys.argv[2])
PY
  else
    echo "missing curl, wget, or python3 for downloading bootstrap binaries" >&2
    exit 1
  fi
}

# install_pivot <name> <version> <sha256> <url>
#
# Idempotent: short-circuits when the binary already exists in install_dir with
# the expected sha256.
install_pivot() {
  local name="$1"
  local version="$2"
  local sha256="$3"
  local url="$4"
  last_installed_path=""

  if ! mkdir -p "${install_dir}"; then
    echo "cannot create ${install_dir}" >&2
    return 1
  fi

  local existing_path="${install_dir}/${name}"
  if [[ -x "${existing_path}" && "$(hash_file "${existing_path}")" == "${sha256}" ]]; then
    echo "${name} ${version} already installed at ${existing_path}"
    last_installed_path="${existing_path}"
    return 0
  fi

  local tmp_dir
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "'"${tmp_dir}"'"' RETURN

  download "${url}" "${tmp_dir}/${name}"
  local actual_sha256
  actual_sha256="$(hash_file "${tmp_dir}/${name}")"
  if [[ "${actual_sha256}" != "${sha256}" ]]; then
    echo "${name} checksum mismatch: expected ${sha256}, got ${actual_sha256}" >&2
    return 1
  fi
  chmod 0755 "${tmp_dir}/${name}"

  local installed_path
  if [[ -w "${install_dir}" ]]; then
    install -m 0755 "${tmp_dir}/${name}" "${install_dir}/${name}"
    installed_path="${install_dir}/${name}"
  else
    echo "cannot install ${name} to ${install_dir}: directory not writable" >&2
    return 1
  fi

  echo "installed ${name} ${version} at ${installed_path}"
  last_installed_path="${installed_path}"
}

publish_bootstrap_path() {
  local bin_dir="$1"
  if [[ -z "${GITHUB_PATH:-}" ]]; then
    return 0
  fi
  if [[ -f "${GITHUB_PATH}" ]] && grep -Fx -- "${bin_dir}" "${GITHUB_PATH}" >/dev/null 2>&1; then
    return 0
  fi
  printf '%s\n' "${bin_dir}" >> "${GITHUB_PATH}"
  echo "added ${bin_dir} to GITHUB_PATH"
}

warn_bootstrap_path() {
  local bin_dir="$1"
  case ":${PATH}:" in
    *":${bin_dir}:"*) return 0 ;;
  esac
  if [[ -n "${GITHUB_PATH:-}" ]]; then
    return 0
  fi
  echo "add ${bin_dir} to PATH before running bazel or aspect" >&2
}

install_pivot bazel "${bazel_version}" "${bazel_sha256}" "${bazel_url}"
publish_bootstrap_path "${install_dir}"
warn_bootstrap_path "${install_dir}"

install_pivot aspect "${aspect_version}" "${aspect_sha256}" "${aspect_url}"

# The pivot ends here. The Vite+ toolchain is the lockfile-pinned
# src/viteplus-monorepo/node_modules/vite-plus run under the Bazel-resolved host Node;
# it is invoked as `aspect vp -- <args>`, not bootstrapped.
