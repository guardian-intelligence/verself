    out = "site-preflight-tools.tar",
    files = {
        "//src/infrastructure-components/nomad:nomad_bin": "opt/verself/profile/bin/nomad",
        "//src/infrastructure-components/nomad:nomad_driver_podman_bin": "opt/verself/profile/nomad/plugins/nomad-driver-podman",
        "//src/infrastructure-components/podman:runtime_artifact": "opt/verself/profile/artifacts/podman-debs.tar",
        "//src/infrastructure-components/zot/cmd/zot-htpasswd:zot-htpasswd": "opt/verself/profile/bin/zot-htpasswd",
        "@otelcol_tools//tools/spiffe-helper": "opt/verself/profile/bin/spiffe-helper",
        "@zot_tools//tools/zot": "opt/verself/profile/bin/zot",
        "//src/infrastructure-components/spire:spire_agent_bin": "opt/verself/profile/bin/spire-agent",
        "//src/infrastructure-components/spire:spire_server_bin": "opt/verself/profile/bin/spire-server",
    },
    modes = {
        "opt/verself/profile/bin/nomad": "0755",
        "opt/verself/profile/nomad/plugins/nomad-driver-podman": "0755",
        "opt/verself/profile/artifacts/podman-debs.tar": "0644",
        "opt/verself/profile/bin/spiffe-helper": "0755",
        "opt/verself/profile/bin/spire-agent": "0755",
        "opt/verself/profile/bin/spire-server": "0755",
        "opt/verself/profile/bin/zot": "0755",
        "opt/verself/profile/bin/zot-htpasswd": "0755",
    },
)

filegroup(
    name = "ansible_lint_sources",
    srcs = [
        "ansible/.ansible-lint.yml",
        "ansible/ansible.cfg",
        "ansible/pyproject.toml",
        "ansible/requirements.yml",
        "ansible/requirements_lock.txt",
        "ansible/uv.lock",
    ] + glob(
        [
            "ansible/playbooks/**",
            "ansible/roles/**",
        ],
        allow_empty = False,
    ) + [
        "//src/infrastructure-components/haproxy:role_sources",
        "//src/infrastructure-components/nomad:role_sources",
        "//src/infrastructure-components/podman:role_sources",
        "//src/infrastructure-components/spire:registration_sources",
        "//src/infrastructure-components/spire:role_sources",
        "//src/infrastructure-components/zot:role_sources",
    ],
)

py_binary(
    name = "ansible_lint_bin",
    main_module = "ansiblelint.__main__",
    visibility = ["//visibility:private"],
    deps = [
        requirement("ansible-core"),
        requirement("ansible-lint"),
    ],
)

py_binary(
    name = "ansible_bin",
    main_module = "ansible.cli.adhoc",
    visibility = ["//visibility:private"],
    deps = [
        requirement("ansible-core"),
    ],
)

py_binary(
    name = "ansible_config_bin",
    main_module = "ansible.cli.config",
    visibility = ["//visibility:private"],
    deps = [
        requirement("ansible-core"),
    ],
)

py_binary(
    name = "ansible_doc_bin",
    main_module = "ansible.cli.doc",
    visibility = ["//visibility:private"],
    deps = [
        requirement("ansible-core"),
    ],
)

py_binary(
    name = "ansible_galaxy_bin",
    main_module = "ansible.cli.galaxy",
    visibility = ["//visibility:private"],
    deps = [
        requirement("ansible-core"),
    ],
)

py_binary(
    name = "ansible_playbook_bin",
    main_module = "ansible.cli.playbook",
    visibility = ["//src/tools/deployment:__subpackages__"],
    deps = [
        requirement("ansible-core"),
    ],
)

genrule(
    name = "ansible_collections_archive",
    srcs = [
        "@dev_tool_ansible_collection_ansible_posix//file",
        "@dev_tool_ansible_collection_community_general//file",
        "@dev_tool_ansible_collection_community_postgresql//file",
    ],
    outs = ["ansible_collections.tar"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
mkdir -p "$$tmp/ansible_collections/ansible/posix"
mkdir -p "$$tmp/ansible_collections/community/general"
mkdir -p "$$tmp/ansible_collections/community/postgresql"
tar -xzf "$(location @dev_tool_ansible_collection_ansible_posix//file)" -C "$$tmp/ansible_collections/ansible/posix"
tar -xzf "$(location @dev_tool_ansible_collection_community_general//file)" -C "$$tmp/ansible_collections/community/general"
tar -xzf "$(location @dev_tool_ansible_collection_community_postgresql//file)" -C "$$tmp/ansible_collections/community/postgresql"
tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 2000-01-01' -cf "$@" -C "$$tmp" ansible_collections
""",
)

genrule(
    name = "ansible_requirements_lock_check",
    srcs = [
        "ansible/pyproject.toml",
        "ansible/requirements_lock.txt",
        "ansible/uv.lock",
        "@python_3_13//:files",
    ],
    outs = ["ansible_requirements_lock_check.stamp"],
    cmd = """
set -euo pipefail
execroot="$$PWD"
out="$$execroot/$@"
uv_tmp="$$(mktemp -d)"
uv_home="$$(mktemp -d)"
export HOME="$$uv_home/home"
export XDG_CACHE_HOME="$$uv_home/cache"
export UV_CACHE_DIR="$$uv_home/uv-cache"
export UV_PYTHON_INSTALL_DIR="$$uv_home/python"
export UV_PROJECT_ENVIRONMENT="$$uv_home/project"
export UV_TOOL_DIR="$$uv_home/tools"
export UV_LINK_MODE=copy
export UV_NO_MANAGED_PYTHON=1
export UV_PYTHON_DOWNLOADS=never
trap 'rm -rf "$$uv_tmp" "$$uv_home"' EXIT
mkdir -p "$$HOME" "$$XDG_CACHE_HOME" "$$UV_CACHE_DIR" "$$UV_PYTHON_INSTALL_DIR" "$$UV_PROJECT_ENVIRONMENT" "$$UV_TOOL_DIR"
tar -xzf "$$execroot/$(location @dev_tool_uv//file)" -C "$$uv_tmp" --strip-components=1
python=""
for candidate in $(locations @python_3_13//:files); do
  case "$$candidate" in
    */bin/python3.13)
      python="$$execroot/$$candidate"
      ;;
  esac
done
test -x "$$python"
cd src/tools/site-preflight/ansible
"$$uv_tmp/uv" export --locked --python "$$python" --format requirements.txt --no-emit-project --no-header --output-file "$$uv_home/requirements_lock.txt" >/dev/null
diff -u requirements_lock.txt "$$uv_home/requirements_lock.txt"
touch "$$out"
""",
    tags = [
        "ansible_lint_check",
        "local",
        "manual",
        "no-remote",
        "repo_check",
    ],
    tools = ["@dev_tool_uv//file"],
)

stamp_test(
    name = "ansible_requirements_lock_test",
    tags = [
        "ansible_lint_check",
        "local",
        "no-remote",
        "repo_check",
    ],
    target = ":ansible_requirements_lock_check",
)

genrule(
    name = "ansible_lint_check",
    srcs = [
        ":ansible_lint_sources",
        "@dev_tool_ansible_collection_ansible_posix//file",
        "@dev_tool_ansible_collection_community_general//file",
        "@dev_tool_ansible_collection_community_postgresql//file",
    ],
    outs = ["ansible_lint_check.stamp"],
    cmd = """
set -euo pipefail
execroot="$$PWD"
out="$$execroot/$@"
ansible_home="$$(mktemp -d)"
collections_tmp="$$(mktemp -d)"
tool_bin="$$(mktemp -d)"
trap 'rm -rf "$$ansible_home" "$$collections_tmp" "$$tool_bin"' EXIT
export ANSIBLE_COLLECTIONS_PATH="$$collections_tmp"
export HOME="$$ansible_home/home"
export XDG_CACHE_HOME="$$ansible_home/cache"
export PYTHONDONTWRITEBYTECODE=1
mkdir -p "$$HOME" "$$XDG_CACHE_HOME"
# Bazel Python launchers export their own runfiles; Ansible subprocesses need
# each helper command to discover its own runfiles tree.
write_tool() {
  tool_name="$$1"
  tool_path="$$2"
  {
    printf '%s\\n' '#!/usr/bin/env bash'
    printf '%s\\n' 'unset RUNFILES_DIR'
    printf '%s\\n' 'unset RUNFILES_MANIFEST_FILE'
    printf 'exec "%s" "\\044@"\\n' "$$tool_path"
  } > "$$tool_bin/$$tool_name"
  chmod +x "$$tool_bin/$$tool_name"
}
write_tool ansible "$$execroot/$(execpath :ansible_bin)"
write_tool ansible-config "$$execroot/$(execpath :ansible_config_bin)"
write_tool ansible-doc "$$execroot/$(execpath :ansible_doc_bin)"
write_tool ansible-galaxy "$$execroot/$(execpath :ansible_galaxy_bin)"
write_tool ansible-playbook "$$execroot/$(execpath :ansible_playbook_bin)"
export PATH="$$tool_bin:$${PATH:-}"
mkdir -p "$$collections_tmp/ansible_collections/ansible/posix"
mkdir -p "$$collections_tmp/ansible_collections/community/general"
mkdir -p "$$collections_tmp/ansible_collections/community/postgresql"
tar -xzf "$$execroot/$(location @dev_tool_ansible_collection_ansible_posix//file)" -C "$$collections_tmp/ansible_collections/ansible/posix"
tar -xzf "$$execroot/$(location @dev_tool_ansible_collection_community_general//file)" -C "$$collections_tmp/ansible_collections/community/general"
tar -xzf "$$execroot/$(location @dev_tool_ansible_collection_community_postgresql//file)" -C "$$collections_tmp/ansible_collections/community/postgresql"
cd src/tools/site-preflight/ansible
"$$execroot/$(execpath :ansible_lint_bin)" playbooks roles ../../../infrastructure-components/haproxy ../../../infrastructure-components/nomad ../../../infrastructure-components/podman ../../../infrastructure-components/spire ../../../infrastructure-components/spire/ansible ../../../infrastructure-components/zot
touch "$$out"
""",
    tags = [
        "ansible_lint_check",
        "local",
        "manual",
        "no-remote",
        "no-sandbox",
        "repo_check",
    ],
    tools = [
        ":ansible_bin",
        ":ansible_config_bin",
        ":ansible_doc_bin",
        ":ansible_galaxy_bin",
        ":ansible_lint_bin",
        ":ansible_playbook_bin",
    ],
)

stamp_test(
    name = "ansible_lint_test",
    tags = [
        "ansible_lint_check",
        "local",
        "no-remote",
        "no-sandbox",
        "repo_check",
    ],
    target = ":ansible_lint_check",
)

filegroup(
    name = "preflight_sources",
    srcs = glob(
        ["ansible/**"],
        allow_empty = True,
        exclude = [
            "ansible/.ansible/**",
            "ansible/.cache/**",
            "ansible/**/__rendered/**",
            "ansible/**/__pycache__/**",
            "ansible/*.ini",
        ],
    ) + [
        "//src/infrastructure-components:role_sources",
        "//src/integrations:integration_sources",
        "//src/sites:site_sources",
        "//src/substrate/vm-orchestrator:host_ansible_sources",
    ],
)
