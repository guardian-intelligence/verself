# gazelle:prefix github.com/verself/operator-tools/cmd/discovery-canary

load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "discovery-canary_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/operator-tools/cmd/discovery-canary",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/iam-service/client",
        "//src/services/service-runtime/go/auth",
        "//src/services/service-runtime/go/iam",
        "//src/services/service-runtime/go/workload",
        "//src/tools/observability/go/otel",
    ],
)

go_binary(
    name = "discovery-canary",
    embed = [":discovery-canary_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "discovery-canary_test",
    srcs = ["main_test.go"],
    embed = [":discovery-canary_lib"],
)
