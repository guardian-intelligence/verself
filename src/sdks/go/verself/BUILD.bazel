load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "verself",
    srcs = [
        "client.go",
        "iam.go",
        "projects.go",
        "source.go",
    ],
    importpath = "github.com/verself/verself-go",
    visibility = ["//visibility:public"],
    deps = [
        "//src/sdks/go/verself/internal/generated/iam",
        "//src/sdks/go/verself/internal/generated/projects",
        "//src/sdks/go/verself/internal/generated/source",
        "@com_github_google_uuid//:uuid",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//propagation",
    ],
)

go_test(
    name = "verself_test",
    srcs = [
        "client_test.go",
        "projects_test.go",
        "source_test.go",
    ],
    embed = [":verself"],
)
