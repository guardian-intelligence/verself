load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//src/tools/build:go_module_checks.bzl", "go_module_checks")

# gazelle:ignore

go_module_checks()

go_library(
    name = "verself",
    srcs = [
        "auth.go",
        "billing.go",
        "client.go",
        "distribution.go",
        "governance.go",
        "iam.go",
        "notifications.go",
        "projects.go",
        "sandbox.go",
        "secrets.go",
        "source.go",
    ],
    importpath = "github.com/verself/verself-go",
    visibility = ["//visibility:public"],
    deps = [
        "//src/sdks/go/verself/internal/transport/billing",
        "//src/sdks/go/verself/internal/transport/distribution",
        "//src/sdks/go/verself/internal/transport/governance",
        "//src/sdks/go/verself/internal/transport/iam",
        "//src/sdks/go/verself/internal/transport/notifications",
        "//src/sdks/go/verself/internal/transport/projects",
        "//src/sdks/go/verself/internal/transport/sandbox",
        "//src/sdks/go/verself/internal/transport/secrets",
        "//src/sdks/go/verself/internal/transport/source",
        "@com_github_google_uuid//:uuid",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//propagation",
    ],
)

go_test(
    name = "verself_test",
    srcs = [
        "billing_test.go",
        "client_test.go",
        "distribution_test.go",
        "governance_test.go",
        "iam_test.go",
        "notifications_test.go",
        "projects_test.go",
        "sandbox_test.go",
        "secrets_test.go",
        "source_test.go",
    ],
    embed = [":verself"],
)
