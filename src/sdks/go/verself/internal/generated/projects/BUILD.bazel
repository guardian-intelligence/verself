load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//src/smithy/build:ir_sdk.bzl", "ir_sdk_go")

# gazelle:ignore

ir_sdk_go(
    name = "public_transport_go",
    out = "__generated_sources/client.gen.go",
    ir = "//src/smithy/models/verself:projects_public_ir",
    package = "projects",
)

write_source_files(
    name = "generated_sources",
    files = {
        "client.gen.go": ":public_transport_go",
    },
    tags = ["manual"],
)

go_library(
    name = "projects",
    srcs = ["client.gen.go"],
    importpath = "github.com/verself/verself-go/internal/generated/projects",
    visibility = ["//src/sdks/go/verself:__pkg__"],
)
