load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "core",
    srcs = ["crates/core/src/lib.rs"],
    crate_name = "make_skill_core",
    edition = "2024",
)

rust_library(
    name = "exec",
    srcs = ["crates/exec/src/lib.rs"],
    crate_name = "make_skill_exec",
    edition = "2024",
    deps = [":core"],
)

rust_binary(
    name = "mksk",
    srcs = ["crates/cli/src/main.rs"],
    crate_name = "mksk",
    edition = "2024",
    stamp = 0,
    deps = [":exec"],
)

rust_binary(
    name = "install",
    srcs = ["crates/install/src/main.rs"],
    crate_name = "make_skill_install",
    data = [":mksk"],
    edition = "2024",
    env = {
        "MKSK_BINARY": "$(rootpath :mksk)",
    },
    stamp = 0,
)

rust_test(
    name = "core_test",
    srcs = ["crates/core/tests/core.rs"],
    edition = "2024",
    deps = [":core"],
)

rust_test(
    name = "exec_test",
    srcs = ["crates/exec/tests/exec.rs"],
    edition = "2024",
    deps = [":exec"],
)

rust_test(
    name = "cli_test",
    srcs = ["crates/cli/tests/cli.rs"],
    data = [":mksk"],
    edition = "2024",
    env = {
        "MKSK_UNDER_TEST": "$(rootpath :mksk)",
    },
)

pkg_tar(
    name = "release_tar",
    out = "make-skill.tar",
    files = {
        ":mksk": "bin/mksk",
        "LICENSE": "LICENSE",
    },
    modes = {
        "LICENSE": "0644",
        "bin/mksk": "0755",
    },
)
