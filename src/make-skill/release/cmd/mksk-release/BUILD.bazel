load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "mksk-release_lib",
    srcs = [
        "main.go",
        "publish.go",
        "release_intent.go",
    ],
    importpath = "github.com/verself/make-skill/release/cmd/mksk-release",
    visibility = ["//visibility:private"],
    deps = [
        "//src/make-skill/release/internal/ocipublish",
        "//src/tools/releaseattest",
        "@com_github_opencontainers_image_spec//specs-go/v1:specs-go",
        "@land_oras_oras_go_v2//:oras-go",
    ],
)

go_binary(
    name = "mksk-release",
    embed = [":mksk-release_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "mksk-release_test",
    srcs = ["main_test.go"],
    embed = [":mksk-release_lib"],
    deps = [
        "//src/make-skill/release/internal/ocipublish",
        "@land_oras_oras_go_v2//content/memory",
    ],
)
