{
  "name": "@verself/agent-email",
  "version": "0.1.0",
  "private": true,
  "description": "React Email template for agent-to-operator notifications, rendered to HTML/text at build time and delivered by email-service.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/agent-notification.ts",
      "default": "./src/agent-notification.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "vp exec tsc -p tsconfig.json"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "@react-email/render": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
