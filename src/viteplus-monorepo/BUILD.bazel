        "//src/viteplus-monorepo/apps/verself-web:dot_matrix_shader_generated_sources",
        "//src/viteplus-monorepo/apps/verself-web:dot_matrix_wave_shader_generated_sources",
        "//src/viteplus-monorepo/apps/verself-web:openapi_clients_generated_sources",
        "//src/viteplus-monorepo/apps/verself-web:openapi_spec_copies_generated_sources",
        "//src/viteplus-monorepo/apps/verself-web:route_tree_generated_sources",
