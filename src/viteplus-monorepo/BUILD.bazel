load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//src/viteplus-monorepo:viteplus_rules.bzl", "viteplus_input_sbom", "viteplus_node_runtime_artifact", "viteplus_workspace_check", "viteplus_workspace_install", "viteplus_workspace_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".npmrc",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "tsconfig.json",
    "vite.config.ts",
])

npm_link_all_packages()

# The vendored Node the controller-side frontend build runs on. Bazel and
# Aspect-owned frontend checks resolve `vp` through this exact binary plus the
# lockfile-pinned `node_modules/vite-plus`.
genrule(
    name = "vp_node",
    srcs = ["@rules_nodejs//nodejs:current_node_runtime"],
    outs = ["node"],
    cmd = """
set -euo pipefail
node=""
for candidate in $(locations @rules_nodejs//nodejs:current_node_runtime); do
  case "$$candidate" in
    */bin/node)
      node="$$candidate"
      ;;
  esac
done
test -n "$$node"
install -m 0755 "$$node" "$@"
""",
)

copy_to_bin(
    name = "workspace_config",
    srcs = [
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
)

filegroup(
    name = "workspace_sources",
    srcs = [
        ":workspace_config",
        "//src/viteplus-monorepo/packages/agent-email:sources",
        "//src/viteplus-monorepo/packages/auth-web:sources",
        "//src/viteplus-monorepo/packages/brand:sources",
        "//src/viteplus-monorepo/packages/nitro-plugins:sources",
        "//src/viteplus-monorepo/packages/sdk:sources",
        "//src/viteplus-monorepo/packages/ui:sources",
        "//src/viteplus-monorepo/packages/web-env:sources",
    ] + glob([
        "patches/**/*",
    ]),
)

filegroup(
    name = "workspace_install_inputs",
    srcs = [
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "//src/viteplus-monorepo/apps/company:package_manifest",
        "//src/viteplus-monorepo/apps/verself-web:package_manifest",
        "//src/viteplus-monorepo/packages/agent-email:package_manifest",
        "//src/viteplus-monorepo/packages/auth-web:package_manifest",
        "//src/viteplus-monorepo/packages/brand:package_manifest",
        "//src/viteplus-monorepo/packages/nitro-plugins:package_manifest",
        "//src/viteplus-monorepo/packages/sdk:package_manifest",
        "//src/viteplus-monorepo/packages/ui:package_manifest",
        "//src/viteplus-monorepo/packages/web-env:package_manifest",
    ] + glob([
        "patches/**/*",
    ]),
)

filegroup(
    name = "workspace_check_sources",
    srcs = [
        ":workspace_config",
        "//src/viteplus-monorepo/apps/company:sources",
        "//src/viteplus-monorepo/apps/verself-web:e2e_sources",
        "//src/viteplus-monorepo/apps/verself-web:sources",
        "//src/viteplus-monorepo/packages/auth-web:sources",
        "//src/viteplus-monorepo/packages/brand:sources",
        "//src/viteplus-monorepo/packages/nitro-plugins:sources",
        "//src/viteplus-monorepo/packages/sdk:sources",
        "//src/viteplus-monorepo/packages/ui:sources",
        "//src/viteplus-monorepo/packages/web-env:sources",
    ] + glob(
        [
            "apps/**/src/__generated/**",
            "apps/**/src/routeTree.gen.ts",
            "packages/**/src/__generated/**",
            "scripts/**/*.ts",
        ],
        allow_empty = True,
