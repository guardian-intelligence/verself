load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load(
    "@npm//src/viteplus-monorepo/apps/verself-web:@hey-api/openapi-ts/package_json.bzl",
    openapi_ts_bin = "bin",
)
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component", "post_deploy_canary")
load("//src/viteplus-monorepo:viteplus_rules.bzl", "viteplus_app", "viteplus_node_app_artifact", "viteplus_openapi_clients", "viteplus_openapi_spec_copies", "viteplus_route_tree")

package(default_visibility = ["//visibility:public"])

deploy_declarations(visibility = ["//visibility:public"])

DOT_MATRIX_SHADER_SRC_MAP = [
    ("dot-matrix.vert", "src/features/landing/dot-matrix/shader-src/dot-matrix.vert"),
    ("dot-matrix.frag", "src/features/landing/dot-matrix/shader-src/dot-matrix.frag"),
    ("wave-simulation.frag", "src/features/landing/dot-matrix/shader-src/wave-simulation.frag"),
]

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":node_app_nomad_artifact": "verself-web",
        "//src/viteplus-monorepo:nodejs_runtime_nomad_artifact": "nodejs-runtime",
    },
    component = "verself_web",
    digest_inputs = [":deploy_declarations"],
    job_id = "verself-web",
    job_spec = "nomad.hcl",
    post_deploy_canaries = [
        ":medium_browser_canary",
        ":large_guardian_oidc_canary",
    ],
    requires = ["nomad:job:electric"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)

post_deploy_canary(
    name = "medium_browser_canary",
    args = [
        "--site",
        "{site}",
        "--component",
        "{component}",
        "--job-id",
        "{job_id}",
        "--deploy-run-key",
        "{deploy_run_key}",
    ],
    canary_size = "medium",
    canary_timeout = "90s",
    kind = "browser",
    target = ":e2e_smoke",
)

post_deploy_canary(
    name = "large_guardian_oidc_canary",
    args = [
        "--site",
        "{site}",
        "--component",
        "{component}",
        "--job-id",
        "{job_id}",
        "--deploy-run-key",
        "{deploy_run_key}",
    ],
    canary_size = "large",
    canary_timeout = "2m",
    kind = "browser",
    target = ":e2e_guardian_oidc",
)

viteplus_app(
    srcs = [
        "dot-matrix-shader-plugin.ts",
        "instrumentation.mts",
        "package.json",
        "public/**/*",
        "src/**/*",
        "tsconfig.json",
        "vite.config.ts",
    ],
    npm_name = "@verself/verself-web",
)

viteplus_node_app_artifact(
    name = "node_app_nomad_artifact",
    generated_srcs = [
        ":route_tree_generated_sources",
        ":openapi_clients_generated_sources",
        ":openapi_spec_copies_generated_sources",
        ":dot_matrix_shader_generated_sources",
        ":dot_matrix_wave_shader_generated_sources",
        "//src/viteplus-monorepo/packages/sdk:openapi_clients_generated_sources",
    ],
    output = "verself-web",
)

viteplus_route_tree(name = "route_tree")

filegroup(
    name = "e2e_sources",
    srcs = glob(["e2e/**/*.ts"]),
)

filegroup(
    name = "guardian_oidc_journey",
    srcs = ["e2e/guardian-oidc-journey.feature"],
)

js_binary(
    name = "e2e_smoke",
    data = [
        ":node_modules/playwright-core",
        "//src/verself-cli/cmd/verself",
        "@chrome_headless_shell_linux64//:all",
        "@chrome_headless_shell_linux64//:chrome_headless_shell",
    ],
    entry_point = "e2e/verself-web-smoke.ts",
    fixed_args = [
        "--browser-executable=$(rootpath @chrome_headless_shell_linux64//:chrome_headless_shell)",
        "--cli=$(rootpath //src/verself-cli/cmd/verself:verself)",
    ],
    no_copy_to_bin = [
        "@chrome_headless_shell_linux64//:all",
        "@chrome_headless_shell_linux64//:chrome_headless_shell",
    ],
    tags = [
        "browser_canary",
        "local",
        "manual",
        "no-remote",
        "no-sandbox",
    ],
)

js_binary(
    name = "e2e_guardian_oidc",
    data = [
        ":guardian_oidc_journey",
        ":node_modules/playwright-core",
        "@chrome_headless_shell_linux64//:all",
        "@chrome_headless_shell_linux64//:chrome_headless_shell",
    ],
    entry_point = "e2e/guardian-oidc-canary.ts",
    fixed_args = [
        "--browser-executable=$(rootpath @chrome_headless_shell_linux64//:chrome_headless_shell)",
        "--journey=$(rootpath :guardian_oidc_journey)",
    ],
    no_copy_to_bin = [
        "@chrome_headless_shell_linux64//:all",
        "@chrome_headless_shell_linux64//:chrome_headless_shell",
    ],
    tags = [
        "browser_canary",
        "local",
        "manual",
        "no-remote",
        "no-sandbox",
    ],
)

js_run_binary(
    name = "dot_matrix_shader_gen",
    srcs = [src for _, src in DOT_MATRIX_SHADER_SRC_MAP],
    outs = ["__generated_sources/src/features/landing/dot-matrix/shader/dot-matrix.generated.ts"],
    args = [
        "--vertex=dot-matrix.vert",
        "--fragment=dot-matrix.frag",
        "--symbol-prefix=dotMatrix",
        "--out=__generated_sources/src/features/landing/dot-matrix/shader/dot-matrix.generated.ts",
    ] + [
        "--source=%s=$(location %s)" % (module, src)
        for module, src in DOT_MATRIX_SHADER_SRC_MAP
    ],
    chdir = package_name(),
    mnemonic = "GlslModuleGen",
    progress_message = "Generating landing dot matrix GLSL module",
    tool = "//src/viteplus-monorepo/scripts:generate_glsl_module",
)

filegroup(
    name = "dot_matrix_shader_generated_sources",
    srcs = [":dot_matrix_shader_gen"],
)

js_run_binary(
    name = "dot_matrix_wave_shader_gen",
    srcs = [src for _, src in DOT_MATRIX_SHADER_SRC_MAP],
    outs = ["__generated_sources/src/features/landing/dot-matrix/shader/wave-simulation.generated.ts"],
    args = [
        "--vertex=dot-matrix.vert",
        "--fragment=wave-simulation.frag",
        "--symbol-prefix=dotMatrixWave",
        "--out=__generated_sources/src/features/landing/dot-matrix/shader/wave-simulation.generated.ts",
    ] + [
        "--source=%s=$(location %s)" % (module, src)
        for module, src in DOT_MATRIX_SHADER_SRC_MAP
    ],
    chdir = package_name(),
    mnemonic = "GlslModuleGen",
    progress_message = "Generating landing dot matrix wave GLSL module",
    tool = "//src/viteplus-monorepo/scripts:generate_glsl_module",
)

filegroup(
    name = "dot_matrix_wave_shader_generated_sources",
    srcs = [":dot_matrix_wave_shader_gen"],
)

# Customer-facing OpenAPI client SDKs for every service the verself-web app
# talks to. Outputs are written to bazel-out, projected into src/__generated
# for local tools via write_source_files, and materialized by the app artifact
# build before `vp build` so service spec changes flow through the graph.
viteplus_openapi_clients(
    name = "openapi_clients",
    openapi_ts_bin = openapi_ts_bin,
    plugin_packages = [":node_modules/valibot"],
    specs = [
        ("profile-api", "//src/services/profile-service/openapi:openapi-3.1.yaml.bin"),
    ],
)

viteplus_openapi_spec_copies(
    name = "openapi_spec_copies",
    specs = [
        ("projects-api", "//src/services/projects-service/openapi:openapi-3.1.yaml"),
        ("notifications-api", "//src/services/notifications-service/openapi:openapi-3.1.yaml"),
        ("governance-api", "//src/services/governance-service/openapi:openapi-3.1.yaml"),
        ("source-api", "//src/services/source-code-hosting-service/openapi:openapi-3.1.yaml"),
        ("sandbox-rental-api", "//src/services/sandbox-rental-service/openapi:openapi-3.1.yaml"),
        ("secrets-api", "//src/services/secrets-service/openapi:openapi-3.1.yaml"),
        ("iam-api", "//src/services/iam-service/openapi:openapi-3.1.yaml"),
        ("email-api", "//src/services/email-service/openapi:openapi-3.1.yaml"),
        ("billing-api", "//src/services/billing-service/openapi:openapi-3.1.yaml"),
    ],
)

test_suite(
    name = "dev_check",
    tags = ["manual"],
    tests = [
        ":dot_matrix_shader_tests",
        ":openapi_clients_tests",
        ":openapi_spec_copies_tests",
        ":route_tree_tests",
    ],
)

write_source_files(
    name = "dot_matrix_shader",
    files = {
        "src/features/landing/dot-matrix/shader/dot-matrix.generated.ts": ":dot_matrix_shader_gen",
    },
    tags = ["manual"],
)

write_source_files(
    name = "dot_matrix_wave_shader",
    files = {
        "src/features/landing/dot-matrix/shader/wave-simulation.generated.ts": ":dot_matrix_wave_shader_gen",
    },
    tags = ["manual"],
)

write_source_files(
    name = "dev_update",
    additional_update_targets = [
        ":dot_matrix_shader",
        ":dot_matrix_wave_shader",
        ":route_tree",
        ":openapi_clients",
        ":openapi_spec_copies",
    ],
    tags = ["manual"],
)
