load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "deployment-service_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/deployment-service/cmd/deployment-service",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/deployment-service/internal/deployment",
        "//src/services/deployment-service/migrations",
        "//src/services/service-runtime/go/envconfig",
        "//src/services/service-runtime/go/httpserver",
        "//src/services/service-runtime/go/workload",
        "//src/tools/observability/go/otel",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
    ],
)

go_binary(
    name = "deployment-service",
    embed = [":deployment-service_lib"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "deployment-service_nomad_artifact",
    out = "deployment-service.tar",
    files = {
        ":deployment-service": "bin/deployment-service",
    },
    modes = {
        "bin/deployment-service": "0755",
    },
    visibility = ["//visibility:public"],
)

go_test(
    name = "deployment-service_test",
    srcs = ["main_test.go"],
    embed = [":deployment-service_lib"],
)
