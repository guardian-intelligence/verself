load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//src/smithy/build:ir_sdk.bzl", "ir_sdk_go")

ir_sdk_go(
    name = "public_transport_go",
    out = "__generated_sources/client.gen.go",
    ir = "//src/smithy/models/verself:secrets_public_ir",
    package = "secretsclient",
)

write_source_files(
    name = "generated_sources",
    files = {
        "client.gen.go": ":public_transport_go",
    },
    tags = ["manual"],
)

go_library(
    name = "client",
    srcs = [
        "client.gen.go",
        "client.go",
    ],
    importpath = "github.com/verself/secrets-service/client",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":client",
    visibility = ["//visibility:public"],
)
