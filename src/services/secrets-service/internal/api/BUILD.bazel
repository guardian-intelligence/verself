load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "api_activity_sink.go",
        "errors.go",
        "internal.go",
        "openapi.go",
        "policy.go",
        "raw_token.go",
        "routes.go",
    ],
    importpath = "github.com/verself/secrets-service/internal/api",
    visibility = ["//src/services/secrets-service:__subpackages__"],
    deps = [
        "//src/services/billing-service/client",
        "//src/services/governance-service/internalclient",
        "//src/services/secrets-service/internal/contractapi",
        "//src/services/secrets-service/internal/secrets",
        "//src/services/service-runtime/go/auth",
        "//src/services/service-runtime/go/humaapi",
        "//src/services/service-runtime/go/iam",
        "//src/services/service-runtime/go/workload",
        "@com_github_danielgtaylor_huma_v2//:huma",
        "@com_github_danielgtaylor_huma_v2//adapters/humago",
        "@com_github_google_uuid//:uuid",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

alias(
    name = "go_default_library",
    actual = ":api",
    visibility = ["//src/services/secrets-service:__subpackages__"],
)

go_test(
    name = "go_default_test",
    srcs = ["internal_test.go"],
    embed = [":api"],
)
