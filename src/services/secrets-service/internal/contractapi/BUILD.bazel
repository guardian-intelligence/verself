load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//src/smithy/build:ir_go.bzl", "ir_contract_go")

ir_contract_go(
    name = "secrets_contract_go",
    out = "__generated_sources/secrets_contract.gen.go",
    ir = "//src/smithy/models/verself:secrets_public_ir",
    package = "contractapi",
)

write_source_files(
    name = "generated_sources",
    files = {
        "secrets_contract.gen.go": ":secrets_contract_go",
    },
    tags = ["manual"],
)

go_library(
    name = "contractapi",
    srcs = ["secrets_contract.gen.go"],
    importpath = "github.com/verself/secrets-service/internal/contractapi",
    visibility = ["//src/services/secrets-service:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":contractapi",
    visibility = ["//src/services/secrets-service:__subpackages__"],
)
