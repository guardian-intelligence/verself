# Owner-local nftables file.
# Owner-local nftables ruleset
# nftables ruleset secrets_service.
table inet verself_secrets_service
delete table inet verself_secrets_service

table inet verself_secrets_service {
    chain input {
        type filter hook input priority filter; policy accept;

        tcp dport 20000-32000 iifname != "lo" drop
    }
}
