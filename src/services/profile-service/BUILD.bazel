# gazelle:prefix github.com/verself/profile-service

load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks(
    extra_srcs = [
        "//src/services/profile-service/internal/routecatalog:profile_internal_route_catalog_json",
        "//src/services/profile-service/internal/routecatalog:profile_route_catalog_json",
    ],
    package_setup = """
install_route_catalog() {
    src="$$execroot/$$1"
    dst="$$2"
    if [ "$$(realpath -m "$$src")" = "$$(realpath -m "$$dst")" ]; then
        return 0
    fi
    dir="$$(dirname "$$dst")"
    base="$$(basename "$$dst")"
    mkdir -p "$$dir"
    tmp="$$(mktemp "$$dir/.$$base.XXXXXX")"
    install -m 0644 "$$src" "$$tmp"
    mv "$$tmp" "$$dst"
}
install_route_catalog "$(location //src/services/profile-service/internal/routecatalog:profile_internal_route_catalog_json)" internal/routecatalog/profile-internal.route-catalog.json
install_route_catalog "$(location //src/services/profile-service/internal/routecatalog:profile_route_catalog_json)" internal/routecatalog/profile.route-catalog.json
""",
)

spire_identity(
    name = "spiffe_identity",
    component = "profile_service",
    entry_id = "verself-profile-service",
    key = "profile_service.default",
    path = "/svc/profile-service",
    user = "profile_service",
    visibility = ["//src/infrastructure-components/spire:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/services/profile-service/cmd/profile-service:profile-service_nomad_artifact": "profile-service",
    },
    component = "profile_service",
    digest_inputs = [":deploy_declarations"],
    job_id = "profile-service",
    job_spec = "nomad.hcl",
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
