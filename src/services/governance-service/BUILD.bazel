# gazelle:prefix github.com/verself/governance-service

load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks()

spire_identity(
    name = "spiffe_identity",
    component = "governance_service",
    entry_id = "verself-governance-service",
    key = "governance_service.default",
    path = "/svc/governance-service",
    user = "governance_service",
    visibility = ["//src/bootstrap:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/services/governance-service/cmd/governance-service:governance-service_nomad_artifact": "governance-service",
    },
    component = "governance_service",
    digest_inputs = [":deploy_declarations"],
    job_id = "governance-service",
    job_spec = "nomad.hcl",
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
