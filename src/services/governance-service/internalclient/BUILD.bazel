load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//src/smithy/build:ir_sdk.bzl", "ir_sdk_go")

ir_sdk_go(
    name = "internal_transport_go",
    out = "__generated_sources/client.gen.go",
    ir = "//src/smithy/models/verself:governance_internal_ir",
    package = "governanceinternalclient",
)

write_source_files(
    name = "generated_sources",
    files = {
        "client.gen.go": ":internal_transport_go",
    },
    tags = ["manual"],
)

go_library(
    name = "internalclient",
    srcs = ["client.gen.go"],
    importpath = "github.com/verself/governance-service/internalclient",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":internalclient",
    visibility = ["//visibility:public"],
)
