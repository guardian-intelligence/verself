load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//src/smithy/build:ir_go.bzl", "ir_contract_go")

ir_contract_go(
    name = "governance_internal_contract_go",
    out = "__generated_sources/governance_internal_contract.gen.go",
    binding = "Internal",
    ir = "//src/smithy/models/verself:governance_internal_ir",
    package = "internalcontractapi",
)

write_source_files(
    name = "generated_sources",
    files = {
        "governance_internal_contract.gen.go": ":governance_internal_contract_go",
    },
    tags = ["manual"],
)

go_library(
    name = "internalcontractapi",
    srcs = ["governance_internal_contract.gen.go"],
    importpath = "github.com/verself/governance-service/internal/internalcontractapi",
    visibility = ["//src/services/governance-service:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":internalcontractapi",
    visibility = ["//src/services/governance-service:__subpackages__"],
)
