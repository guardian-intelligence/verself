load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "auth.go",
        "errors.go",
        "internal.go",
        "internal_openapi.go",
        "openapi.go",
        "policy.go",
        "routes.go",
    ],
    importpath = "github.com/verself/governance-service/internal/api",
    visibility = ["//src/services/governance-service:__subpackages__"],
    deps = [
        "//src/services/governance-service/internal/contractapi",
        "//src/services/governance-service/internal/governance",
        "//src/services/governance-service/internal/internalcontractapi",
        "//src/services/service-runtime/go/auth",
        "//src/services/service-runtime/go/humaapi",
        "//src/services/service-runtime/go/iam",
        "//src/services/service-runtime/go/requestmeta",
        "//src/services/service-runtime/go/workload",
        "@com_github_danielgtaylor_huma_v2//:huma",
        "@com_github_danielgtaylor_huma_v2//adapters/humago",
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "api_test",
    srcs = [
        "errors_test.go",
        "policy_test.go",
    ],
    embed = [":api"],
    deps = [
        "//src/services/service-runtime/go/auth",
        "//src/services/service-runtime/go/iam",
    ],
)
