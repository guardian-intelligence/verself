load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ocsf",
    srcs = [
        "api_activity.go",
        "builder.go",
    ],
    importpath = "github.com/verself/governance-service/internal/ocsf",
    visibility = ["//src/services/governance-service:__subpackages__"],
    deps = [
        "@com_github_google_uuid//:uuid",
        "@com_github_telophasehq_go_ocsf//ocsf/v1_5_0",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

alias(
    name = "go_default_library",
    actual = ":ocsf",
    visibility = ["//src/services/governance-service:__subpackages__"],
)

go_test(
    name = "ocsf_test",
    srcs = ["builder_test.go"],
    embed = [":ocsf"],
    deps = ["@com_github_google_uuid//:uuid"],
)
