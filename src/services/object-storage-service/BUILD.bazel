# gazelle:prefix github.com/verself/object-storage-service

load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks()

spire_identity(
    name = "spiffe_identity_service",
    component = "object_storage_service",
    entry_id = "verself-object-storage-service",
    key = "object_storage_service.service",
    path = "/svc/object-storage-service",
    uid_policy_kind = "fixed",
    uid_policy_value = 960,
    user = "object_storage_service",
    visibility = ["//src/host:__pkg__"],
)

spire_identity(
    name = "spiffe_identity_admin",
    component = "object_storage_service",
    entry_id = "verself-object-storage-admin",
    group = "object_storage_service",
    key = "object_storage_service.admin",
    path = "/svc/object-storage-admin",
    uid_policy_kind = "fixed",
    uid_policy_value = 961,
    user = "object_storage_admin",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/services/object-storage-service/cmd/object-storage-service:object-storage-service_nomad_artifact": "object-storage-service",
    },
    component = "object_storage_service",
    digest_inputs = [":deploy_declarations"],
    job_id = "object-storage-service",
    job_spec = "nomad.hcl",
    requires = [
        "clickhouse:migrations",
        "garage:admin",
        "garage:s3",
        "nomad:job:secrets-service",
        "object-storage:credentials",
        "postgres:server",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
