load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "schema",
    srcs = ["embed.go"],
    embedsrcs = ["verself.zed"],
    importpath = "github.com/verself/iam-service/schema",
    visibility = ["//src/services/iam-service:__subpackages__"],
)

filegroup(
    name = "zed",
    srcs = ["verself.zed"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "zed_cli_binary",
    srcs = ["@server_tools//tools/zed"],
    outs = ["zed.bin"],
    cmd = """
install -m 0755 "$(location @server_tools//tools/zed)" "$@"
""",
)

go_test(
    name = "schema_test",
    size = "small",
    srcs = ["schema_test.go"],
    data = [
        "verself.zed",
        ":zed_cli_binary",
    ],
    embed = [":schema"],
)
