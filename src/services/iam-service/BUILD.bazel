# gazelle:prefix github.com/verself/iam-service

load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks()

spire_identity(
    name = "spiffe_identity",
    component = "iam_service",
    entry_id = "verself-iam-service",
    key = "iam_service.default",
    path = "/svc/iam-service",
    user = "iam_service",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/services/iam-service/cmd/iam-service:iam-service_nomad_artifact": "iam-service",
    },
    component = "iam_service",
    digest_inputs = [":deploy_declarations"],
    job_id = "iam-service",
    job_spec = "nomad.hcl",
    requires = [
        "auth:control-plane",
        "clickhouse:migrations",
        "nomad:job:spicedb",
        "postgres:server",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
