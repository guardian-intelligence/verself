# nftables ruleset iam_service.
table inet verself_iam_service
delete table inet verself_iam_service

table inet verself_iam_service {
    chain input {
        type filter hook input priority filter; policy accept;

        tcp dport 20000-32000 iifname != "lo" drop
    }
}
