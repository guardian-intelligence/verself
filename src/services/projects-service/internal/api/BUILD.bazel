load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "contract.go",
        "errors.go",
        "internal_openapi.go",
        "openapi.go",
        "operations.go",
        "policy.go",
        "routes.go",
        "safeconv.go",
        "service.go",
    ],
    importpath = "github.com/verself/projects-service/internal/api",
    visibility = ["//src/services/projects-service:__subpackages__"],
    deps = [
        "//src/services/projects-service/internal/contractapi",
        "//src/services/projects-service/internal/internalcontractapi",
        "//src/services/projects-service/internal/projects",
        "//src/services/service-runtime/go/auth",
        "//src/services/service-runtime/go/humaapi",
        "//src/services/service-runtime/go/iam",
        "//src/services/service-runtime/go/workload",
        "@com_github_danielgtaylor_huma_v2//:huma",
        "@com_github_danielgtaylor_huma_v2//adapters/humago",
        "@com_github_google_uuid//:uuid",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

alias(
    name = "go_default_library",
    actual = ":api",
    visibility = ["//src/services/projects-service:__subpackages__"],
)

go_test(
    name = "api_test",
    srcs = ["contract_test.go"],
    embed = [":api"],
    deps = [
        "//src/services/projects-service/internal/contractapi",
        "//src/services/projects-service/internal/internalcontractapi",
        "//src/services/projects-service/internal/projects",
        "@com_github_danielgtaylor_huma_v2//:huma",
    ],
)
