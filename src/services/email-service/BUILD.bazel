# gazelle:prefix github.com/verself/email-service

load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks()

spire_identity(
    name = "spiffe_identity",
    component = "email_service",
    entry_id = "verself-email-service",
    key = "email_service.default",
    path = "/svc/email-service",
    user = "email_service",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/services/email-service/cmd/email-service:email-service_nomad_artifact": "email-service",
    },
    component = "email_service",
    digest_inputs = [":deploy_declarations"],
    job_id = "email-service",
    job_spec = "nomad.hcl",
    requires = [
        "email:resend-sending-key",
        "openbao:api",
        "postgres:server",
        "stalwart:http",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)

nomad_component(
    name = "resend_keys_nomad_component",
    artifacts = {
        "//src/services/email-service/cmd/email-service:email-service_nomad_artifact": "email-service-resend-keys",
    },
    component = "email_service_resend_keys",
    deploy_phase = "platform",
    digest_inputs = [":deploy_declarations"],
    job_id = "email-service-resend-keys",
    job_spec = "resend-keys.nomad.hcl",
    provides = ["email:resend-sending-key"],
    requires = ["openbao:api"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
