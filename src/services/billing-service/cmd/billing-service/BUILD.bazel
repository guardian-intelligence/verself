load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//src/tools/deployment/nomad:artifact.bzl", "nomad_binary_artifact")

go_library(
    name = "billing-service_lib",
    srcs = [
        "guardian_config.go",
        "main.go",
        "recover.go",
    ],
    importpath = "github.com/verself/billing-service/cmd/billing-service",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/billing-service/internal/billing",
        "//src/services/billing-service/internal/billing/ledger",
        "//src/services/billing-service/internal/billingapi",
        "//src/services/billing-service/migrations",
        "//src/services/iam-service/client",
        "//src/services/secrets-service/internalclient",
        "//src/services/service-runtime/go/auth",
        "//src/services/service-runtime/go/envconfig",
        "//src/services/service-runtime/go/httpserver",
        "//src/services/service-runtime/go/workload",
        "//src/tools/observability/go/otel",
        "@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_stripe_stripe_go_v85//:stripe-go",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
    ],
)

go_binary(
    name = "billing-service",
    embed = [":billing-service_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "billing-service_test",
    srcs = ["main_test.go"],
    embed = [":billing-service_lib"],
    deps = ["//src/services/service-runtime/go/workload"],
)

nomad_binary_artifact(
    name = "billing-service_nomad_artifact",
    binary = ":billing-service",
    output = "billing-service",
)
