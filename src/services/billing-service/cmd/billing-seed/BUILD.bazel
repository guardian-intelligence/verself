load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "billing-seed_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/billing-service/cmd/billing-seed",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/billing-service/internal/billing",
        "//src/services/billing-service/internal/billing/ledger",
        "//src/services/service-runtime/go/envconfig",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_binary(
    name = "billing-seed",
    embed = [":billing-seed_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "billing-seed_test",
    size = "medium",
    srcs = ["seed_integration_test.go"],
    embed = [":billing-seed_lib"],
    tags = [
        "external",
        "integration",
        "no-sandbox",
        "postgres",
    ],
    deps = [
        "//src/services/billing-service/migrations",
        "//src/services/service-runtime/go/pgtest",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
