load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:ignore

go_library(
    name = "workload",
    srcs = [
        "catalog.go",
        "dialer.go",
        "openbao.go",
        "resolver.go",
        "tls_external.go",
        "workload.go",
    ],
    importpath = "github.com/verself/service-runtime/workload",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//spiffetls/tlsconfig",
        "@com_github_spiffe_go_spiffe_v2//svid/jwtsvid",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "workload_test",
    srcs = [
        "dialer_test.go",
        "resolver_test.go",
    ],
    embed = [":workload"],
)
