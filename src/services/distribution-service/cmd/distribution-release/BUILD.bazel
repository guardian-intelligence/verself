load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "distribution-release_lib",
    srcs = [
        "dispatch.go",
        "main.go",
        "publish.go",
        "ssh_forward.go",
    ],
    importpath = "github.com/verself/distribution-service/cmd/distribution-release",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/distribution-service/internalclient",
        "//src/services/service-runtime/go/workload",
        "@org_golang_x_crypto//ssh",
        "@org_golang_x_crypto//ssh/agent",
    ],
)

go_binary(
    name = "distribution-release",
    embed = [":distribution-release_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "distribution-release_test",
    srcs = ["main_test.go"],
    embed = [":distribution-release_lib"],
)
