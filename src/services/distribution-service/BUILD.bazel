# gazelle:prefix github.com/verself/distribution-service

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks()

exports_files(["tools.lock.json"])

pkg_tar(
    name = "release_tools_artifact",
    out = "distribution-release-tools.tar",
    files = {
        "@distribution_release_tools//tools/cargo-about": "bin/cargo-about",
        "@distribution_release_tools//tools/cosign": "bin/cosign",
        "@distribution_release_tools//tools/oras": "bin/oras",
        "@distribution_release_tools//tools/release-plz": "bin/release-plz",
        "@distribution_release_tools//tools/syft": "bin/syft",
    },
    modes = {
        "bin/cargo-about": "0755",
        "bin/cosign": "0755",
        "bin/oras": "0755",
        "bin/release-plz": "0755",
        "bin/syft": "0755",
    },
    visibility = ["//visibility:public"],
)

spire_identity(
    name = "spiffe_identity",
    component = "distribution_service",
    entry_id = "verself-distribution-service",
    key = "distribution_service.default",
    path = "/svc/distribution-service",
    user = "distribution_service",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/services/distribution-service/cmd/distribution-service:distribution-service_nomad_artifact": "distribution-service",
    },
    component = "distribution_service",
    digest_inputs = [":deploy_declarations"],
    job_id = "distribution-service",
    job_spec = "nomad.hcl",
    requires = [
        "clickhouse:migrations",
        "postgres:server",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
