load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "releaseattest",
    srcs = [
        "types.go",
        "verifier.go",
    ],
    importpath = "github.com/verself/distribution-service/internal/releaseattest",
    visibility = ["//src/services/distribution-service:__subpackages__"],
    deps = [
        "//src/tools/releaseattest",
        "@com_github_google_go_attestation//attest",
    ],
)

go_test(
    name = "releaseattest_test",
    srcs = ["verifier_test.go"],
    embed = [":releaseattest"],
    deps = ["//src/tools/releaseattest"],
)
