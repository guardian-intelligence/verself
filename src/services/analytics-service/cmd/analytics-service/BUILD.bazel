load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "analytics-service_lib",
    srcs = [
        "main.go",
        "query.go",
    ],
    importpath = "github.com/verself/analytics-service/cmd/analytics-service",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/analytics-service/internal/analytics",
        "//src/services/iam-service/client",
        "//src/services/service-runtime/go/auth",
        "//src/services/service-runtime/go/envconfig",
        "//src/services/service-runtime/go/httpserver",
        "//src/services/service-runtime/go/iam",
        "//src/services/service-runtime/go/workload",
        "//src/tools/observability/go/otel",
        "@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
    ],
)

go_binary(
    name = "analytics-service",
    embed = [":analytics-service_lib"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "analytics_service_layer",
    files = {
        ":analytics-service": "usr/local/bin/analytics-service",
    },
    modes = {
        "usr/local/bin/analytics-service": "0755",
    },
)

oci_image(
    name = "analytics_service_image_linux_amd64",
    base = "@ubuntu_noble_base_linux_amd64",
    entrypoint = ["/usr/local/bin/analytics-service"],
    tars = [
        "//src/tools/deployment/oci:ubuntu_ca_certificates_layer",
        ":analytics_service_layer",
    ],
)

oci_image_index(
    name = "analytics_service_image",
    images = [":analytics_service_image_linux_amd64"],
)

oci_load(
    name = "analytics_service_image_load",
    format = "oci",
    image = ":analytics_service_image",
    repo_tags = ["verself/analytics-service:phase1"],
)

filegroup(
    name = "analytics_service_image_archive",
    srcs = [":analytics_service_image_load"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)
