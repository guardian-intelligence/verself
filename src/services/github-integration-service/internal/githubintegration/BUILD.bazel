load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "githubintegration",
    srcs = [
        "delivery_failure.go",
        "events.go",
        "github_api.go",
        "idempotency.go",
        "job_shape.go",
        "onboarding.go",
        "payloads.go",
        "provider_surface.go",
        "runner_problem.go",
        "runner_terminalization.go",
        "sandbox.go",
        "service.go",
        "webhook_problem.go",
    ],
    importpath = "github.com/verself/github-integration-service/internal/githubintegration",
    visibility = ["//src/services/github-integration-service:__subpackages__"],
    deps = [
        "//src/services/github-integration-service/internal/store",
        "//src/services/sandbox-rental-service/client",
        "//src/services/secrets-service/client",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
        "@com_github_golang_jwt_jwt_v5//:jwt",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "githubintegration_test",
    srcs = ["service_test.go"],
    embed = [":githubintegration"],
    deps = [
        "//src/services/sandbox-rental-service/client",
        "@com_github_jackc_pgx_v5//pgtype",
    ],
)
