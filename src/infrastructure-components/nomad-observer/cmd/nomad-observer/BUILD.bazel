load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//src/tools/deployment/nomad:artifact.bzl", "nomad_binary_artifact")

go_library(
    name = "nomad-observer_lib",
    srcs = [
        "fleet.go",
        "main.go",
        "oci_attestation.go",
        "podman_measurement.go",
    ],
    importpath = "github.com/verself/infrastructure-components/nomad-observer/cmd/nomad-observer",
    visibility = ["//visibility:private"],
    deps = [
        "//src/services/distribution-service/internalclient",
        "//src/services/service-runtime/go/workload",
        "//src/tools/observability/go/otel",
        "@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go",
        "@com_github_hashicorp_nomad_api//:api",
        "@com_github_opencontainers_go_digest//:go-digest",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_test(
    name = "nomad-observer_test",
    srcs = ["oci_attestation_test.go"],
    embed = [":nomad-observer_lib"],
    deps = [
        "@com_github_hashicorp_nomad_api//:api",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_binary(
    name = "nomad-observer",
    embed = [":nomad-observer_lib"],
    visibility = ["//visibility:public"],
)

nomad_binary_artifact(
    name = "nomad-observer_nomad_artifact",
    binary = ":nomad-observer",
    output = "nomad-observer",
)
