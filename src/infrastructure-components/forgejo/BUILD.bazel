load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

deploy_declarations(visibility = ["//visibility:public"])

exports_files(["tools.lock.json"])

genrule(
    name = "git_bin",
    srcs = ["@forgejo_tool_git_deb//file"],
    outs = ["git"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @forgejo_tool_git_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/git" "$@"
""",
)

genrule(
    name = "sqlite3_bin",
    srcs = ["@forgejo_tool_sqlite3_deb//file"],
    outs = ["sqlite3"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @forgejo_tool_sqlite3_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/sqlite3" "$@"
""",
)

pkg_tar(
    name = "host_install",
    out = "forgejo-host-install.tar",
    files = {
        "@forgejo_tools//tools/forgejo": "opt/verself/profile/bin/forgejo",
        ":git_bin": "opt/verself/profile/bin/git",
        ":sqlite3_bin": "opt/verself/profile/bin/sqlite3",
    },
    modes = {
        "opt/verself/profile/bin/forgejo": "0755",
        "opt/verself/profile/bin/git": "0755",
        "opt/verself/profile/bin/sqlite3": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "forgejo",
    deploy_phase = "platform",
    digest_inputs = [
        ":deploy_declarations",
        ":host_install",
    ],
    job_id = "forgejo",
    job_spec = "nomad.hcl",
    provides = ["forgejo:http"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
