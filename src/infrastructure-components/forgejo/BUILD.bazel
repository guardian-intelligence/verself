load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

exports_files(["tools.lock.json"])

genrule(
    name = "git_bin",
    srcs = ["@forgejo_tool_git_deb//file"],
    outs = ["git"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @forgejo_tool_git_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/git" "$@"
""",
)

genrule(
    name = "sqlite3_bin",
    srcs = ["@forgejo_tool_sqlite3_deb//file"],
    outs = ["sqlite3"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @forgejo_tool_sqlite3_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/sqlite3" "$@"
""",
)

pkg_tar(
    name = "runtime_artifact",
    out = "forgejo-runtime.tar",
    files = {
        "//src/infrastructure-components/forgejo/cmd/forgejo-recover:forgejo-recover": "bin/forgejo-recover",
        "@forgejo_tools//tools/forgejo": "bin/forgejo",
        ":git_bin": "bin/git",
        ":sqlite3_bin": "bin/sqlite3",
    },
    modes = {
        "bin/forgejo": "0755",
        "bin/forgejo-recover": "0755",
        "bin/git": "0755",
        "bin/sqlite3": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)
