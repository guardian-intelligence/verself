load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

deploy_declarations(visibility = ["//visibility:public"])

exports_files(["tools.lock.json"])

genrule(
    name = "sqlite3_bin",
    srcs = ["@forgejo_tool_sqlite3_deb//file"],
    outs = ["sqlite3"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @forgejo_tool_sqlite3_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/sqlite3" "$@"
""",
)

pkg_tar(
    name = "runtime_artifact",
    out = "forgejo-runtime.tar",
    files = {
        "//src/infrastructure-components/forgejo/cmd/forgejo-node-runner:forgejo-node-runner": "bin/forgejo-node-runner",
        "@forgejo_tools//tools/forgejo": "bin/forgejo",
        "//src/host:git_bin": "bin/git",
        ":sqlite3_bin": "bin/sqlite3",
    },
    modes = {
        "bin/forgejo-node-runner": "0755",
        "bin/forgejo": "0755",
        "bin/git": "0755",
        "bin/sqlite3": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "forgejo-runtime",
    },
    component = "forgejo",
    digest_inputs = [":deploy_declarations"],
    job_id = "forgejo",
    job_spec = "nomad.hcl",
    provides = ["forgejo:http"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
