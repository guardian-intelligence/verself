load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/infrastructure-components/spire:identity.bzl", "spire_identity")

exports_files(["tools.lock.json"])

filegroup(
    name = "guardian_crd",
    srcs = ["guardian/v1alpha1/schema.cue"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "runtime_artifact",
    out = "otelcol-runtime.tar",
    files = {
        "@clickhouse_tools//tools/clickhouse": "bin/clickhouse",
        "@otelcol_tools//tools/otelcol-contrib": "bin/otelcol-contrib",
        "@otelcol_tools//tools/spiffe-helper": "bin/spiffe-helper",
    },
    modes = {
        "bin/clickhouse": "0755",
        "bin/otelcol-contrib": "0755",
        "bin/spiffe-helper": "0755",
    },
    symlinks = {
        "bin/clickhouse-client": "clickhouse",
    },
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "config_artifact",
    out = "otelcol-config.tar",
    files = {
        "files/otelcol-clickhouse-spiffe-helper.conf": "config/clickhouse-spiffe-helper.conf",
        "files/otelcol-config.yaml": "config/config.yaml",
    },
    modes = {
        "config/clickhouse-spiffe-helper.conf": "0640",
        "config/config.yaml": "0640",
    },
)

spire_identity(
    name = "spiffe_identity",
    component = "otelcol",
    entry_id = "verself-otelcol",
    key = "otelcol.default",
    path = "/svc/otelcol",
    restart_units = [],
    user = "otelcol",
    visibility = ["//src/infrastructure-components/spire:__pkg__"],
)
