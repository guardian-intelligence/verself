load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

spire_identity(
    name = "spiffe_identity",
    component = "otelcol",
    entry_id = "verself-otelcol",
    key = "otelcol.default",
    path = "/svc/otelcol",
    restart_units = [],
    user = "otelcol",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "otelcol",
    deploy_phase = "pre_artifact",
    job_id = "otelcol",
    job_spec = "nomad.hcl",
    provides = ["otelcol:otlp"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
