load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

exports_files(["tools.lock.json"])

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

pkg_tar(
    name = "runtime_artifact",
    out = "otelcol-runtime.tar",
    files = {
        "@clickhouse_tools//tools/clickhouse": "bin/clickhouse",
        "@otelcol_tools//tools/otelcol-contrib": "bin/otelcol-contrib",
        "@otelcol_tools//tools/spiffe-helper": "bin/spiffe-helper",
    },
    modes = {
        "bin/clickhouse": "0755",
        "bin/otelcol-contrib": "0755",
        "bin/spiffe-helper": "0755",
    },
    symlinks = {
        "bin/clickhouse-client": "clickhouse",
    },
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "config_artifact",
    out = "otelcol-config.tar",
    files = {
        "files/otelcol-clickhouse-spiffe-helper.conf": "config/clickhouse-spiffe-helper.conf",
        "files/otelcol-config.yaml": "config/config.yaml",
    },
    modes = {
        "config/clickhouse-spiffe-helper.conf": "0640",
        "config/config.yaml": "0640",
    },
)

spire_identity(
    name = "spiffe_identity",
    component = "otelcol",
    entry_id = "verself-otelcol",
    key = "otelcol.default",
    path = "/svc/otelcol",
    restart_units = [],
    user = "otelcol",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":config_artifact": "otelcol-config",
        ":runtime_artifact": "otelcol-runtime",
    },
    component = "otelcol",
    deploy_phase = "platform",
    digest_inputs = [":deploy_declarations"],
    job_id = "otelcol",
    job_spec = "nomad.hcl",
    provides = ["otelcol:otlp"],
    requires = [
        "artifact-origin",
        "postgres:server",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
