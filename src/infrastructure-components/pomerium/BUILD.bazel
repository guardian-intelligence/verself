load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")

deploy_declarations(visibility = ["//visibility:public"])

exports_files(["tools.lock.json"])

pkg_tar(
    name = "host_install",
    out = "pomerium-host-install.tar",
    files = {
        "@pomerium_tools//tools/pomerium": "opt/verself/profile/bin/pomerium",
    },
    modes = {
        "opt/verself/profile/bin/pomerium": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//src/infrastructure-components:__pkg__",
        "//src/tools/site-preflight:__pkg__",
    ],
)
