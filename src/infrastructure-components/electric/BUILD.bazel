# gazelle:prefix github.com/verself/infrastructure-components/electric

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

exports_files(["tools.lock.json"])

deploy_declarations(visibility = ["//visibility:public"])

pkg_tar(
    name = "runtime_artifact",
    out = "electric-runtime.tar",
    files = {
        "//src/infrastructure-components/electric/cmd/electric-nomad-runner:electric-nomad-runner": "bin/electric-nomad-runner",
        "@electric_tools//tools/containerd": "bin/containerd",
        "@electric_tools//tools/containerd-shim-runc-v2": "bin/containerd-shim-runc-v2",
        "@electric_tools//tools/ctr": "bin/ctr",
        "@electric_tools//tools/runc": "bin/runc",
    },
    modes = {
        "bin/containerd": "0755",
        "bin/containerd-shim-runc-v2": "0755",
        "bin/ctr": "0755",
        "bin/electric-nomad-runner": "0755",
        "bin/runc": "0755",
    },
)

nomad_component(
    name = "containerd_nomad_component",
    artifacts = {
        ":runtime_artifact": "electric-runtime",
    },
    component = "electric",
    deploy_phase = "platform",
    job_id = "electric-containerd",
    job_spec = "containerd.nomad.hcl",
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "electric-runtime",
    },
    component = "electric",
    deploy_phase = "product",
    digest_inputs = [
        ":deploy_declarations",
        "//src/services/iam-service:deploy_declarations",
        "//src/services/notifications-service:deploy_declarations",
        "//src/services/sandbox-rental-service:deploy_declarations",
    ],
    job_id = "electric",
    job_spec = "nomad.hcl",
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
