# gazelle:prefix github.com/verself/infrastructure-components/electric

load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/infrastructure-components/electric/cmd/electric-nomad-runner:electric-nomad-runner_nomad_artifact": "electric-nomad-runner",
    },
    component = "electric",
    deploy_phase = "platform",
    job_id = "electric",
    job_spec = "nomad.hcl",
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
