load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

exports_files(["tools.lock.json"])

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "runtime_artifact",
    out = "nats-runtime.tar",
    files = {
        "@nats_tools//tools/nats-server": "bin/nats-server",
        "@nats_tools//tools/spiffe-helper": "bin/spiffe-helper",
        "//src/infrastructure-components/nats/cmd/nats-recover:nats-recover": "bin/nats-recover",
    },
    modes = {
        "bin/nats-recover": "0755",
        "bin/nats-server": "0755",
        "bin/spiffe-helper": "0755",
    },
    visibility = ["//visibility:public"],
)

spire_identity(
    name = "spiffe_identity",
    component = "nats",
    entry_id = "verself-nats",
    key = "nats.default",
    path = "/svc/nats",
    restart_units = [],
    user = "nats",
    visibility = ["//src/infrastructure-components/spire:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "nats",
    deploy_phase = "platform",
    job_id = "nats",
    job_spec = "nomad.hcl",
    pre_artifacts = {
        ":runtime_artifact": "nats-runtime",
    },
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
