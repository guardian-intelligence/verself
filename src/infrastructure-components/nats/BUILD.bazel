load("//src/tools/deployment/components:substrate.bzl", "component_substrate_json")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

spire_identity(
    name = "spiffe_identity",
    component = "nats",
    entry_id = "verself-nats",
    key = "nats.default",
    path = "/svc/nats",
    restart_units = [],
    user = "nats",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "nats",
    deploy_phase = "platform",
    job_id = "nats",
    job_spec = "nomad.hcl",
    provides = ["nats:client"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)

component_substrate_json(
    name = "component_substrate",
    srcs = ["nftables/nats.nft"],
    definition_json = """
{
  "component": "nats",
  "kind": "platform_component",
  "nftables_rulesets": [
    {
      "name": "nats",
      "source": "src/infrastructure-components/nats/nftables/nats.nft",
      "table": "verself_nats",
      "target": "/etc/nftables.d/nats.nft"
    }
  ],
  "nomad_component_label": "//src/infrastructure-components/nats:nomad_component",
  "order": 25,
  "postgres": {},
  "workload": {
    "directories": [
      {"group": "nats", "mode": "0750", "owner": "root", "path": "/etc/nats"},
      {"group": "nats", "mode": "0750", "owner": "nats", "path": "/var/lib/nats"},
      {"group": "nats", "mode": "0750", "owner": "nats", "path": "/var/lib/nats/jetstream"}
    ],
    "units": [{"name": "nats", "supplementary_groups": ["spire_workload"], "user": "nats"}]
  }
}
""",
    visibility = ["//src/host:__pkg__"],
)
