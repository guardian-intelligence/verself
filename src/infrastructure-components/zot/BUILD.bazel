# gazelle:prefix github.com/verself/infrastructure-components/zot

exports_files(["tools.lock.json"])

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//src/infrastructure-components:__pkg__",
        "//src/tools/site-preflight:__pkg__",
    ],
)
