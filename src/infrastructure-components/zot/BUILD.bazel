# gazelle:prefix github.com/verself/infrastructure-components/zot

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

exports_files(["tools.lock.json"])

pkg_tar(
    name = "runtime_artifact",
    out = "zot-runtime.tar",
    files = {
        "@zot_tools//tools/zot": "bin/zot",
        "//src/infrastructure-components/zot/cmd/zot-htpasswd:zot-htpasswd": "bin/zot-htpasswd",
        "//src/infrastructure-components/zot/cmd/zot-node-runner:zot-node-runner": "bin/zot-node-runner",
    },
    modes = {
        "bin/zot": "0755",
        "bin/zot-htpasswd": "0755",
        "bin/zot-node-runner": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "zot-runtime",
    },
    component = "zot",
    job_id = "zot",
    job_spec = "nomad.hcl",
    provides = ["zot:http"],
    requires = ["host:credstore"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
