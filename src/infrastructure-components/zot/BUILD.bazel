# gazelle:prefix github.com/verself/infrastructure-components/zot

load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

ZOT_RUNTIME_ROOT = "opt/verself/zot"

exports_files([
    "nomad.hcl",
    "tools.lock.json",
])

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)

# Runtime layer: the upstream zot registry binary plus the in-image config
# renderer, laid at /opt/verself/zot/usr/bin to mirror the postgresql runtime
# prefix. Both are referenced by constant paths from nomad.hcl; the image digest
# IS the runtime version, so there is no releases/current indirection.
genrule(
    name = "zot_runtime",
    srcs = [
        "@zot_tools//tools/zot",
        "//src/infrastructure-components/zot/cmd/zot-config",
    ],
    outs = ["zot_runtime.tar"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
mkdir -p "$$tmp/{root}/usr/bin"
install -m 0755 "$(location @zot_tools//tools/zot)" "$$tmp/{root}/usr/bin/zot"
install -m 0755 "$(location //src/infrastructure-components/zot/cmd/zot-config)" "$$tmp/{root}/usr/bin/zot-config"
chmod -R a+rX "$$tmp"
tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 2000-01-01' -cf "$@" -C "$$tmp" .
""".format(
        root = ZOT_RUNTIME_ROOT,
    ),
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

# Identity layer: a self-contained passwd/group so podman's user=\"zot\" resolves
# inside the container (the base ubuntu has no zot user) and durable host
# bind-mount ownership is deterministic across rebuilds. uid/gid 1001 is fixed
# and shared by the image, the nomad.hcl bind-mount, and the raw_exec
# host pre-create. Overwrites the base /etc/passwd+group on purpose: the
# container runs nothing but the zot registry.
pkg_tar(
    name = "zot_identity_layer",
    files = {
        "image/passwd": "etc/passwd",
        "image/group": "etc/group",
    },
    modes = {
        "etc/passwd": "0644",
        "etc/group": "0644",
    },
)

oci_image(
    name = "zot_image",
    base = "@ubuntu_noble_base_linux_amd64",
    tars = [
        ":zot_runtime",
        ":zot_identity_layer",
    ],
    visibility = ["//visibility:public"],
)

oci_load(
    name = "zot_image_load",
    image = ":zot_image",
    repo_tags = "image/zot.image-tags.txt",
)

filegroup(
    name = "zot_image_archive",
    srcs = [":zot_image_load"],
    output_group = "tarball",
    visibility = ["//visibility:public"],
)

genrule(
    name = "nomad_vars",
    srcs = [":zot_image_archive"],
    outs = ["nomad.vars.hcl"],
    cmd = """
set -euo pipefail
artifact="$(location :zot_image_archive)"
digest="$$(sha256sum "$$artifact" | awk '{print $$1}')"
printf 'zot_image_sha256 = "%s"\\n' "$$digest" > "$@"
""",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "fly_artifacts",
    srcs = [
        ":nomad_vars",
        ":zot_image_archive",
    ],
    visibility = ["//visibility:public"],
)
