# gazelle:prefix github.com/verself/infrastructure-components/zot

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

exports_files(["tools.lock.json"])

pkg_tar(
    name = "host_install",
    out = "zot-host-install.tar",
    files = {
        "@zot_tools//tools/zot": "opt/verself/profile/bin/zot",
        "//src/infrastructure-components/zot/cmd/zot-htpasswd:zot-htpasswd": "opt/verself/profile/bin/zot-htpasswd",
    },
    modes = {
        "opt/verself/profile/bin/zot": "0755",
        "opt/verself/profile/bin/zot-htpasswd": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "zot",
    deploy_phase = "platform",
    digest_inputs = [":host_install"],
    job_id = "zot",
    job_spec = "nomad.hcl",
    provides = ["zot:http"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
