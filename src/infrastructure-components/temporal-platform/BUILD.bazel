# gazelle:prefix github.com/verself/temporal-platform

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/infrastructure-components/spire:identity.bzl", "spire_identity")
load("//src/services/deployment-service:declarations.bzl", "deploy_declarations")
load("//src/tools/build:go_module_checks.bzl", "go_module_checks")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks()

exports_files(["tools.lock.json"])

pkg_tar(
    name = "runtime_artifact",
    out = "temporal-runtime.tar",
    files = {
        "@temporal_tools//tools/tdbg": "bin/tdbg",
        "@temporal_tools//tools/temporal-server": "bin/temporal-server",
        "@temporal_tools//tools/temporal-sql-tool": "bin/temporal-sql-tool",
        "//src/infrastructure-components/temporal-platform/cmd/temporal-bootstrap:temporal-bootstrap": "bin/temporal-bootstrap",
        "//src/infrastructure-components/temporal-platform/cmd/temporal-recover:temporal-recover": "bin/temporal-recover",
        "//src/infrastructure-components/temporal-platform/cmd/temporal-schema:temporal-schema": "bin/temporal-schema",
        "//src/infrastructure-components/temporal-platform/cmd/verself-temporal-server:verself-temporal-server": "bin/verself-temporal-server",
    },
    modes = {
        "bin/tdbg": "0755",
        "bin/temporal-bootstrap": "0755",
        "bin/temporal-recover": "0755",
        "bin/temporal-schema": "0755",
        "bin/temporal-server": "0755",
        "bin/temporal-sql-tool": "0755",
        "bin/verself-temporal-server": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)

spire_identity(
    name = "spiffe_identity_server",
    component = "temporal",
    entry_id = "verself-temporal-server",
    key = "temporal.server",
    path = "/svc/temporal-server",
    restart_units = ["temporal-server"],
    user = "temporal_server",
    visibility = ["//src/infrastructure-components/spire:__pkg__"],
)
