# gazelle:prefix github.com/verself/temporal-platform

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

deploy_declarations(visibility = ["//visibility:public"])

go_module_checks()

exports_files(["tools.lock.json"])

pkg_tar(
    name = "host_install",
    out = "temporal-host-install.tar",
    files = {
        "@temporal_tools//tools/tdbg": "opt/verself/profile/bin/tdbg",
        "@temporal_tools//tools/temporal-server": "opt/verself/profile/bin/temporal-server",
        "@temporal_tools//tools/temporal-sql-tool": "opt/verself/profile/bin/temporal-sql-tool",
        "//src/infrastructure-components/temporal-platform/cmd/temporal-bootstrap:temporal-bootstrap": "opt/verself/profile/bin/temporal-bootstrap",
        "//src/infrastructure-components/temporal-platform/cmd/temporal-schema:temporal-schema": "opt/verself/profile/bin/temporal-schema",
        "//src/infrastructure-components/temporal-platform/cmd/verself-temporal-server:verself-temporal-server": "opt/verself/profile/bin/verself-temporal-server",
    },
    modes = {
        "opt/verself/profile/bin/tdbg": "0755",
        "opt/verself/profile/bin/temporal-bootstrap": "0755",
        "opt/verself/profile/bin/temporal-schema": "0755",
        "opt/verself/profile/bin/temporal-server": "0755",
        "opt/verself/profile/bin/temporal-sql-tool": "0755",
        "opt/verself/profile/bin/verself-temporal-server": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

spire_identity(
    name = "spiffe_identity_server",
    component = "temporal",
    entry_id = "verself-temporal-server",
    key = "temporal.server",
    path = "/svc/temporal-server",
    restart_units = ["temporal-server"],
    user = "temporal_server",
    visibility = ["//src/host:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "temporal",
    deploy_phase = "platform",
    digest_inputs = [
        ":host_install",
        ":deploy_declarations",
    ],
    job_id = "temporal",
    job_spec = "nomad.hcl",
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
