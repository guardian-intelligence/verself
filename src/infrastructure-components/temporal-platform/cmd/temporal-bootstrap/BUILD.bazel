load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "temporal-bootstrap_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/temporal-platform/cmd/temporal-bootstrap",
    visibility = ["//visibility:private"],
    deps = [
        "//src/infrastructure-components/temporal-platform/internal/namespaceadmin",
        "//src/infrastructure-components/temporal-platform/sdkclient",
        "//src/tools/observability/go/otel",
    ],
)

go_binary(
    name = "temporal-bootstrap",
    embed = [":temporal-bootstrap_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "temporal-bootstrap_test",
    srcs = ["main_test.go"],
    embed = [":temporal-bootstrap_lib"],
)
