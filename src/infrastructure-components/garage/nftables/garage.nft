# Owner-local nftables file.
# nftables ruleset garage.
table inet verself_garage
delete table inet verself_garage

table inet verself_garage {
    chain input {
        type filter hook input priority filter; policy accept;

        tcp dport { 3900, 3901, 3903, 3910, 3911, 3913, 3920, 3921, 3923 } iifname != "lo" drop
    }
}
