load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

exports_files(["tools.lock.json"])

pkg_tar(
    name = "host_install",
    out = "garage-host-install.tar",
    files = {
        "@garage_tools//tools/garage": "opt/verself/profile/bin/garage",
    },
    modes = {
        "opt/verself/profile/bin/garage": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "garage",
    deploy_phase = "pre_artifact",
    digest_inputs = [":host_install"],
    job_id = "garage",
    job_spec = "nomad.hcl",
    provides = [
        "artifact-origin",
        "garage:s3",
        "garage:admin",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
