load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "grafana-recover_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/infrastructure-components/grafana/cmd/grafana-recover",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "grafana-recover",
    embed = [":grafana-recover_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "grafana-recover_test",
    srcs = ["main_test.go"],
    embed = [":grafana-recover_lib"],
)
