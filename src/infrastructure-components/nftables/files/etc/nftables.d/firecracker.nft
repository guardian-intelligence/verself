# Managed by Verself nftables component.
#!/usr/sbin/nft -f
# Firecracker guest networking: NAT egress plus guest-boundary forwarding.

table ip verself_firecracker
delete table ip verself_firecracker

table ip verself_firecracker {
    chain forward {
        type filter hook forward priority filter; policy drop;

        iifname "fc-tap-*" ip saddr 172.16.0.0/16 ip daddr 172.16.0.0/16 drop
        iifname "fc-tap-*" ip saddr 172.16.0.0/16 tcp dport 25 limit rate 10/minute log prefix "fc-smtp-block: "
        iifname "fc-tap-*" ip saddr 172.16.0.0/16 tcp dport 25 counter drop
        iifname "fc-tap-*" ip saddr 172.16.0.0/16 accept
        oifname "fc-tap-*" ip daddr 172.16.0.0/16 ct state established,related accept
        oifname "fc-tap-*" ip daddr 172.16.0.0/16 drop
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr 172.16.0.0/16 masquerade
    }
}
