load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "roles/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/infrastructure-components/zitadel/cmd/zitadel-setup-apply:zitadel-setup-apply_nomad_artifact": "zitadel-setup-apply",
    },
    component = "zitadel",
    deploy_phase = "platform",
    digest_inputs = [
        ":role_sources",
        "//src/host/binaries:host_profile_archives",
    ],
    job_id = "zitadel",
    job_spec = "nomad.hcl",
    provides = ["zitadel:http"],
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)

nomad_component(
    name = "auth_control_plane_nomad_component",
    artifacts = {
        "//src/infrastructure-components/zitadel/cmd/auth-control-plane-apply:auth-control-plane-apply_nomad_artifact": "auth-control-plane-apply",
    },
    component = "auth_control_plane",
    deploy_phase = "platform",
    job_id = "auth-control-plane",
    job_spec = "auth-control-plane.nomad.hcl",
    provides = ["auth:control-plane"],
    requires = ["zitadel:http"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
