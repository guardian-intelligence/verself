package(default_visibility = ["//visibility:public"])

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "*/defaults/**",
            "*/deploy/**",
            "*/files/**",
            "*/handlers/**",
            "*/meta/**",
            "*/migrations/**",
            "*/tasks/**",
            "*/templates/**",
            "*/vars/**",
        ],
        allow_empty = True,
    ) + [
        "//src/infrastructure-components/openbao:role_sources",
        "//src/infrastructure-components/pomerium:role_sources",
        "//src/infrastructure-components/zitadel:role_sources",
    ],
)
