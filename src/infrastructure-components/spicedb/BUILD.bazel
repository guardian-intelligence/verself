load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

deploy_declarations(visibility = ["//visibility:public"])

exports_files(["tools.lock.json"])

pkg_tar(
    name = "runtime_artifact",
    out = "spicedb-runtime.tar",
    files = {
        "@spicedb_tools//tools/spicedb": "bin/spicedb",
        "@spicedb_tools//tools/zed": "bin/zed",
    },
    modes = {
        "bin/spicedb": "0755",
        "bin/zed": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "spicedb-runtime",
    },
    component = "spicedb",
    deploy_phase = "platform",
    digest_inputs = [":deploy_declarations"],
    job_id = "spicedb",
    job_spec = "nomad.hcl",
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
