load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

exports_files(["tools.lock.json"])

pkg_tar(
    name = "runtime_artifact",
    out = "spicedb-runtime.tar",
    files = {
        "//src/infrastructure-components/spicedb/cmd/spicedb-recover:spicedb-recover": "bin/spicedb-recover",
        "@spicedb_tools//tools/spicedb": "bin/spicedb",
        "@spicedb_tools//tools/zed": "bin/zed",
    },
    modes = {
        "bin/spicedb-recover": "0755",
        "bin/spicedb": "0755",
        "bin/zed": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)
