genrule(
    name = "bao_bin",
    srcs = ["@openbao_tool_bao_deb//file"],
    outs = ["bao"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @openbao_tool_bao_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/bao" "$@"
""",
    visibility = ["//src/host:__pkg__"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)
