load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

genrule(
    name = "bao_bin",
    srcs = ["@openbao_tool_bao_deb//file"],
    outs = ["bao"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @openbao_tool_bao_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/bao" "$@"
""",
)

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "runtime_artifact",
    out = "openbao-runtime.tar",
    files = {
        ":bao_bin": "bin/bao",
        "//src/infrastructure-components/openbao/cmd/openbao-recover:openbao-recover": "bin/openbao-recover",
    },
    modes = {
        "bin/bao": "0755",
        "bin/openbao-recover": "0755",
    },
    visibility = ["//visibility:public"],
)

nomad_component(
    name = "nomad_component",
    component = "openbao",
    deploy_phase = "platform",
    job_id = "openbao",
    job_spec = "nomad.hcl",
    pre_artifacts = {
        ":runtime_artifact": "openbao-runtime",
    },
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
