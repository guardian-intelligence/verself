load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

genrule(
    name = "bao_bin",
    srcs = ["@openbao_tool_bao_deb//file"],
    outs = ["bao"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @openbao_tool_bao_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/bao" "$@"
""",
)

pkg_tar(
    name = "runtime_artifact",
    out = "openbao-runtime.tar",
    files = {
        ":bao_bin": "bin/bao",
        "//src/infrastructure-components/openbao/cmd/openbao-bootstrap:openbao-bootstrap": "bin/openbao-bootstrap",
    },
    modes = {
        "bin/bao": "0755",
        "bin/openbao-bootstrap": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "openbao-runtime",
    },
    component = "openbao",
    deploy_phase = "platform",
    job_id = "openbao",
    job_spec = "nomad.hcl",
    provides = ["openbao:api"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
