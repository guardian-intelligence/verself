load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

_RUNTIME_SECRET_DECLARATIONS = [
    "//src/infrastructure-components/electric:deploy_declarations",
    "//src/infrastructure-components/forgejo:deploy_declarations",
    "//src/infrastructure-components/grafana:deploy_declarations",
    "//src/infrastructure-components/stalwart:deploy_declarations",
    "//src/infrastructure-components/zitadel:deploy_declarations",
    "//src/integrations/cloudflare/r2-control-plane:deploy_declarations",
    "//src/services/billing-service:deploy_declarations",
    "//src/services/email-service:deploy_declarations",
    "//src/services/github-integration-service:deploy_declarations",
    "//src/services/governance-service:deploy_declarations",
    "//src/services/iam-service:deploy_declarations",
    "//src/services/object-storage-service:deploy_declarations",
    "//src/services/sandbox-rental-service:deploy_declarations",
    "//src/services/source-code-hosting-service:deploy_declarations",
]

genrule(
    name = "bao_bin",
    srcs = ["@openbao_tool_bao_deb//file"],
    outs = ["bao"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @openbao_tool_bao_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/bin/bao" "$@"
""",
)

genrule(
    name = "runtime_catalog_json",
    srcs = _RUNTIME_SECRET_DECLARATIONS,
    outs = ["openbao-runtime-catalog.json"],
    cmd = "$(location //src/services/deployment-service/cmd/openbao-runtime-catalog) --out=$@ $(SRCS)",
    tools = ["//src/services/deployment-service/cmd/openbao-runtime-catalog"],
)

pkg_tar(
    name = "runtime_artifact",
    out = "openbao-runtime.tar",
    files = {
        ":bao_bin": "bin/bao",
        "//src/infrastructure-components/openbao/cmd/openbao-up:openbao-up": "bin/openbao-up",
        ":runtime_catalog_json": "etc/openbao-runtime-catalog.json",
    },
    modes = {
        "bin/bao": "0755",
        "etc/openbao-runtime-catalog.json": "0644",
        "bin/openbao-up": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "openbao-runtime",
    },
    component = "openbao",
    deploy_phase = "platform",
    job_id = "openbao",
    job_spec = "nomad.hcl",
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
