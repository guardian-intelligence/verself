# Owner-local nftables file.
# nftables ruleset openbao.
table inet verself_openbao
delete table inet verself_openbao

table inet verself_openbao {
    chain input {
        type filter hook input priority filter; policy accept;

        iifname "wg-ops" tcp dport 8200 accept
        tcp dport { 8200, 8201 } iifname != "lo" drop
    }
}
