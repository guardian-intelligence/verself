# gazelle:prefix github.com/verself/infrastructure-components/openbao/cmd/openbao-up

load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "openbao-up_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/infrastructure-components/openbao/cmd/openbao-up",
    visibility = ["//visibility:private"],
    deps = [
        "@org_golang_x_crypto//chacha20poly1305",
        "@org_golang_x_crypto//scrypt",
    ],
)

go_binary(
    name = "openbao-up",
    embed = [":openbao-up_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "openbao-up_test",
    srcs = ["main_test.go"],
    embed = [":openbao-up_lib"],
)
