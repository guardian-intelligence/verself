load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "nomad_bin",
    srcs = ["@nomad_tool_nomad//file"],
    outs = ["nomad"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
unzip -q "$(location @nomad_tool_nomad//file)" -d "$$tmp"
install -m 0755 "$$tmp/nomad" "$@"
""",
)

genrule(
    name = "nomad_driver_podman_bin",
    srcs = ["@nomad_tool_podman_driver//file"],
    outs = ["nomad-driver-podman"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
unzip -q "$(location @nomad_tool_podman_driver//file)" -d "$$tmp"
install -m 0755 "$$tmp/nomad-driver-podman" "$@"
""",
)

pkg_tar(
    name = "runtime_artifact",
    out = "nomad-runtime.tar",
    files = {
        ":nomad_bin": "bin/nomad",
        ":nomad_driver_podman_bin": "plugins/nomad-driver-podman",
    },
    modes = {
        "bin/nomad": "0755",
        "plugins/nomad-driver-podman": "0755",
    },
)

filegroup(
    name = "role_sources",
    srcs = glob([
        "defaults/**",
        "handlers/**",
        "meta/**",
        "tasks/**",
        "templates/**",
    ]),
)
