load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "nomad_bin",
    srcs = ["@nomad_tool_nomad//file"],
    outs = ["nomad"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
unzip -q "$(location @nomad_tool_nomad//file)" -d "$$tmp"
install -m 0755 "$$tmp/nomad" "$@"
""",
)

pkg_tar(
    name = "runtime_artifact",
    out = "nomad-runtime.tar",
    files = {
        "//src/infrastructure-components/nomad/cmd/nomad-recover": "bin/nomad-recover",
        ":nomad_bin": "bin/nomad",
    },
    modes = {
        "bin/nomad": "0755",
        "bin/nomad-recover": "0755",
    },
    visibility = ["//visibility:public"],
)
