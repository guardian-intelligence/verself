# {{ ansible_managed }}
# Single-node Nomad: server + client co-resident. Listens on loopback only;
# remote operator access is via wg-ops or SSH-forwarded loopback. Host workloads
# use raw_exec under owner-declared runtime users; OCI workloads use the Podman
# driver with host networking and explicit mounts for local substrate sockets.

data_dir  = "{{ nomad_data_dir }}"
log_level = "INFO"
plugin_dir = "{{ nomad_plugin_dir }}"

# Placement coordinate: datacenter = cluster (IATA metro + ordinal, e.g. iad1).
# region (cell) stays at Nomad's default until cells exist; node_pool (role) and
# meta (attested capabilities) are set on the client stanza below.
datacenter = "{{ nomad_node_datacenter }}"

bind_addr = "{{ nomad_host }}"

# HTTP is the only host-bootstrap Nomad port — operators connect here
# over wg-ops or SSH-forwarded loopback. RPC (4647) and Serf (4648) stay
# on Nomad's defaults; both are loopback-only on a single-node deploy
# and the nftables component drops non-loopback ingress.
ports {
  http = {{ nomad_http_port }}
}

# Nomad refuses to advertise loopback automatically (it considers
# defaulting unsafe), but on a single-node deploy loopback is exactly
# what we want. Spell it out per-protocol so the client/server pair
# inside the same process can talk RPC on 4647 and gossip on 4648.
advertise {
  http = "{{ nomad_http_address }}"
  rpc  = "127.0.0.1:4647"
  serf = "127.0.0.1:4648"
}

server {
  enabled          = true
  bootstrap_expect = 1
}

client {
  enabled = true

  # Role coordinate. The single all-in-one node stays in the built-in `default`
  # pool so jobs that don't pin a pool keep placing; dedicated roles (loadgen,
  # gpu) are separate pools that nodes/jobs opt into explicitly.
  node_pool = "{{ nomad_node_pool }}"

  min_dynamic_port = 20000
  max_dynamic_port = 32000

  # Capability coordinate. cpu_model is the human-readable model from the host's
  # own CPU facts; cpu_isa_level is the x86-64 psABI level (v2/v3/v4) derived from
  # the host's CPU flags — the capability placement pins on. Additional
  # capabilities (e.g. canary_loadgen) flow through nomad_node_meta.
  meta {
    cpu_model     = "{{ (ansible_processor | select('search', 'EPYC|Ryzen|Xeon|Core') | list | first) | default(ansible_processor | last, true) }}"
    cpu_isa_level = "{{ nomad_node_cpu_isa_level }}"
{% for key, value in (nomad_node_meta | default({}, true)).items() %}
    {{ key }} = "{{ value }}"
{% endfor %}
  }

  # Single-node: server is co-resident on loopback. Setting servers
  # explicitly skips Consul discovery (we don't run Consul).
  servers = ["127.0.0.1:4647"]

  # The dynamic port range above is mirrored by the static nftables perimeter
  # rules that drop non-loopback ingress to allocation listeners.
  # Pin every named host-network port to 127.0.0.1 so the native service
  # registry advertises loopback for HTTP/TCP checks. Components bind
  # 127.0.0.1 at L4; nftables enforces loopback-only at L3 as defense-in-depth.
  # Filtering by CIDR avoids fingerprinting ::1 alongside 127.0.0.1
  # (per hashicorp/nomad#15341).
  host_network "loopback" {
    cidr = "127.0.0.0/8"
  }
}

# Disable Consul auto-discovery: we don't run a Consul agent, so leaving
# auto_advertise on produces a steady stream of refused connections in
# the Nomad log.
consul {
  auto_advertise   = false
  client_auto_join = false
  server_auto_join = false
}

plugin "raw_exec" {
  config {
    enabled = true
  }
}

plugin "nomad-driver-podman" {
  config {
    recover_stopped = false
    extra_labels = ["job_id", "task_group_name", "task_name", "namespace", "node_name", "node_id"]
  }
}

vault {
  enabled               = true
  address               = "https://127.0.0.1:8200"
  ca_file               = "/etc/openbao/tls/cert.pem"
  jwt_auth_backend_path = "jwt-nomad"

  default_identity {
    aud = ["vault.io"]
    ttl = "1h"
  }
}

telemetry {
  collection_interval        = "10s"
  disable_hostname           = true
  prometheus_metrics         = true
  publish_allocation_metrics = true
  publish_node_metrics       = true
}

acl {
  enabled = false
}
