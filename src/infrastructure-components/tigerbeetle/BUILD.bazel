load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

exports_files(["tools.lock.json"])

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "runtime_artifact",
    out = "tigerbeetle-runtime.tar",
    files = {
        "//src/infrastructure-components/tigerbeetle/cmd/tigerbeetle-recover:tigerbeetle-recover": "bin/tigerbeetle-recover",
        "@tigerbeetle_tools//tools/tigerbeetle": "bin/tigerbeetle",
    },
    modes = {
        "bin/tigerbeetle": "0755",
        "bin/tigerbeetle-recover": "0755",
    },
    visibility = ["//visibility:public"],
)

nomad_component(
    name = "nomad_component",
    component = "tigerbeetle",
    deploy_phase = "platform",
    job_id = "tigerbeetle",
    job_spec = "nomad.hcl",
    pre_artifacts = {
        ":runtime_artifact": "tigerbeetle-runtime",
    },
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
