load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

deploy_declarations(visibility = ["//visibility:public"])

exports_files(["tools.lock.json"])

pkg_tar(
    name = "runtime_artifact",
    out = "stalwart-runtime.tar",
    files = {
        "@stalwart_tools//tools/stalwart": "bin/stalwart",
        "@stalwart_tools//tools/stalwart-cli": "bin/stalwart-cli",
        "@stalwart_tool_spam_filter//file": "share/stalwart/spam-filter.toml",
        "@stalwart_tool_webadmin//file": "share/stalwart/webadmin.zip",
    },
    modes = {
        "bin/stalwart": "0755",
        "bin/stalwart-cli": "0755",
        "share/stalwart/spam-filter.toml": "0644",
        "share/stalwart/webadmin.zip": "0644",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "stalwart-runtime",
    },
    component = "stalwart",
    deploy_phase = "platform",
    digest_inputs = [":deploy_declarations"],
    job_id = "stalwart",
    job_spec = "nomad.hcl",
    provides = [
        "stalwart:http",
        "stalwart:smtp",
    ],
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
