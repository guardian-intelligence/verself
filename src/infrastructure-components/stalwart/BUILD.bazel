load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

exports_files(["tools.lock.json"])

pkg_tar(
    name = "runtime_artifact",
    out = "stalwart-runtime.tar",
    files = {
        "//src/infrastructure-components/stalwart/cmd/stalwart-recover:stalwart-recover": "bin/stalwart-recover",
        "@stalwart_tools//tools/stalwart": "bin/stalwart",
        "@stalwart_tools//tools/stalwart-cli": "bin/stalwart-cli",
        "@stalwart_tool_spam_filter//file": "share/stalwart/spam-filter.toml",
        "@stalwart_tool_webadmin//file": "share/stalwart/webadmin.zip",
    },
    modes = {
        "bin/stalwart": "0755",
        "bin/stalwart-cli": "0755",
        "bin/stalwart-recover": "0755",
        "share/stalwart/spam-filter.toml": "0644",
        "share/stalwart/webadmin.zip": "0644",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "guardian_crd",
    srcs = glob(["guardian/**/*.cue"]),
    visibility = ["//visibility:public"],
)
