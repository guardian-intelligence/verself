load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

deploy_declarations(visibility = ["//visibility:public"])

exports_files(["tools.lock.json"])

pkg_tar(
    name = "host_install",
    out = "stalwart-host-install.tar",
    files = {
        "@stalwart_tools//tools/stalwart": "opt/verself/profile/bin/stalwart",
        "@stalwart_tools//tools/stalwart-cli": "opt/verself/profile/bin/stalwart-cli",
        "@stalwart_tool_spam_filter//file": "var/lib/stalwart/spam-filter.toml",
        "@stalwart_tool_webadmin//file": "var/lib/stalwart/webadmin.zip",
    },
    modes = {
        "opt/verself/profile/bin/stalwart": "0755",
        "opt/verself/profile/bin/stalwart-cli": "0755",
        "var/lib/stalwart/spam-filter.toml": "0644",
        "var/lib/stalwart/webadmin.zip": "0644",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "stalwart",
    deploy_phase = "platform",
    digest_inputs = [
        ":host_install",
        ":deploy_declarations",
    ],
    job_id = "stalwart",
    job_spec = "nomad.hcl",
    provides = [
        "stalwart:http",
        "stalwart:smtp",
    ],
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
