load("//src/tools/deployment/components:substrate.bzl", "component_substrate_json")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    component = "stalwart",
    deploy_phase = "platform",
    job_id = "stalwart",
    job_spec = "nomad.hcl",
    provides = [
        "stalwart:http",
        "stalwart:smtp",
    ],
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)

component_substrate_json(
    name = "component_substrate",
    srcs = [],
    definition_json = """
{
  "component": "stalwart",
  "kind": "platform_component",
  "nomad_component_label": "//src/infrastructure-components/stalwart:nomad_component",
  "order": 65,
  "postgres": {},
  "workload": {
    "directories": [
      {"group": "stalwart", "mode": "0755", "owner": "root", "path": "/etc/stalwart"},
      {"group": "stalwart", "mode": "0750", "owner": "root", "path": "/etc/stalwart/certs"},
      {"group": "stalwart", "mode": "0750", "owner": "stalwart", "path": "/var/lib/stalwart"}
    ],
    "units": [{"name": "stalwart", "user": "stalwart"}]
  }
}
""",
    visibility = ["//src/host:__pkg__"],
)
