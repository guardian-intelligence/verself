# PostgreSQL user name maps.
# Managed by Ansible — do not edit manually.
#
# MAPNAME                 SYSTEM-USERNAME     PG-USERNAME

verself_services      postgres            postgres
{% for mapping in postgresql_peer_mappings | default([]) | sort(attribute='system_user') %}
{% if not (mapping.system_user == 'postgres' and mapping.pg_user == 'postgres') %}
verself_services      {{ "%-24s" | format(mapping.system_user) }} {{ mapping.pg_user }}
{% endif %}
{% endfor %}
