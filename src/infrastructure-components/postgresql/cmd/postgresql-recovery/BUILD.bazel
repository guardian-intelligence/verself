load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//src/infrastructure-components/nomad:artifact.bzl", "nomad_binary_artifact")

go_library(
    name = "postgresql-recovery_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/infrastructure-components/postgresql/cmd/postgresql-recovery",
    visibility = ["//visibility:private"],
    deps = ["//src/infrastructure-components/postgresql/internal/recoveryfsm"],
)

go_binary(
    name = "postgresql-recovery",
    embed = [":postgresql-recovery_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "postgresql-recovery_test",
    srcs = ["main_test.go"],
    embed = [":postgresql-recovery_lib"],
)

nomad_binary_artifact(
    name = "postgresql-recovery_nomad_artifact",
    binary = ":postgresql-recovery",
    output = "postgresql-recovery",
)
