load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "postgresql_node_runner_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/infrastructure-components/postgresql/cmd/postgresql-node-runner",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "postgresql-node-runner",
    embed = [":postgresql_node_runner_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "postgresql-node-runner_test",
    srcs = ["main_test.go"],
    embed = [":postgresql_node_runner_lib"],
)
