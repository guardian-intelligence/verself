load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//src/tools/deployment/nomad:artifact.bzl", "nomad_binary_artifact")

go_library(
    name = "postgresql-pitr-drill_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/infrastructure-components/postgresql/cmd/postgresql-pitr-drill",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
    ],
)

go_binary(
    name = "postgresql-pitr-drill",
    embed = [":postgresql-pitr-drill_lib"],
    visibility = ["//visibility:public"],
)

nomad_binary_artifact(
    name = "postgresql-pitr-drill_nomad_artifact",
    binary = ":postgresql-pitr-drill",
    output = "postgresql-pitr-drill",
)
