load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//src/tools/deployment/nomad:artifact.bzl", "nomad_binary_artifact")

go_library(
    name = "clickhouse-recovery_lib",
    srcs = ["main.go"],
    importpath = "github.com/verself/infrastructure-components/clickhouse/cmd/clickhouse-recovery",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_clickhouse_clickhouse_go_v2//:clickhouse-go",
        "@com_github_clickhouse_clickhouse_go_v2//lib/driver",
    ],
)

go_binary(
    name = "clickhouse-recovery",
    embed = [":clickhouse-recovery_lib"],
    visibility = ["//visibility:public"],
)

nomad_binary_artifact(
    name = "clickhouse-recovery_nomad_artifact",
    binary = ":clickhouse-recovery",
    output = "clickhouse-recovery",
)
