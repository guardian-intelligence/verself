# gazelle:prefix github.com/verself/infrastructure-components/clickhouse

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/spire:identity.bzl", "spire_identity")

exports_files([
    "tools.lock.json",
])

pkg_tar(
    name = "runtime_artifact",
    out = "clickhouse-runtime.tar",
    files = {
        "@clickhouse_tools//tools/clickhouse": "bin/clickhouse",
        "@clickhouse_tools//tools/spiffe-helper": "bin/spiffe-helper",
        "//src/infrastructure-components/clickhouse/cmd/clickhouse-recover:clickhouse-recover": "bin/clickhouse-recover",
        "//src/infrastructure-components/clickhouse/cmd/clickhouse-spiffe-bundle-reload:clickhouse-spiffe-bundle-reload": "bin/clickhouse-spiffe-bundle-reload",
    },
    modes = {
        "bin/clickhouse": "0755",
        "bin/clickhouse-recover": "0755",
        "bin/clickhouse-spiffe-bundle-reload": "0755",
        "bin/spiffe-helper": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/infrastructure-components:__pkg__"],
)

spire_identity(
    name = "spiffe_identity_server",
    component = "clickhouse",
    entry_id = "verself-clickhouse-server",
    key = "clickhouse.server",
    path = "/svc/clickhouse-server",
    restart_units = ["clickhouse-server-spiffe-helper"],
    user = "clickhouse",
    visibility = ["//src/infrastructure-components/spire:__pkg__"],
)

spire_identity(
    name = "spiffe_identity_operator",
    component = "clickhouse",
    entry_id = "verself-clickhouse-operator",
    key = "clickhouse.operator",
    path = "/svc/clickhouse-operator",
    restart_units = ["clickhouse-operator-spiffe-helper"],
    user = "clickhouse_operator",
    visibility = ["//src/infrastructure-components/spire:__pkg__"],
)
