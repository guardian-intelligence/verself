{
  "schema_version": 1,
  "installation_id": {{ verself_installation_id | to_json }},
  "site": {{ verself_site | to_json }},
  "domain": {{ verself_domain | to_json }},
  "console_url": {{ ('https://' ~ verself_domain) | to_json }},
  "auth": {
    "issuer_url": {{ ('https://' ~ verself_domain) | to_json }},
    "cli_client_id": {{ (haproxy_verself_cli_client_id | default('')) | to_json }},
    "product_api_audience": {{ (haproxy_verself_product_api_audience | default('')) | to_json }}
  },
  "public_apis": {}
}
