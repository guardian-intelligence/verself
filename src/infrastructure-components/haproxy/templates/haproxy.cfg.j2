# Authored HAProxy public edge template. Keep route/backend GUIDs aligned with service metadata.
# Nomad-backed backend sections live in {{ haproxy_nomad_upstreams_config }} so deployments can refresh allocation membership without rewriting this file.

global
  log stdout format raw local0
  stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
  crt-base {{ haproxy_cert_dir }}
  maxconn {{ haproxy_global_maxconn }}
  strict-limits
  hard-stop-after 5s
  tune.stick-counters 4
  # Required for shm-stats-file. URI normalization remains disabled while HAProxy marks normalizers experimental.
  expose-experimental-directives
  shm-stats-file {{ haproxy_shm_stats_file }}
  ssl-default-bind-options ssl-min-ver TLSv1.3 no-tls-tickets
  ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256

defaults
  mode http
  log global
  option dontlognull
  option http-keep-alive
  timeout connect 1s
  timeout client 30s
  timeout server 30s
  timeout tunnel 4h
  timeout http-request 5s
  timeout http-keep-alive 10s
  unique-id-format %[uuid()]
  unique-id-header X-Request-ID
  log-format "request_id=%ID client_ip=%[var(txn.client_ip)] edge_peer_ip=%[var(txn.edge_peer_ip)] client_ip_source=%[var(txn.client_ip_source)] client_port=%cp method=%HM host=%[var(txn.host)] path=%HP query=%HQ uri=%HU status=%ST bytes=%B duration_ms=%Ta t_request_ms=%TR t_queue_ms=%Tw t_connect_ms=%Tc t_response_ms=%Tr termination=%tsc active_conn=%ac frontend_conn=%fc backend_conn=%bc server_conn=%sc retries=%rc server_queue=%sq backend_queue=%bq frontend=%ft backend=%b server=%s tls_version=%[ssl_fc_protocol] tls_cipher=%[ssl_fc_cipher] tls_sni=%[ssl_fc_sni] alpn=%[ssl_fc_alpn]"

frontend fe_http
  guid fe_http
  maxconn {{ haproxy_public_frontend_maxconn }}
  bind 0.0.0.0:80
  http-request set-var(txn.host) req.hdr(host),lower,field(1,:)
  http-request set-var(txn.client_ip) src
  http-request set-var(txn.edge_peer_ip) src
  http-request set-var(txn.client_ip_source) str(direct)
  http-request redirect scheme https code 308

frontend fe_https
  guid fe_https
  maxconn {{ haproxy_public_frontend_maxconn }}
  bind 0.0.0.0:443 ssl crt {{ haproxy_cert_dir }} strict-sni alpn h2,http/1.1
  http-request set-var(txn.host) req.hdr(host),lower,field(1,:)
  http-request set-var(txn.client_ip) src
  http-request set-var(txn.edge_peer_ip) src
  http-request set-var(txn.client_ip_source) str(direct)
  acl cloudflare_edge src {{ haproxy_cloudflare_trusted_ips | join(' ') }}
  acl cloudflare_client_ip req.hdr(CF-Connecting-IP) -m found
  acl cloudflare_country req.hdr(CF-IPCountry) -m found
  acl cloudflare_region req.hdr(CF-Region) -m found
  acl cloudflare_city req.hdr(CF-City) -m found
  http-request set-var(txn.client_ip) req.hdr(CF-Connecting-IP) if cloudflare_edge cloudflare_client_ip
  http-request set-var(txn.client_ip_source) str(cloudflare) if cloudflare_edge cloudflare_client_ip
  http-request set-var(txn.client_country) req.hdr(CF-IPCountry) if cloudflare_edge cloudflare_country
  http-request set-var(txn.client_region) req.hdr(CF-Region) if cloudflare_edge cloudflare_region
  http-request set-var(txn.client_city) req.hdr(CF-City) if cloudflare_edge cloudflare_city
  http-request del-header CF-Connecting-IP
  http-request del-header CF-Connecting-IPv6
  http-request del-header CF-Pseudo-IPv4
  http-request del-header True-Client-IP
  http-request del-header CF-IPCountry
  http-request del-header CF-Region
  http-request del-header CF-City
  http-request del-header Forwarded
  http-request del-header X-Client-IP
  http-request del-header X-Cluster-Client-IP
  http-request del-header X-Original-Forwarded-For
  http-request del-header X-Verself-Client-Country
  http-request del-header X-Verself-Client-Region
  http-request del-header X-Verself-Client-City
  http-request set-header X-Verself-Client-IP %[var(txn.client_ip)]
  http-request set-header X-Verself-Edge-Peer-IP %[var(txn.edge_peer_ip)]
  http-request set-header X-Verself-Client-IP-Source %[var(txn.client_ip_source)]
  http-request set-header X-Verself-Client-Country %[var(txn.client_country)] if { var(txn.client_country) -m found }
  http-request set-header X-Verself-Client-Region %[var(txn.client_region)] if { var(txn.client_region) -m found }
  http-request set-header X-Verself-Client-City %[var(txn.client_city)] if { var(txn.client_city) -m found }
  http-request set-header X-Real-IP %[src]
  http-request set-header X-Forwarded-For %[src]
  http-request set-header X-Forwarded-Host %[req.hdr(host)]
  http-request set-header X-Forwarded-Proto https
  http-response set-header Strict-Transport-Security "{{ haproxy_hsts_header }}"

  acl host_verself var(txn.host) -m str {{ verself_domain }}
  acl host_billing var(txn.host) -m str {{ billing_service_domain }}
  acl host_iam var(txn.host) -m str {{ iam_service_domain }}
  acl host_sandbox var(txn.host) -m str {{ sandbox_rental_service_domain }}
  acl host_source var(txn.host) -m str {{ source_code_hosting_service_domain }}
  acl host_mail var(txn.host) -m str {{ stalwart_domain }}
  acl host_npm var(txn.host) -m str {{ haproxy_npm_registry_domain }}
  acl method_get method GET
  acl method_post method POST
  acl npm_registry_read_method method GET HEAD OPTIONS
  acl well_known_read_method method GET HEAD
  # npm.verself.sh is an unauthenticated public-read route to Verdaccio.
  # Threat model: Verdaccio mirrors registry.npmjs.org with publish locked
  # to $nobody, so no private package material lives here — the bytes are
  # already free to fetch from the upstream. Tarballs are sha512-pinned by
  # caller lockfiles, and edge_npm_registry_rate_limited caps per-source-IP
  # abuse. The 405 below blocks every non-read method before routing, and
  # nomad-upstreams strips Authorization on the Verdaccio backend so
  # callers can supply any (or no) bearer without affecting auth posture.
  # Identity-fronted gating via Pomerium was removed because pnpm omits
  # auth on tarball fetches by default and the protected resource has no
  # confidentiality budget.
  acl zitadel_product_token_claims path -i /internal/zitadel/actions/product-token-claims
  acl jmap_session path -i /jmap/session
  acl stripe_webhook path -i /webhooks/stripe
  acl stripe_source src {{ haproxy_stripe_webhook_ips | join(' ') }}
  acl auth_device_authorization_path path -i /oauth/v2/device_authorization
  acl zitadel_oidc_path path -i /.well-known/openid-configuration /.well-known/webfinger /robots.txt
  acl zitadel_oidc_path path_beg /oauth/ /oauth/v2/ /oidc/ /oidc/v1/ /saml/ /ui/login /ui/console /idps/
  acl auth_path path -i /api/v1/auth/password-login /api/v1/auth/password-reset /api/v1/auth/password-reset/complete /api/v1/auth/password-reset/consume /api/v1/auth/callback /api/v1/auth/session /api/v1/auth/sync-session /api/v1/auth/organization /api/v1/auth/resource-token /api/v1/auth/logout /api/v1/auth/accounts /api/v1/auth/sessions /api/v1/auth/invites/accept
  acl auth_accounts_path path_beg /api/v1/auth/accounts/
  acl auth_sessions_path path_beg /api/v1/auth/sessions/
  acl auth_device_logins_path path_beg /api/v1/auth/device-logins/
  acl auth_idp_path path_beg /api/v1/auth/idp/
  acl verself_discovery path -i /.well-known/verself
  acl source_forgejo_webhook path -i /webhooks/forgejo
  acl edge_public_rate_limited sc_http_req_rate(0,be_edge_public_rates) gt {{ haproxy_public_rate_limit }}
  acl edge_auth_rate_limited sc_http_req_rate(1,be_edge_auth_rates) gt {{ haproxy_auth_rate_limit }}
  acl edge_webhook_rate_limited sc_http_req_rate(2,be_edge_webhook_rates) gt {{ haproxy_webhook_rate_limit }}
  acl edge_npm_registry_rate_limited sc_http_req_rate(3,be_edge_npm_registry_rates) gt {{ haproxy_npm_registry_rate_limit }}

  http-request track-sc0 src table be_edge_public_rates unless host_npm
  http-request track-sc1 src table be_edge_auth_rates if host_verself auth_path
  http-request track-sc1 src table be_edge_auth_rates if host_verself auth_accounts_path
  http-request track-sc1 src table be_edge_auth_rates if host_verself auth_sessions_path
  http-request track-sc1 src table be_edge_auth_rates if host_verself auth_device_logins_path
  http-request track-sc1 src table be_edge_auth_rates if host_verself auth_idp_path
  http-request track-sc1 src table be_edge_auth_rates if host_verself auth_device_authorization_path
  http-request track-sc2 src table be_edge_webhook_rates if host_billing stripe_webhook
  http-request track-sc2 src table be_edge_webhook_rates if host_source source_forgejo_webhook
  http-request track-sc3 src table be_edge_npm_registry_rates if host_npm
  http-request return status 429 content-type text/plain string "rate limit exceeded" if edge_public_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_verself auth_path edge_auth_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_verself auth_accounts_path edge_auth_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_verself auth_sessions_path edge_auth_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_verself auth_device_logins_path edge_auth_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_verself auth_idp_path edge_auth_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_verself auth_device_authorization_path edge_auth_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_billing stripe_webhook edge_webhook_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_source source_forgejo_webhook edge_webhook_rate_limited
  http-request return status 429 content-type text/plain string "rate limit exceeded" if host_npm edge_npm_registry_rate_limited

  http-request return status 405 if host_npm !npm_registry_read_method
  http-request return status 403 if host_billing stripe_webhook method_post !stripe_source
  http-request return status 405 if host_billing stripe_webhook !method_post
  http-request return status 405 if host_verself verself_discovery !well_known_read_method
  http-request return status 200 content-type application/json file {{ haproxy_verself_discovery_manifest_path }} hdr Cache-Control "public, max-age=300" if host_verself verself_discovery well_known_read_method
  http-request return status 405 if host_verself zitadel_product_token_claims !method_post
  http-request return status 405 if host_iam zitadel_product_token_claims !method_post
  http-request return status 405 if host_verself auth_device_authorization_path !method_post

  use_backend be_billing_stripe_webhook if host_billing stripe_webhook method_post stripe_source
  use_backend be_sandbox_execution_submit if host_sandbox method_post { path -i /api/v1/executions }
  use_backend be_sandbox_execution_schedule_create if host_sandbox method_post { path -i /api/v1/execution-schedules }
  use_backend be_source_forgejo_webhook if host_source { path -i /webhooks/forgejo }
  use_backend be_zitadel_product_token_claims if host_verself method_post zitadel_product_token_claims
  use_backend be_zitadel_product_token_claims if host_iam method_post zitadel_product_token_claims
  use_backend be_route_product_apex_iam_service_public_api if host_verself method_post auth_device_authorization_path
  use_backend be_route_product_auth_zitadel_oidc if host_verself zitadel_oidc_path
  use_backend be_email_jmap_session if host_mail jmap_session
  use_backend be_route_product_npm_registry_verdaccio if host_npm

  acl route_1_host var(txn.host) -m str {{ verself_domain }}
  acl route_1_path path -i /api/v1/auth/password-login /api/v1/auth/password-reset /api/v1/auth/password-reset/complete /api/v1/auth/password-reset/consume /api/v1/auth/callback /api/v1/auth/session /api/v1/auth/sync-session /api/v1/auth/organization /api/v1/auth/resource-token /api/v1/auth/logout /api/v1/auth/accounts /api/v1/auth/sessions /api/v1/auth/invites/accept
  acl route_1_accounts_path path_beg /api/v1/auth/accounts/
  acl route_1_sessions_path path_beg /api/v1/auth/sessions/
  acl route_1_device_logins_path path_beg /api/v1/auth/device-logins/
  acl route_1_idp_path path_beg /api/v1/auth/idp/
  use_backend be_route_product_apex_iam_service_public_api if route_1_host route_1_path
  use_backend be_route_product_apex_iam_service_public_api if route_1_host route_1_accounts_path
  use_backend be_route_product_apex_iam_service_public_api if route_1_host route_1_sessions_path
  use_backend be_route_product_apex_iam_service_public_api if route_1_host route_1_device_logins_path
  use_backend be_route_product_apex_iam_service_public_api if route_1_host route_1_idp_path
  use_backend %[var(txn.host),map({{ haproxy_map_dir }}/public-hosts.map,be_not_found)]

frontend fe_haproxy_metrics
  guid fe_haproxy_metrics
  maxconn {{ haproxy_metrics_frontend_maxconn }}
  bind 127.0.0.1:8404
  http-request set-var(txn.client_ip) src
  http-request set-var(txn.edge_peer_ip) src
  http-request set-var(txn.client_ip_source) str(direct)
  option socket-stats
  http-request use-service prometheus-exporter if { path -i /metrics }
  http-request return status 404

frontend fe_firecracker_host_http
  guid fe_firecracker_host_http
  maxconn {{ haproxy_internal_frontend_maxconn }}
  bind 10.255.0.1:18080
  http-request set-var(txn.host) req.hdr(host),lower,field(1,:)
  http-request set-var(txn.client_ip) src
  http-request set-var(txn.edge_peer_ip) src
  http-request set-var(txn.client_ip_source) str(direct)
  http-request set-header X-Forwarded-Proto http
  acl method_get method GET
  acl method_post method POST
  acl forgejo_smart_http path_reg ^/[^/]+/[^/]+(\.git)?/(info/refs|git-upload-pack)$
  use_backend be_firecracker_sandbox_h2c if method_get { path -i /internal/sandbox/v1/runner-bootstrap }
  use_backend be_firecracker_sandbox_h2c if method_post { path -i /internal/sandbox/v1/github-checkout/bundle }
  use_backend be_firecracker_sandbox_h2c if method_post { path -i /internal/sandbox/v1/bazel-telemetry/invocations }
  use_backend be_route_product_git_source_code_hosting_service_git_smart_http if method_get forgejo_smart_http
  use_backend be_route_product_git_source_code_hosting_service_git_smart_http if method_post forgejo_smart_http
  default_backend be_forbidden

frontend fe_firecracker_npm_registry
  guid fe_firecracker_npm_registry
  maxconn {{ haproxy_internal_frontend_maxconn }}
  bind 10.255.0.1:4873
  http-request set-var(txn.host) str({{ haproxy_npm_registry_domain }})
  http-request set-var(txn.client_ip) src
  http-request set-var(txn.edge_peer_ip) src
  http-request set-var(txn.client_ip_source) str(direct)
  http-request set-header Host {{ haproxy_npm_registry_domain }}
  http-request set-header X-Forwarded-Host {{ haproxy_npm_registry_domain }}
  http-request set-header X-Forwarded-Proto http
  default_backend be_route_product_npm_registry_verdaccio

frontend fe_nomad_artifacts
  guid fe_nomad_artifacts
  maxconn {{ haproxy_internal_frontend_maxconn }}
  bind 127.0.0.1:9443 ssl crt /etc/verself/pki/nomad-artifacts-server-haproxy.pem alpn h2,http/1.1
  http-request set-var(txn.host) req.hdr(host),lower,field(1,:)
  http-request set-var(txn.client_ip) src
  http-request set-var(txn.edge_peer_ip) src
  http-request set-var(txn.client_ip_source) str(direct)
  default_backend be_garage_nomad_artifacts

backend be_edge_public_rates
  guid be_edge_public_rates
  stick-table type ip size {{ haproxy_stick_table_size }} expire {{ haproxy_stick_table_expire }} store http_req_rate({{ haproxy_public_rate_window }}),http_err_rate({{ haproxy_public_rate_window }})

backend be_edge_auth_rates
  guid be_edge_auth_rates
  stick-table type ip size {{ haproxy_stick_table_size }} expire {{ haproxy_stick_table_expire }} store http_req_rate({{ haproxy_public_rate_window }}),http_err_rate({{ haproxy_public_rate_window }})

backend be_edge_webhook_rates
  guid be_edge_webhook_rates
  stick-table type ip size {{ haproxy_stick_table_size }} expire {{ haproxy_stick_table_expire }} store http_req_rate({{ haproxy_public_rate_window }}),http_err_rate({{ haproxy_public_rate_window }})

backend be_edge_npm_registry_rates
  guid be_edge_npm_registry_rates
  stick-table type ip size {{ haproxy_stick_table_size }} expire {{ haproxy_stick_table_expire }} store http_req_rate({{ haproxy_public_rate_window }}),http_err_rate({{ haproxy_public_rate_window }})

backend be_not_found
  guid be_not_found
  http-request return status 404

backend be_forbidden
  guid be_forbidden
  http-request return status 403

backend be_route_product_access_pomerium_access_portal
  guid be_route_product_access_pomerium_access_portal
  http-request set-header Host %[req.hdr(host)]
  http-request set-header X-Forwarded-Host %[req.hdr(host)]
  http-request set-header X-Forwarded-Proto https
  server pomerium 127.0.0.1:4180 guid be_route_product_access_pomerium_access_portal_srv_pomerium

backend be_route_product_dashboard_grafana_operator_ui
  guid be_route_product_dashboard_grafana_operator_ui
  http-request set-header Host %[req.hdr(host)]
  http-request set-header X-Forwarded-Host %[req.hdr(host)]
  http-request set-header X-Forwarded-Proto https
  server pomerium 127.0.0.1:4180 guid be_route_product_dashboard_grafana_operator_ui_srv_pomerium
