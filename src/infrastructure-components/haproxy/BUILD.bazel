# gazelle:prefix github.com/verself/infrastructure-components/haproxy

load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//src/host:__pkg__",
        "//src/infrastructure-components:__pkg__",
    ],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/infrastructure-components/haproxy/cmd/haproxy-upstreams-apply:haproxy-upstreams-apply_nomad_artifact": "haproxy-upstreams-apply",
    },
    component = "haproxy_upstreams",
    deploy_phase = "platform",
    digest_inputs = [":role_sources"],
    job_id = "haproxy-upstreams",
    job_spec = "nomad.hcl",
    requires = [
        "auth:control-plane",
        "forgejo:http",
        "garage:s3",
        "grafana:http",
        "stalwart:http",
        "verdaccio:http",
        "zitadel:http",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
