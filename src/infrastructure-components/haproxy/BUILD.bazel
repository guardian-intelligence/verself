# gazelle:prefix github.com/verself/infrastructure-components/haproxy

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

exports_files(["tools.lock.json"])

genrule(
    name = "haproxy_bin",
    srcs = [
        "@haproxy_tool_haproxy_deb//file",
        "@haproxy_tool_libssl_awslc_deb//file",
    ],
    outs = [
        "haproxy",
        "libcrypto.so",
        "libcrypt.so.1",
        "libgcc_s.so.1",
        "libjemalloc.so.2",
        "liblua5.4.so.0",
        "libopentracing-c-wrapper.so.0",
        "libopentracing.so.1",
        "libpcre2-8.so.0",
        "libssl.so",
        "libstdc++.so.6",
    ],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
haproxy_root="$$tmp/haproxy"
awslc_root="$$tmp/awslc"
dpkg-deb -x "$(location @haproxy_tool_haproxy_deb//file)" "$$haproxy_root"
dpkg-deb -x "$(location @haproxy_tool_libssl_awslc_deb//file)" "$$awslc_root"
install -m 0755 "$$haproxy_root/usr/sbin/haproxy" "$(location haproxy)"
install -m 0644 "$$awslc_root/opt/aws-lc/lib/x86_64-linux-gnu/libcrypto.so" "$(location libcrypto.so)"
install -m 0644 /lib/x86_64-linux-gnu/libcrypt.so.1 "$(location libcrypt.so.1)"
install -m 0644 /lib/x86_64-linux-gnu/libgcc_s.so.1 "$(location libgcc_s.so.1)"
install -m 0644 /lib/x86_64-linux-gnu/libjemalloc.so.2 "$(location libjemalloc.so.2)"
install -m 0644 /lib/x86_64-linux-gnu/liblua5.4.so.0 "$(location liblua5.4.so.0)"
install -m 0644 /lib/x86_64-linux-gnu/libopentracing-c-wrapper.so.0 "$(location libopentracing-c-wrapper.so.0)"
install -m 0644 /lib/x86_64-linux-gnu/libopentracing.so.1 "$(location libopentracing.so.1)"
install -m 0644 /lib/x86_64-linux-gnu/libpcre2-8.so.0 "$(location libpcre2-8.so.0)"
install -m 0644 "$$awslc_root/opt/aws-lc/lib/x86_64-linux-gnu/libssl.so" "$(location libssl.so)"
install -m 0644 /lib/x86_64-linux-gnu/libstdc++.so.6 "$(location libstdc++.so.6)"
""",
)

pkg_tar(
    name = "runtime_artifact",
    out = "haproxy-runtime.tar",
    files = {
        ":haproxy": "bin/haproxy",
        ":libcrypto.so": "lib/libcrypto.so",
        ":libcrypt.so.1": "lib/libcrypt.so.1",
        ":libgcc_s.so.1": "lib/libgcc_s.so.1",
        ":libjemalloc.so.2": "lib/libjemalloc.so.2",
        ":liblua5.4.so.0": "lib/liblua5.4.so.0",
        ":libopentracing-c-wrapper.so.0": "lib/libopentracing-c-wrapper.so.0",
        ":libopentracing.so.1": "lib/libopentracing.so.1",
        ":libpcre2-8.so.0": "lib/libpcre2-8.so.0",
        ":libssl.so": "lib/libssl.so",
        ":libstdc++.so.6": "lib/libstdc++.so.6",
        "@haproxy_tools//tools/lego": "bin/lego",
        "//src/infrastructure-components/haproxy/cmd/haproxy-lego-renew:haproxy-lego-renew": "bin/haproxy-lego-renew",
        "//src/infrastructure-components/haproxy/cmd/haproxy-upstreams-apply:haproxy-upstreams-apply": "bin/haproxy-upstreams-apply",
    },
    modes = {
        "bin/haproxy": "0755",
        "bin/haproxy-lego-renew": "0755",
        "bin/haproxy-upstreams-apply": "0755",
        "bin/lego": "0755",
        "lib/libcrypto.so": "0644",
        "lib/libcrypt.so.1": "0644",
        "lib/libgcc_s.so.1": "0644",
        "lib/libjemalloc.so.2": "0644",
        "lib/liblua5.4.so.0": "0644",
        "lib/libopentracing-c-wrapper.so.0": "0644",
        "lib/libopentracing.so.1": "0644",
        "lib/libpcre2-8.so.0": "0644",
        "lib/libssl.so": "0644",
        "lib/libstdc++.so.6": "0644",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//src/host:__pkg__",
        "//src/infrastructure-components:__pkg__",
    ],
)

filegroup(
    name = "public_route_declarations",
    srcs = [
        "//src/infrastructure-components/forgejo:deploy_declarations",
        "//src/infrastructure-components/grafana:deploy_declarations",
        "//src/infrastructure-components/pomerium:deploy_declarations",
        "//src/infrastructure-components/stalwart:deploy_declarations",
        "//src/infrastructure-components/verdaccio:deploy_declarations",
        "//src/services/analytics-service:deploy_declarations",
        "//src/services/billing-service:deploy_declarations",
        "//src/services/distribution-service:deploy_declarations",
        "//src/services/email-service:deploy_declarations",
        "//src/services/github-integration-service:deploy_declarations",
        "//src/services/governance-service:deploy_declarations",
        "//src/services/iam-service:deploy_declarations",
        "//src/services/notifications-service:deploy_declarations",
        "//src/services/profile-service:deploy_declarations",
        "//src/services/projects-service:deploy_declarations",
        "//src/services/sandbox-rental-service:deploy_declarations",
        "//src/services/secrets-service:deploy_declarations",
        "//src/services/source-code-hosting-service:deploy_declarations",
        "//src/viteplus-monorepo/apps/company:deploy_declarations",
        "//src/viteplus-monorepo/apps/verself-web:deploy_declarations",
    ],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "haproxy-runtime",
    },
    component = "haproxy_upstreams",
    digest_inputs = [
        ":public_route_declarations",
        ":role_sources",
    ],
    job_id = "haproxy-upstreams",
    job_spec = "nomad.hcl",
    provides = [
        "edge:public-oidc",
        "nomad:job:haproxy-upstreams",
    ],
    requires = [
        "zitadel:http",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
