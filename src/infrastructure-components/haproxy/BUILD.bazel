# gazelle:prefix github.com/verself/infrastructure-components/haproxy

load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

genrule(
    name = "haproxy_bin",
    srcs = ["@haproxy_tool_haproxy_deb//file"],
    outs = ["haproxy"],
    cmd = """
set -euo pipefail
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
dpkg-deb -x "$(location @haproxy_tool_haproxy_deb//file)" "$$tmp"
install -m 0755 "$$tmp/usr/sbin/haproxy" "$@"
""",
)

pkg_tar(
    name = "runtime_artifact",
    out = "haproxy-runtime.tar",
    files = {
        ":haproxy_bin": "bin/haproxy",
        "//src/infrastructure-components/haproxy/cmd/haproxy-upstreams-apply:haproxy-upstreams-apply": "bin/haproxy-upstreams-apply",
    },
    modes = {
        "bin/haproxy": "0755",
        "bin/haproxy-upstreams-apply": "0755",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "deploy/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//src/host:__pkg__",
        "//src/infrastructure-components:__pkg__",
    ],
)

go_test(
    name = "frontend_policy_test",
    srcs = ["frontend_policy_test.go"],
    data = [
        "nomad.hcl",
        "templates/haproxy.cfg.j2",
        "templates/nomad-upstreams.cfg.j2",
    ],
)

filegroup(
    name = "public_route_declarations",
    srcs = [
        "//src/infrastructure-components/forgejo:deploy_declarations",
        "//src/infrastructure-components/grafana:deploy_declarations",
        "//src/infrastructure-components/pomerium:deploy_declarations",
        "//src/infrastructure-components/stalwart:deploy_declarations",
        "//src/infrastructure-components/verdaccio:deploy_declarations",
        "//src/services/analytics-service:deploy_declarations",
        "//src/services/billing-service:deploy_declarations",
        "//src/services/deployment-service:deploy_declarations",
        "//src/services/distribution-service:deploy_declarations",
        "//src/services/email-service:deploy_declarations",
        "//src/services/github-integration-service:deploy_declarations",
        "//src/services/governance-service:deploy_declarations",
        "//src/services/iam-service:deploy_declarations",
        "//src/services/notifications-service:deploy_declarations",
        "//src/services/profile-service:deploy_declarations",
        "//src/services/projects-service:deploy_declarations",
        "//src/services/sandbox-rental-service:deploy_declarations",
        "//src/services/secrets-service:deploy_declarations",
        "//src/services/source-code-hosting-service:deploy_declarations",
        "//src/viteplus-monorepo/apps/company:deploy_declarations",
        "//src/viteplus-monorepo/apps/verself-web:deploy_declarations",
    ],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "haproxy-runtime",
    },
    component = "haproxy_upstreams",
    deploy_phase = "platform",
    digest_inputs = [
        ":public_route_declarations",
        ":role_sources",
    ],
    job_id = "haproxy-upstreams",
    job_spec = "nomad.hcl",
    requires = [
        "auth:control-plane",
        "forgejo:http",
        "grafana:http",
        "stalwart:http",
        "verdaccio:http",
        "zitadel:http",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
