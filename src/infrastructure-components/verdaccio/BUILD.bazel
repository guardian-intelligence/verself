load("//src/tools/deployment:declarations.bzl", "deploy_declarations")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

deploy_declarations(visibility = ["//visibility:public"])

nomad_component(
    name = "nomad_component",
    artifacts = {
        ":runtime_artifact": "verdaccio-runtime",
    },
    component = "verdaccio",
    digest_inputs = [":deploy_declarations"],
    job_id = "verdaccio",
    job_spec = "nomad.hcl",
    provides = ["verdaccio:http"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)

genrule(
    name = "runtime_artifact",
    srcs = [
        "runtime/config.yaml",
        "runtime/package-lock.json",
        "runtime/package.json",
        "@verdaccio_tool_nodejs//file",
    ],
    outs = ["verdaccio-runtime.tar"],
    cmd = """
set -euo pipefail
out="$$(pwd)/$@"
tmp="$$(mktemp -d)"
trap 'rm -rf "$$tmp"' EXIT
mkdir -p "$$tmp/node" "$$tmp/runtime" "$$tmp/out/bin" "$$tmp/out/etc/verdaccio" "$$tmp/out/lib"
tar -xJf "$(location @verdaccio_tool_nodejs//file)" -C "$$tmp/node" --strip-components=1
install -m 0755 "$$tmp/node/bin/node" "$$tmp/out/bin/node"
cp "$(location runtime/package.json)" "$$tmp/runtime/package.json"
cp "$(location runtime/package-lock.json)" "$$tmp/runtime/package-lock.json"
install -m 0644 "$(location runtime/config.yaml)" "$$tmp/out/etc/verdaccio/config.yaml"
cd "$$tmp/runtime"
"$$tmp/node/bin/node" "$$tmp/node/lib/node_modules/npm/bin/npm-cli.js" ci --omit=dev --ignore-scripts --audit=false --fund=false --cache "$$tmp/npm-cache"
tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 2000-01-01' -cf "$$tmp/out/lib/node_modules.tar" node_modules
cat > "$$tmp/out/bin/verdaccio" <<'EOF'
#!/bin/sh
root="$$(CDPATH= cd -- "$$(dirname -- "$$0")/.." && pwd)"
exec "$$root/bin/node" "$$root/lib/node_modules/verdaccio/bin/verdaccio" "$$@"
EOF
chmod 0755 "$$tmp/out/bin/verdaccio"
tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='UTC 2000-01-01' -cf "$$out" -C "$$tmp/out" .
""",
    visibility = ["//visibility:public"],
)
