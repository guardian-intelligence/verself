load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "bundle_check",
    srcs = [
        "dist/index.js",
        "src/index.js",
    ],
    outs = ["bundle_check.stamp"],
    cmd = "cmp $(location src/index.js) $(location dist/index.js) && touch $@",
)

genrule(
    name = "metadata_check",
    srcs = ["action.yml"],
    outs = ["metadata_check.stamp"],
    cmd = "grep -q 'using: node24' $(location action.yml) && grep -q 'main: dist/index.js' $(location action.yml) && grep -q 'post: dist/index.js' $(location action.yml) && touch $@",
)

pkg_tar(
    name = "github_action_payload",
    files = {
        "LICENSE": "LICENSE",
        "README.md": "README.md",
        "action.yml": "action.yml",
        "dist/index.js": "dist/index.js",
        "package-lock.json": "package-lock.json",
        "package.json": "package.json",
    },
    modes = {
        "LICENSE": "0644",
        "README.md": "0644",
        "action.yml": "0644",
        "dist/index.js": "0644",
        "package-lock.json": "0644",
        "package.json": "0644",
    },
    visibility = ["//visibility:private"],
)

genrule(
    name = "github_action_dist",
    srcs = [
        ":bundle_check",
        ":github_action_payload",
        ":metadata_check",
    ],
    outs = ["github_action_dist.tar"],
    cmd = "cp $(location :github_action_payload) $@",
)
