load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "r2control",
    srcs = [
        "cloudflare_api.go",
        "credentials.go",
        "r2.go",
        "temporary_credentials.go",
    ],
    importpath = "github.com/verself/integrations/cloudflare/r2-control-plane/internal/r2control",
    visibility = ["//src/integrations/cloudflare/r2-control-plane:__subpackages__"],
    deps = [
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2//aws/signer/v4:signer",
    ],
)

go_test(
    name = "r2control_test",
    srcs = [
        "credentials_test.go",
        "r2_test.go",
        "temporary_credentials_test.go",
    ],
    embed = [":r2control"],
)
