# gazelle:prefix github.com/verself/integrations/cloudflare/r2-control-plane/cmd/cloudflare-r2-control-plane

load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "cloudflare-r2-control-plane_lib",
    srcs = [
        "main.go",
        "server.go",
        "site.go",
    ],
    importpath = "github.com/verself/integrations/cloudflare/r2-control-plane/cmd/cloudflare-r2-control-plane",
    visibility = ["//visibility:private"],
    deps = [
        "//src/integrations/cloudflare/r2-control-plane/client",
        "//src/integrations/cloudflare/r2-control-plane/internal/r2control",
    ],
)

go_binary(
    name = "cloudflare-r2-control-plane",
    embed = [":cloudflare-r2-control-plane_lib"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "cloudflare-r2-control-plane_nomad_artifact",
    out = "cloudflare-r2-control-plane.tar",
    files = {
        ":cloudflare-r2-control-plane": "bin/cloudflare-r2-control-plane",
        "//src/tools/deployment/cmd/nomad-chown-exec:nomad-chown-exec": "bin/nomad-chown-exec",
    },
    modes = {
        "bin/cloudflare-r2-control-plane": "0755",
        "bin/nomad-chown-exec": "0755",
    },
)

go_test(
    name = "cloudflare-r2-control-plane_test",
    srcs = ["server_test.go"],
    embed = [":cloudflare-r2-control-plane_lib"],
)
