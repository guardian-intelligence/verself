# gazelle:prefix github.com/verself/integrations/cloudflare/control-plane

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/tools/build:go_module_checks.bzl", "go_module_checks")
load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

go_module_checks()

exports_files([
    "nomad.hcl",
    "recovery/gamma.cloudflare-recovery.yml",
])

pkg_tar(
    name = "runtime_artifact",
    out = "cloudflare-control-plane-runtime.tar",
    files = {
        "recovery/gamma.cloudflare-recovery.yml": "recovery/gamma.cloudflare-recovery.yml",
        "//src/integrations/cloudflare/control-plane/cmd/cloudflare-control-plane:cloudflare-control-plane": "bin/cloudflare-control-plane",
    },
    modes = {
        "bin/cloudflare-control-plane": "0755",
        "recovery/gamma.cloudflare-recovery.yml": "0644",
    },
    visibility = ["//visibility:public"],
)

nomad_component(
    name = "recovery_nomad_component",
    artifacts = {
        ":runtime_artifact": "cloudflare-control-plane-runtime",
    },
    component = "cloudflare_integration_recovery",
    deploy_phase = "platform",
    job_id = "cloudflare-integration-recovery",
    job_spec = "nomad.hcl",
    sites = ["gamma"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
