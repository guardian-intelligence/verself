load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load(
    "@npm//src/websites/packages/sdk:@hey-api/openapi-ts/package_json.bzl",
    openapi_ts_bin = "bin",
)
load("//src/websites:viteplus_rules.bzl", "viteplus_openapi_clients", "viteplus_source_package")

package(default_visibility = ["//visibility:public"])

viteplus_source_package(
    srcs = [
        "package.json",
        "src/**/*",
        "tsconfig.json",
    ],
    npm_name = "@verself/sdk",
)

viteplus_openapi_clients(
    name = "openapi_clients",
    openapi_ts_bin = openapi_ts_bin,
    plugin_packages = [":node_modules/valibot"],
    specs = [
        ("iam-api", "//src/services/iam-service/openapi:openapi-3.1.yaml.bin"),
        ("projects-api", "//src/services/projects-service/openapi:openapi-3.1.yaml.bin"),
        ("notifications-api", "//src/services/notifications-service/openapi:openapi-3.1.yaml.bin"),
        ("governance-api", "//src/services/governance-service/openapi:openapi-3.1.yaml.bin"),
        ("billing-api", "//src/services/billing-service/openapi:openapi-3.1.yaml.bin"),
        ("sandbox-rental-api", "//src/services/sandbox-rental-service/openapi:openapi-3.1.yaml.bin"),
        ("secrets-api", "//src/services/secrets-service/openapi:openapi-3.1.yaml.bin"),
        ("source-api", "//src/services/source-code-hosting-service/openapi:openapi-3.1.yaml.bin"),
    ],
)

write_source_files(
    name = "dev_update",
    additional_update_targets = [
        ":openapi_clients",
    ],
    tags = ["manual"],
)
