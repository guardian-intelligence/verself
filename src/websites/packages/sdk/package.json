{
  "name": "@verself/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Curated Verself SDK over generated service transports.",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./iam": {
      "types": "./src/iam.ts",
      "default": "./src/iam.ts"
    },
    "./projects": {
      "types": "./src/projects.ts",
      "default": "./src/projects.ts"
    },
    "./notifications": {
      "types": "./src/notifications.ts",
      "default": "./src/notifications.ts"
    },
    "./billing": {
      "types": "./src/billing.ts",
      "default": "./src/billing.ts"
    },
    "./governance": {
      "types": "./src/governance.ts",
      "default": "./src/governance.ts"
    },
    "./sandbox": {
      "types": "./src/sandbox.ts",
      "default": "./src/sandbox.ts"
    },
    "./secrets": {
      "types": "./src/secrets.ts",
      "default": "./src/secrets.ts"
    },
    "./source": {
      "types": "./src/source.ts",
      "default": "./src/source.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "bazelisk run //src/websites/packages/sdk:dev_update",
    "typecheck": "vp exec tsc -p tsconfig.json"
  },
  "dependencies": {
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
