load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//src/tools/build:check_tests.bzl", "stamp_test")
load(
    "//src/websites:viteplus_rules.bzl",
    "viteplus_generated_source_sync_cmds",
    "viteplus_input_sbom",
    "viteplus_node_runtime_artifact",
    "viteplus_tool_inputs",
    "viteplus_tool_setup",
)

package(default_visibility = ["//visibility:public"])

exports_files([
    ".npmrc",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "tsconfig.json",
    "vite.config.ts",
])

npm_link_all_packages()

# The vendored Node the controller-side frontend build runs on.
# `aspect vp`, `aspect tidy`, and `aspect dev verself-web` resolve `vp` through
# this exact binary + the lockfile-pinned `node_modules/vite-plus`, so there is
# one Vite+ toolchain shared by the build and the controller — no `~/.vite-plus`.
genrule(
    name = "vp_node",
    srcs = ["@rules_nodejs//nodejs:current_node_runtime"],
    outs = ["node"],
    cmd = """
set -euo pipefail
node=""
for candidate in $(locations @rules_nodejs//nodejs:current_node_runtime); do
  case "$$candidate" in
    */bin/node)
      node="$$candidate"
      ;;
  esac
done
test -n "$$node"
install -m 0755 "$$node" "$@"
""",
)

copy_to_bin(
    name = "workspace_config",
    srcs = [
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
)

filegroup(
    name = "package_sources",
    srcs = [
        ":workspace_config",
        "//src/websites/packages/auth-web:sources",
        "//src/websites/packages/brand:sources",
        "//src/websites/packages/nitro-plugins:sources",
        "//src/websites/packages/sdk:sources",
        "//src/websites/packages/ui:sources",
        "//src/websites/packages/web-env:sources",
    ] + glob([
        "patches/**/*",
    ]),
)

filegroup(
    name = "install_inputs",
    srcs = [
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "//src/websites/apps/company:package_manifest",
        "//src/websites/apps/verself-web:package_manifest",
        "//src/websites/packages/auth-web:package_manifest",
        "//src/websites/packages/brand:package_manifest",
        "//src/websites/packages/nitro-plugins:package_manifest",
        "//src/websites/packages/sdk:package_manifest",
        "//src/websites/packages/ui:package_manifest",
        "//src/websites/packages/web-env:package_manifest",
    ] + glob([
        "patches/**/*",
    ]),
)

filegroup(
    name = "check_sources",
    srcs = [
        ":workspace_config",
        "//src/websites/apps/company:sources",
        "//src/websites/apps/verself-web:sources",
        "//src/websites/packages/auth-web:sources",
        "//src/websites/packages/brand:sources",
        "//src/websites/packages/nitro-plugins:sources",
        "//src/websites/packages/sdk:sources",
        "//src/websites/packages/ui:sources",
        "//src/websites/packages/web-env:sources",
    ] + glob(
        [
            "apps/**/src/__generated/**",
            "apps/**/src/routeTree.gen.ts",
            "packages/**/src/__generated/**",
            "scripts/**/*.ts",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "sbom_sources",
    srcs = [
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        "tsconfig.json",
        "vite.config.ts",
        "//src/websites/apps/company:sources",
        "//src/websites/apps/verself-web:sources",
        "//src/websites/packages/auth-web:sources",
        "//src/websites/packages/brand:sources",
        "//src/websites/packages/nitro-plugins:sources",
        "//src/websites/packages/sdk:sources",
        "//src/websites/packages/ui:sources",
        "//src/websites/packages/web-env:sources",
    ] + glob([
        "patches/**/*",
    ]),
)

GENERATED_SRCS = [
    "//src/websites/apps/company:first_light_shader_generated_sources",
    "//src/websites/apps/company:route_tree_generated_sources",
    "//src/websites/apps/verself-web:openapi_clients_generated_sources",
    "//src/websites/apps/verself-web:openapi_spec_copies_generated_sources",
    "//src/websites/apps/verself-web:route_tree_generated_sources",
    "//src/websites/packages/sdk:openapi_clients_generated_sources",
]

VP_LOCAL_TAGS = [
    "local",
    "no-remote",
    "no-sandbox",
]

genrule(
    name = "install",
    srcs = [
        ":install_inputs",
    ] + viteplus_tool_inputs(),
    outs = ["install.stamp"],
    cmd = """
set -euo pipefail
execroot="$$(pwd)"
out="$$execroot/$@"
npm_userconfig="$$(mktemp)"
trap 'rm -f "$$npm_userconfig"' EXIT
{viteplus_tool_setup}
chmod 0600 "$$npm_userconfig"
printf 'registry=https://npm.verself.sh/\\n' > "$$npm_userconfig"
export NPM_CONFIG_USERCONFIG="$$npm_userconfig"
cd "src/websites"
"$$node" "$$vp" install --frozen-lockfile --prefer-offline
lockfile_hash="$$(hash_file pnpm-lock.yaml)"
tool_fingerprint="$$("$$node" "$$vp" --version | hash_stdin)"
printf 'viteplus install lockfile=%s tool=%s\\n' "$$lockfile_hash" "$$tool_fingerprint" > "$$out"
""".format(viteplus_tool_setup = viteplus_tool_setup()),
    local = True,
    tags = VP_LOCAL_TAGS,
)

genrule(
    name = "check_run",
    srcs = [
        ":check_sources",
        ":install",
    ] + viteplus_tool_inputs() + GENERATED_SRCS,
    outs = ["check.stamp"],
    cmd = """
set -euo pipefail
execroot="$$(pwd)"
out="$$execroot/$@"
{viteplus_tool_setup}
{generated_sync_cmds}
cd "src/websites"
"$$node" "$$vp" run check
printf 'viteplus check ok\\n' > "$$out"
""".format(
        generated_sync_cmds = viteplus_generated_source_sync_cmds(
            GENERATED_SRCS,
            "src/websites",
        ),
        viteplus_tool_setup = viteplus_tool_setup(),
    ),
    local = True,
    tags = VP_LOCAL_TAGS,
)

stamp_test(
    name = "check",
    tags = [
        "frontend_check",
        "repo_check",
    ] + VP_LOCAL_TAGS,
    target = ":check_run",
)

genrule(
    name = "test_run",
    srcs = [
        ":check_sources",
        ":install",
    ] + viteplus_tool_inputs() + GENERATED_SRCS,
    outs = ["test.stamp"],
    cmd = """
set -euo pipefail
execroot="$$(pwd)"
out="$$execroot/$@"
{viteplus_tool_setup}
{generated_sync_cmds}
cd "src/websites"
"$$node" "$$vp" run test
printf 'viteplus test ok\\n' > "$$out"
""".format(
        generated_sync_cmds = viteplus_generated_source_sync_cmds(
            GENERATED_SRCS,
            "src/websites",
        ),
        viteplus_tool_setup = viteplus_tool_setup(),
    ),
    local = True,
    tags = [
        "frontend_test",
    ] + VP_LOCAL_TAGS,
)

stamp_test(
    name = "test",
    tags = [
        "frontend_test",
        "repo_check",
    ] + VP_LOCAL_TAGS,
    target = ":test_run",
)

genrule(
    name = "build",
    srcs = [
        ":check_sources",
        ":install",
    ] + viteplus_tool_inputs() + GENERATED_SRCS,
    outs = ["build.stamp"],
    cmd = """
set -euo pipefail
execroot="$$(pwd)"
out="$$execroot/$@"
{viteplus_tool_setup}
{generated_sync_cmds}
cd "src/websites"
"$$node" "$$vp" run build
printf 'viteplus build ok\\n' > "$$out"
""".format(
        generated_sync_cmds = viteplus_generated_source_sync_cmds(
            GENERATED_SRCS,
            "src/websites",
        ),
        viteplus_tool_setup = viteplus_tool_setup(),
    ),
    local = True,
    tags = VP_LOCAL_TAGS,
)

viteplus_input_sbom(
    name = "input_sbom",
    srcs = [":sbom_sources"],
    output = "viteplus-input.cdx.json",
)

viteplus_node_runtime_artifact(
    name = "nodejs_runtime_nomad_artifact",
)
