load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# Guest-image build infrastructure for vm-orchestrator. The split
# substrate / toolchain catalog authored in substrate topology is
# materialised here:
#
#   guest_image.bzl    — Starlark macro `toolchain_ext4_image` for
#                        read-only toolchain ext4s built fully hermetic
#                        via mkfs.ext4 -d.
#   substrate/         — slim Ubuntu rootfs builder (chroot+apt; runs
#                        on the deploy host, not in the Bazel sandbox).
#   gh-actions-runner/ — GitHub Actions runner toolchain image.
#
# guest_images.MODULE.bazel is authored here and included from the root
# MODULE.bazel. It declares one http_file rule per upstream tarball consumed
# by the per-image build rules.
exports_files([
    "guest_image.bzl",
    "guest_images.MODULE.bazel",
])

# Aggregated toolchain-image bundle consumed by the vm-orchestrator Nomad
# prestart task. Stages every platform-tier toolchain ext4 + manifest under
# toolchains/<ref>.ext4 so the artifacts land atomically under
# /var/lib/verself/guest-images/toolchains/.
# Adding a new toolchain image = add one line here and one entry to
# instances/prod/config.cue:firecracker.images.
pkg_tar(
    name = "toolchain_images_bundle",
    files = {
        "//src/substrate/vm-orchestrator/guest-images/gh-actions-runner:gh-actions-runner.ext4": "toolchains/gh-actions-runner.ext4",
        "//src/substrate/vm-orchestrator/guest-images/gh-actions-runner:gh-actions-runner.manifest.json": "toolchains/gh-actions-runner.manifest.json",
    },
    modes = {
        "toolchains/gh-actions-runner.ext4": "0644",
        "toolchains/gh-actions-runner.manifest.json": "0644",
    },
)
