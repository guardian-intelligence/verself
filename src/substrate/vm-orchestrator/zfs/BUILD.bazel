load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "zfs",
    srcs = [
        "lifecycle.go",
        "refs.go",
        "stats.go",
    ],
    importpath = "github.com/verself/vm-orchestrator/zfs",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_oklog_ulid_v2//:ulid",
    ],
)

go_test(
    name = "zfs_test",
    srcs = [
        "lifecycle_test.go",
        "refs_test.go",
    ],
    embed = [":zfs"],
)

alias(
    name = "go_default_library",
    actual = ":zfs",
    visibility = ["//visibility:public"],
)
