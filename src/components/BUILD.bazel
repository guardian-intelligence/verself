package(default_visibility = ["//visibility:public"])

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "*/defaults/**",
            "*/files/**",
            "*/handlers/**",
            "*/meta/**",
            "*/migrations/**",
            "*/tasks/**",
            "*/templates/**",
            "*/vars/**",
        ],
        allow_empty = True,
    ) + [
        "//src/components/clickhouse:role_sources",
        "//src/components/electric:role_sources",
        "//src/components/grafana:role_sources",
        "//src/components/haproxy:role_sources",
        "//src/components/nats:role_sources",
        "//src/components/otelcol:role_sources",
        "//src/components/postgresql:role_sources",
        "//src/components/spicedb:role_sources",
        "//src/components/temporal-platform:role_sources",
        "//src/components/verdaccio:role_sources",
    ],
)
