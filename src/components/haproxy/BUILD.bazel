load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//src/components:__pkg__",
        "//src/host:__pkg__",
    ],
)

nomad_component(
    name = "nomad_component",
    component = "haproxy_upstreams",
    job_id = "haproxy-upstreams",
    job_spec = "nomad.hcl",
    requires = [
        "forgejo:http",
        "garage:s3",
        "grafana:http",
        "stalwart:http",
        "verdaccio:http",
        "zitadel:http",
    ],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
