load("//src/tools/deployment/nomad:component.bzl", "nomad_component")

exports_files(
    [
        "tasks/instances.yml",
    ],
    visibility = ["//src/configuration:__pkg__"],
)

filegroup(
    name = "role_sources",
    srcs = glob(
        [
            "defaults/**",
            "files/**",
            "handlers/**",
            "meta/**",
            "migrations/**",
            "tasks/**",
            "templates/**",
            "vars/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//src/components:__pkg__"],
)

nomad_component(
    name = "nomad_component",
    artifacts = {
        "//src/components/electric/cmd/electric-nomad-runner:electric-nomad-runner_nomad_artifact": "electric-nomad-runner",
    },
    component = "electric",
    job_id = "electric",
    job_spec = "nomad.hcl",
    requires = ["postgres:server"],
    visibility = ["//src/tools/deployment/nomad:__pkg__"],
)
