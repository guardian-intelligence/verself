load("//src/tools/build:go_module_checks.bzl", "go_module_checks")

# gazelle:prefix github.com/verself/guardian-specification

go_module_checks()

filegroup(
    name = "docs",
    srcs = glob([
        "*.md",
        "docs/*.md",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cue",
    srcs = glob([
        "cue.mod/*.cue",
        "cue/**/*.cue",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "examples",
    srcs = glob([
        "examples/**/*.cue",
    ]),
    visibility = ["//visibility:public"],
)
