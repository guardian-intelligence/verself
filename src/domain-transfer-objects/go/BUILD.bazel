load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//src/tools/build:go_module_checks.bzl", "go_module_checks")

# gazelle:ignore
# gazelle:prefix github.com/verself/domain-transfer-objects

go_module_checks()

go_library(
    name = "dto",
    srcs = [
        "billing.go",
        "decimal.go",
        "doc.go",
        "governance.go",
        "iam.go",
        "mailbox.go",
        "notifications.go",
        "profile.go",
        "projects.go",
        "resource_name.go",
        "sandbox.go",
        "vmresources.go",
    ],
    importpath = "github.com/verself/domain-transfer-objects",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_danielgtaylor_huma_v2//:huma",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "dto_test",
    srcs = [
        "decimal_test.go",
        "resource_name_test.go",
    ],
    embed = [":dto"],
    deps = ["@com_github_danielgtaylor_huma_v2//:huma"],
)

alias(
    name = "go_default_library",
    actual = ":dto",
    visibility = ["//visibility:public"],
)
