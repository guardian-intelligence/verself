*.exe
*.test
*.out
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
.build/

# Zig (vm-guest-telemetry has a local .gitignore for .zig-cache and zig-out)

# Reference repos (cloned for grep, not committed)
docs/references/

# CI build artifacts
src/platform/ci/output/rootfs.ext4
src/platform/ci/output/sbom.txt

# Logs
*.log

.claude/scheduled_tasks.lock

__pycache__
src/services/sandbox-rental-service/sandbox-rental-service

node_modules
.pnpm-store/
**/.pnpm-store/

# ClickHouse test artifacts (generated by e2e harness)
**/preprocessed_configs/
**/e2e/access/

# Materialized local build/deploy outputs
artifacts/
.verself/

# Generated/rendered directories are materialized outputs.
**/__generated/
**/__rendered/
**/*.generated.ts
**/routeTree.gen.ts

# Bazel convenience symlinks
/bazel-*

# Screenshots dropped into the working directory by macOS pasteboard
# / capture tools — never tracked.
Screenshot*.png
Screenshot*.jpg

# Generated OpenAPI artifacts. Authority is the Huma route source; the
# action graph rebuilds these into bazel-out via verself_openapi_specs +
# verself_oapi_go_client. No on-disk source of truth.
src/*/openapi/openapi-*.yaml
src/*/openapi/internal-openapi-*.yaml
src/*/client/client.gen.go
src/*/internalclient/client.gen.go
*.pb.go
*_grpc.pb.go
!src/substrate/vm-orchestrator/proto/v1/*.pb.go

# E2E smoke-test bundles, personas, Playwright traces, and query evidence
smoke-artifacts/

# Nitro plugin bundles emitted next to each app's vite.config by the build
src/viteplus-monorepo/apps/*/observability-plugin.mjs
src/viteplus-monorepo/apps/*/rewrite-cjs-require.mjs

.guardian

# GitHub App private key material must never be tracked; import into OpenBao.
*.private-key.pem
