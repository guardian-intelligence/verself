# Binaries
/verself
# Config (contains credentials)
verself.toml
secret.env
.env
.env.*
!.env.example
!.env.*.example
secrets/github-app-gamma.outputs.yaml
**/.projects/vault/
**/.projects/cache/

# Terraform
src/tools/provisioning/terraform/.terraform/
src/tools/provisioning/terraform/.terraform.lock.hcl
src/tools/provisioning/terraform/terraform.tfstate
src/tools/provisioning/terraform/terraform.tfstate.backup
src/tools/provisioning/terraform/*.tfvars.json

